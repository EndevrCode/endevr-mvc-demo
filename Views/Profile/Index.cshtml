@model Nestled.Models.ApplicationUser
@{
    ViewData["Title"] = "My Profile";
    var today = DateOnly.FromDateTime(DateTime.Today);
    int? age = null;
    string? nextBirthday = null;
    if (Model?.BirthDate.HasValue == true)
    {
        age = (int)((today - Model.BirthDate.Value).Days / 365.25);
        var thisYearBday = new DateOnly(today.Year, Model.BirthDate.Value.Month, Model.BirthDate.Value.Day);
        if (thisYearBday < today) thisYearBday = thisYearBday.AddYears(1);
        nextBirthday = thisYearBday.ToString("MMMM d");
    }
}

<div class="page-section">
    <div class="page-header">
        <h1 class="page-title">Profile</h1>
        <a href="/Profile/Edit" class="btn-ghost"><i class="fa-solid fa-pen"></i> Edit</a>
    </div>

    <div class="glass-card text-center mb-4" style="padding:32px 20px;">
        @if (!string.IsNullOrEmpty(Model?.PhotoPath))
        {
            <img src="@Model.PhotoPath" alt="Profile" class="avatar-lg" style="width:100px;height:100px;object-fit:cover;border-radius:50%;border:3px solid var(--primary);" />
        }
        else
        {
            <div class="avatar-placeholder mx-auto" style="width:100px;height:100px;border-radius:50%;background:linear-gradient(135deg,var(--primary),var(--primary-dark));display:flex;align-items:center;justify-content:center;color:white;font-size:2.5rem;font-weight:700;">
                @(Model?.FirstName?.Substring(0,1)?.ToUpper() ?? "?")
            </div>
        }
        <h2 style="margin-top:16px; font-size:1.5rem; font-weight:800; color:var(--text);">@Model?.FullName</h2>
        @if (!string.IsNullOrEmpty(Model?.PreferredName))
        {
            <div style="color:var(--text-secondary); font-size:0.9rem;">Known as "@Model.PreferredName"</div>
        }
        @if (age.HasValue)
        {
            <div class="badge-pill badge-primary mt-2" style="display:inline-flex;">@age years old</div>
        }
    </div>

    <div class="glass-card mb-4">
        <div class="section-title">Contact</div>
        <div class="list-item">
            <div class="list-item-icon" style="background:rgba(108,99,255,0.1);color:var(--primary);"><i class="fa-solid fa-envelope"></i></div>
            <div class="list-item-content">
                <div class="list-item-subtitle">Email</div>
                <div class="list-item-title">@Model?.Email</div>
            </div>
        </div>
        @if (!string.IsNullOrEmpty(Model?.PhoneNumber))
        {
            <div class="list-item">
                <div class="list-item-icon" style="background:rgba(76,175,80,0.1);color:var(--success);"><i class="fa-solid fa-phone"></i></div>
                <div class="list-item-content">
                    <div class="list-item-subtitle">Phone</div>
                    <div class="list-item-title">@Model.PhoneNumber</div>
                </div>
            </div>
        }
        @if (!string.IsNullOrEmpty(Model?.Address))
        {
            <div class="list-item">
                <div class="list-item-icon" style="background:rgba(6,182,212,0.1);color:var(--info);"><i class="fa-solid fa-location-dot"></i></div>
                <div class="list-item-content">
                    <div class="list-item-subtitle">Address</div>
                    <div class="list-item-title">@Model.Address</div>
                </div>
            </div>
        }
    </div>

    @if (Model?.BirthDate.HasValue == true)
    {
        <div class="glass-card mb-4">
            <div class="section-title">Birthday</div>
            <div class="list-item">
                <div class="list-item-icon" style="background:rgba(245,158,11,0.1);color:var(--warning);"><i class="fa-solid fa-cake-candles"></i></div>
                <div class="list-item-content">
                    <div class="list-item-title">@Model.BirthDate.Value.ToString("MMMM d, yyyy")</div>
                    <div class="list-item-subtitle">Next birthday: @nextBirthday</div>
                </div>
            </div>
        </div>
    }

    <div style="padding:8px 0 16px;">
        <a href="/Profile/Edit" class="btn-primary-pill w-100 justify-content-center">
            <i class="fa-solid fa-pen-to-square"></i> Edit Profile
        </a>
    </div>
</div>
