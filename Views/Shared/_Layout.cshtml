<!DOCTYPE html>
<html lang="en" data-bs-theme="auto" data-theme="system">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#6C63FF" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Nestled" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="description" content="Nestled — Your family, all in one place" />
    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " — " : "")Nestled</title>
    <link rel="manifest" href="/manifest.json" />
    <link rel="apple-touch-icon" href="/images/icon-192.png" />
    <link rel="icon" type="image/png" href="/images/icon-192.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="/css/app.css" />
</head>
<body class="nestled-app @(ViewData["HideNav"] != null ? "no-nav" : "has-nav")">

    @if (ViewData["HideNav"] == null && User.Identity?.IsAuthenticated == true)
    {
        <!-- Settings Drawer Overlay -->
        <div class="drawer-overlay" id="drawerOverlay" onclick="closeSettingsDrawer()"></div>

        <!-- Settings Drawer -->
        <div class="settings-drawer" id="settingsDrawer">
            <div class="drawer-header">
                <div class="drawer-avatar">
                    @if (ViewBag.CurrentUser?.PhotoPath != null)
                    {
                        <img src="@ViewBag.CurrentUser.PhotoPath" alt="Profile" />
                    }
                    else
                    {
                        <div class="avatar-initials">
                            @(User.Identity?.Name?.Substring(0, 1)?.ToUpper() ?? "H")
                        </div>
                    }
                </div>
                <div class="drawer-user-info">
                    <div class="drawer-name">@(ViewBag.CurrentUser?.DisplayName ?? User.Identity?.Name)</div>
                    <div class="drawer-email">@User.Identity?.Name</div>
                </div>
            </div>
            <div class="drawer-section">
                <div class="drawer-section-title">Appearance</div>
                <div class="theme-switcher">
                    <button class="theme-btn active" data-theme="system" onclick="setTheme('system')">
                        <i class="fa-solid fa-circle-half-stroke"></i> System
                    </button>
                    <button class="theme-btn" data-theme="light" onclick="setTheme('light')">
                        <i class="fa-solid fa-sun"></i> Light
                    </button>
                    <button class="theme-btn" data-theme="dark" onclick="setTheme('dark')">
                        <i class="fa-solid fa-moon"></i> Dark
                    </button>
                </div>
                <div class="font-switcher mt-3">
                    <span class="drawer-section-title">Text Size</span>
                    <div class="d-flex gap-2 mt-2">
                        <button class="font-btn" data-size="small" onclick="setFontSize('small')">A<small>-</small></button>
                        <button class="font-btn active" data-size="medium" onclick="setFontSize('medium')">A</button>
                        <button class="font-btn" data-size="large" onclick="setFontSize('large')">A<sup>+</sup></button>
                    </div>
                </div>
            </div>
            <div class="drawer-section">
                <div class="drawer-section-title">Account</div>
                <a href="/Profile" class="drawer-item"><i class="fa-solid fa-user"></i> My Profile</a>
                <a href="/Family" class="drawer-item"><i class="fa-solid fa-people-roof"></i> Families</a>
                <a href="/Vault" class="drawer-item"><i class="fa-solid fa-vault"></i> Vault</a>
                <a href="/ServiceContacts" class="drawer-item"><i class="fa-solid fa-address-book"></i> Service Contacts</a>
            </div>
            <div class="drawer-section drawer-footer">
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="drawer-item text-danger w-100 text-start border-0 bg-transparent">
                        <i class="fa-solid fa-right-from-bracket"></i> Sign Out
                    </button>
                </form>
            </div>
        </div>

        <!-- Top Header -->
        <header class="app-header">
            <button class="header-btn" onclick="openSettingsDrawer()" aria-label="Settings">
                <i class="fa-solid fa-gear"></i>
            </button>
            <a href="/Dashboard" class="app-logo">
                <span class="logo-icon"><i class="fa-solid fa-house-heart"></i></span>
                <span class="logo-text">Nestled</span>
            </a>
            <a href="/Profile" class="header-avatar" aria-label="Profile">
                @if (ViewBag.CurrentUser?.PhotoPath != null)
                {
                    <img src="@ViewBag.CurrentUser.PhotoPath" alt="Profile" />
                }
                else
                {
                    <div class="avatar-initials-sm">
                        @(User.Identity?.Name?.Substring(0, 1)?.ToUpper() ?? "H")
                    </div>
                }
            </a>
        </header>
    }

    <!-- Page Content -->
    <main id="page-content" class="@(ViewData["HideNav"] != null ? "auth-page" : "")">
        @if (TempData["Success"] != null)
        {
            <div class="toast-notification success" id="toastMsg">
                <i class="fa-solid fa-circle-check"></i> @TempData["Success"]
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="toast-notification error" id="toastMsg">
                <i class="fa-solid fa-circle-xmark"></i> @TempData["Error"]
            </div>
        }
        @RenderBody()
    </main>

    @if (ViewData["HideNav"] == null && User.Identity?.IsAuthenticated == true)
    {
        <!-- More Menu Overlay -->
        <div class="more-overlay" id="moreOverlay" onclick="closeMoreMenu()"></div>

        <!-- More Menu Panel -->
        <div class="more-menu" id="moreMenu">
            <div class="more-menu-handle"></div>
            <div class="more-menu-title">More</div>
            <div class="more-menu-grid">
                <a href="/Remembrance" class="more-menu-item" onclick="closeMoreMenu()">
                    <div class="more-menu-icon" style="background: linear-gradient(135deg, #ec4899, #be185d)">
                        <i class="fa-solid fa-heart"></i>
                    </div>
                    <span>Remembrance</span>
                </a>
                <a href="/Banking" class="more-menu-item" onclick="closeMoreMenu()">
                    <div class="more-menu-icon" style="background: linear-gradient(135deg, #10b981, #065f46)">
                        <i class="fa-solid fa-credit-card"></i>
                    </div>
                    <span>Banking</span>
                </a>
                <a href="/Bills" class="more-menu-item" onclick="closeMoreMenu()">
                    <div class="more-menu-icon" style="background: linear-gradient(135deg, #f59e0b, #92400e)">
                        <i class="fa-solid fa-file-invoice-dollar"></i>
                    </div>
                    <span>Bills</span>
                </a>
                <a href="/Profile" class="more-menu-item" onclick="closeMoreMenu()">
                    <div class="more-menu-icon" style="background: linear-gradient(135deg, #6C63FF, #4c46b3)">
                        <i class="fa-solid fa-user-circle"></i>
                    </div>
                    <span>Profile</span>
                </a>
                <a href="/Shopping" class="more-menu-item" onclick="closeMoreMenu()">
                    <div class="more-menu-icon" style="background: linear-gradient(135deg, #06b6d4, #0e7490)">
                        <i class="fa-solid fa-cart-shopping"></i>
                    </div>
                    <span>Shopping</span>
                </a>
                <a href="/Vault" class="more-menu-item" onclick="closeMoreMenu()">
                    <div class="more-menu-icon" style="background: linear-gradient(135deg, #8b5cf6, #5b21b6)">
                        <i class="fa-solid fa-vault"></i>
                    </div>
                    <span>Vault</span>
                </a>
                <a href="/Staff" class="more-menu-item" onclick="closeMoreMenu()">
                    <div class="more-menu-icon" style="background: linear-gradient(135deg, #64748b, #334155)">
                        <i class="fa-solid fa-users-gear"></i>
                    </div>
                    <span>Staff</span>
                </a>
                <a href="/Utilities" class="more-menu-item" onclick="closeMoreMenu()">
                    <div class="more-menu-icon" style="background: linear-gradient(135deg, #eab308, #713f12)">
                        <i class="fa-solid fa-bolt"></i>
                    </div>
                    <span>Utilities</span>
                </a>
                <a href="/ServiceContacts" class="more-menu-item" onclick="closeMoreMenu()">
                    <div class="more-menu-icon" style="background: linear-gradient(135deg, #14b8a6, #134e4a)">
                        <i class="fa-solid fa-address-book"></i>
                    </div>
                    <span>Contacts</span>
                </a>
                <a href="/Documents" class="more-menu-item" onclick="closeMoreMenu()">
                    <div class="more-menu-icon" style="background: linear-gradient(135deg, #3b82f6, #1e3a8a)">
                        <i class="fa-solid fa-folder-open"></i>
                    </div>
                    <span>Documents</span>
                </a>
            </div>
        </div>

        <!-- Emergency Menu Arc -->
        <div class="emergency-menu" id="emergencyMenu">
            <button class="emg-btn police" onclick="callEmergency('10111')" title="Police">
                <i class="fa-solid fa-shield-halved"></i>
                <span>Police</span>
            </button>
            <button class="emg-btn fire" onclick="callEmergency('10177')" title="Fire">
                <i class="fa-solid fa-fire-extinguisher"></i>
                <span>Fire</span>
            </button>
            <button class="emg-btn ambulance" onclick="callEmergency('10177')" title="Ambulance">
                <i class="fa-solid fa-truck-medical"></i>
                <span>Ambulance</span>
            </button>
            <button class="emg-btn nsri" onclick="callEmergency('082 990 5911')" title="NSRI">
                <i class="fa-solid fa-anchor"></i>
                <span>NSRI</span>
            </button>
            <button class="emg-btn towing" onclick="callEmergency('086 186 9437')" title="Towing">
                <i class="fa-solid fa-truck-ramp-box"></i>
                <span>Towing</span>
            </button>
        </div>

        <!-- Bottom Navigation -->
        <nav class="bottom-nav" id="bottomNav">
            <a href="/Dashboard" class="nav-tab @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")">
                <i class="fa-solid fa-grid-2"></i>
                <span>Home</span>
            </a>
            <a href="/Pets" class="nav-tab @(ViewContext.RouteData.Values["controller"]?.ToString() == "Pets" ? "active" : "")">
                <i class="fa-solid fa-paw"></i>
                <span>Pets</span>
            </a>
            <div class="nav-notch">
                <button class="emergency-btn" id="emergencyBtn" onclick="toggleEmergency()" aria-label="Emergency">
                    <i class="fa-solid fa-sos"></i>
                </button>
            </div>
            <a href="/Family" class="nav-tab @(ViewContext.RouteData.Values["controller"]?.ToString() == "Family" ? "active" : "")">
                <i class="fa-solid fa-people-roof"></i>
                <span>Family</span>
            </a>
            <button class="nav-tab" onclick="toggleMoreMenu()">
                <i class="fa-solid fa-ellipsis"></i>
                <span>More</span>
            </button>
        </nav>
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/app.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
