@{
    ViewData["Title"] = "Sign In";
    ViewData["HideNav"] = true;
    Layout = "_Layout";
}

<div class="auth-card glass-card" style="width:100%; max-width:400px;">
    <div class="text-center mb-4">
        <div class="auth-logo">
            <i class="fa-solid fa-house-heart" style="font-size:3rem; color:var(--primary);"></i>
        </div>
        <h1 class="auth-title">Nestled</h1>
        <p class="auth-subtitle">Your family, all in one place</p>
    </div>

    @if (ViewData.ModelState.ErrorCount > 0)
    {
        <div class="alert-glass danger mb-3">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div><i class="fa-solid fa-circle-xmark"></i> @error.ErrorMessage</div>
            }
        </div>
    }

    <form method="post" asp-action="Login" asp-controller="Account">
        @Html.AntiForgeryToken()
        <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

        <div class="form-group">
            <label class="form-label-glass"><i class="fa-solid fa-envelope"></i> Email</label>
            <input type="email" name="email" class="form-control-glass" placeholder="you@example.com" required autocomplete="email" />
        </div>

        <div class="form-group">
            <label class="form-label-glass"><i class="fa-solid fa-lock"></i> Password</label>
            <div class="input-icon-wrapper">
                <input type="password" name="password" id="passwordInput" class="form-control-glass" placeholder="••••••••" required autocomplete="current-password" />
                <button type="button" class="input-icon-btn" data-password-toggle="passwordInput">
                    <i class="fa-solid fa-eye"></i>
                </button>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-4">
            <label class="check-label">
                <input type="checkbox" name="rememberMe" class="check-input" />
                <span>Remember me</span>
            </label>
        </div>

        <button type="submit" class="btn-primary-pill w-100 justify-content-center">
            <i class="fa-solid fa-right-to-bracket"></i> Sign In
        </button>
    </form>

    <div class="text-center mt-4">
        <span style="color:var(--text-secondary); font-size:0.9rem;">Don't have an account?</span>
        <a href="/Account/Register" class="auth-link"> Create one</a>
    </div>
</div>

<style>
.auth-card { padding: 32px 28px; }
.auth-logo { margin-bottom: 12px; }
.auth-title { font-size: 1.8rem; font-weight: 800; color: var(--text); margin: 0; }
.auth-subtitle { color: var(--text-secondary); font-size: 0.9rem; margin-top: 4px; }
.auth-link { color: var(--primary); font-weight: 600; text-decoration: none; }
.auth-link:hover { text-decoration: underline; }
.input-icon-wrapper { position: relative; }
.input-icon-wrapper .form-control-glass { padding-right: 48px; }
.input-icon-btn { position: absolute; right: 12px; top: 50%; transform: translateY(-50%); border: none; background: transparent; color: var(--text-muted); cursor: pointer; padding: 8px; }
.check-label { display: flex; align-items: center; gap: 8px; cursor: pointer; color: var(--text-secondary); font-size: 0.9rem; }
.check-input { width: 18px; height: 18px; accent-color: var(--primary); }
.alert-glass { background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.3); border-radius: 12px; padding: 12px 16px; color: var(--danger); font-size: 0.85rem; }
.alert-glass.danger { color: #ef4444; }
.w-100 { width: 100% !important; }
</style>
