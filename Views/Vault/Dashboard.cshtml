@{
    ViewData["Title"] = "Vault";
}
<div class="page-section">
    <div class="page-header">
        <h1 class="page-title"><i class="fa-solid fa-vault" style="color:#8b5cf6;"></i> Vault</h1>
        <a href="/Vault/Lock" class="btn-ghost"><i class="fa-solid fa-lock"></i> Lock</a>
    </div>
    <p style="color:var(--text-secondary);font-size:0.85rem;margin-bottom:20px;">
        <i class="fa-solid fa-circle-check" style="color:var(--success);"></i> Vault unlocked · Auto-locks in 10 min
    </p>
    <div style="display:grid;gap:12px;">
        <a href="/PasswordVault" class="glass-card text-decoration-none" style="display:flex;align-items:center;gap:16px;">
            <div style="width:52px;height:52px;border-radius:16px;background:linear-gradient(135deg,#6C63FF,#4c46b3);display:flex;align-items:center;justify-content:center;color:white;font-size:1.4rem;">
                <i class="fa-solid fa-key"></i>
            </div>
            <div style="flex:1;">
                <div style="font-weight:700;color:var(--text);">Passwords</div>
                <div style="color:var(--text-secondary);font-size:0.82rem;">Logins &amp; credentials</div>
            </div>
            <i class="fa-solid fa-chevron-right" style="color:var(--text-muted);"></i>
        </a>
        <a href="/Banking" class="glass-card text-decoration-none" style="display:flex;align-items:center;gap:16px;">
            <div style="width:52px;height:52px;border-radius:16px;background:linear-gradient(135deg,#10b981,#065f46);display:flex;align-items:center;justify-content:center;color:white;font-size:1.4rem;">
                <i class="fa-solid fa-credit-card"></i>
            </div>
            <div style="flex:1;">
                <div style="font-weight:700;color:var(--text);">Banking</div>
                <div style="color:var(--text-secondary);font-size:0.82rem;">Bank accounts &amp; cards</div>
            </div>
            <i class="fa-solid fa-chevron-right" style="color:var(--text-muted);"></i>
        </a>
        <a href="/Documents" class="glass-card text-decoration-none" style="display:flex;align-items:center;gap:16px;">
            <div style="width:52px;height:52px;border-radius:16px;background:linear-gradient(135deg,#3b82f6,#1e3a8a);display:flex;align-items:center;justify-content:center;color:white;font-size:1.4rem;">
                <i class="fa-solid fa-folder-open"></i>
            </div>
            <div style="flex:1;">
                <div style="font-weight:700;color:var(--text);">Documents</div>
                <div style="color:var(--text-secondary);font-size:0.82rem;">Secure file storage</div>
            </div>
            <i class="fa-solid fa-chevron-right" style="color:var(--text-muted);"></i>
        </a>
    </div>
</div>
