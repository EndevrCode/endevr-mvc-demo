@{
    ViewData["Title"] = "Set Vault PIN";
}
<div class="page-section" style="max-width:360px;margin:0 auto;padding-top:40px;">
    <div class="text-center mb-4">
        <div style="width:80px;height:80px;border-radius:24px;background:linear-gradient(135deg,#8b5cf6,#5b21b6);display:flex;align-items:center;justify-content:center;color:white;font-size:2.5rem;margin:0 auto 16px;">
            <i class="fa-solid fa-key"></i>
        </div>
        <h1 style="font-size:1.6rem;font-weight:800;color:var(--text);">Set Vault PIN</h1>
        <p style="color:var(--text-secondary);">Choose a 4-6 digit PIN to protect your vault</p>
    </div>
    <form method="post" asp-action="SetPin" asp-controller="Vault">
        @Html.AntiForgeryToken()
        <div class="glass-card">
            <div class="form-group">
                <label class="form-label-glass">PIN (4-6 digits)</label>
                <input type="password" name="pin" class="form-control-glass" maxlength="6" pattern="[0-9]{4,6}" inputmode="numeric" placeholder="••••" required />
            </div>
            <div class="form-group">
                <label class="form-label-glass">Confirm PIN</label>
                <input type="password" name="confirmPin" class="form-control-glass" maxlength="6" pattern="[0-9]{4,6}" inputmode="numeric" placeholder="••••" required />
            </div>
            <button type="submit" class="btn-primary-pill w-100 justify-content-center">
                <i class="fa-solid fa-lock"></i> Set PIN
            </button>
        </div>
    </form>
</div>
