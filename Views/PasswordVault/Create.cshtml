@{
    ViewData["Title"] = "Add Password";
    var families = ViewBag.Families as List<Nestled.Models.Family> ?? new();
}
<div class="page-section">
    <div class="page-header">
        <h1 class="page-title">Add Password</h1>
        <a href="/PasswordVault" class="btn-ghost"><i class="fa-solid fa-xmark"></i></a>
    </div>
    <form method="post" asp-action="Create" asp-controller="PasswordVault">
        @Html.AntiForgeryToken()
        <div class="glass-card mb-4">
            <div class="form-group">
                <label class="form-label-glass">Family *</label>
                <select name="FamilyId" class="form-control-glass" required>
                    @foreach (var f in families) { <option value="@f.Id">@f.Name</option> }
                </select>
            </div>
            <div class="form-group">
                <label class="form-label-glass">Title *</label>
                <input type="text" name="Title" class="form-control-glass" placeholder="e.g. Gmail, Netflix" required />
            </div>
            <div class="form-group">
                <label class="form-label-glass">Username / Email</label>
                <input type="text" name="Username" class="form-control-glass" autocomplete="off" />
            </div>
            <div class="form-group">
                <label class="form-label-glass">Password *</label>
                <div class="input-icon-wrapper">
                    <input type="password" name="plainPassword" id="pwInput" class="form-control-glass" autocomplete="new-password" required />
                    <button type="button" class="input-icon-btn" data-password-toggle="pwInput"><i class="fa-solid fa-eye"></i></button>
                </div>
            </div>
            <div class="form-group">
                <label class="form-label-glass">Encryption Key (secret phrase)</label>
                <input type="password" name="encryptionKey" class="form-control-glass" placeholder="Used to encrypt — remember it!" required autocomplete="off" />
                <div style="color:var(--text-muted);font-size:0.78rem;margin-top:4px;"><i class="fa-solid fa-triangle-exclamation"></i> If you lose this key, the password cannot be recovered.</div>
            </div>
            <div class="form-group">
                <label class="form-label-glass">Notes</label>
                <textarea name="Notes" class="form-control-glass" rows="2"></textarea>
            </div>
        </div>
        <button type="submit" class="btn-primary-pill w-100 justify-content-center">
            <i class="fa-solid fa-lock"></i> Save Password
        </button>
    </form>
</div>
<style>
.input-icon-wrapper { position: relative; }
.input-icon-wrapper .form-control-glass { padding-right: 48px; }
.input-icon-btn { position: absolute; right: 12px; top: 50%; transform: translateY(-50%); border: none; background: transparent; color: var(--text-muted); cursor: pointer; padding: 8px; }
</style>
