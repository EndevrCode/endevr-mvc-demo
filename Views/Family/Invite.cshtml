@{
    ViewData["Title"] = "Invite Member";
}
<div class="page-section">
    <div class="page-header">
        <h1 class="page-title">Invite to Family</h1>
        <a href="/Family/Details/@ViewBag.FamilyId" class="btn-ghost"><i class="fa-solid fa-xmark"></i></a>
    </div>
    <div class="glass-card">
        <form method="post" asp-action="Invite" asp-controller="Family" asp-route-id="@ViewBag.FamilyId">
            @Html.AntiForgeryToken()
            <div class="form-group">
                <label class="form-label-glass"><i class="fa-solid fa-envelope"></i> Email Address</label>
                <input type="email" name="email" class="form-control-glass" placeholder="person@example.com" required />
            </div>
            <p style="color:var(--text-secondary);font-size:0.85rem;margin-bottom:16px;">
                They'll receive a link to join your family. The invitation expires in 7 days.
            </p>
            <button type="submit" class="btn-primary-pill w-100 justify-content-center">
                <i class="fa-solid fa-paper-plane"></i> Send Invitation
            </button>
        </form>
    </div>
</div>
