@{
    ViewData["Title"] = "Create Family";
}
<div class="page-section">
    <div class="page-header">
        <h1 class="page-title">New Family</h1>
        <a href="/Family" class="btn-ghost"><i class="fa-solid fa-xmark"></i></a>
    </div>
    <form method="post" asp-action="Create" asp-controller="Family">
        @Html.AntiForgeryToken()
        <div class="glass-card mb-4">
            <div class="form-group">
                <label class="form-label-glass">Family Name *</label>
                <input type="text" name="name" class="form-control-glass" placeholder="e.g. The Smiths" required />
            </div>
            <div class="form-group">
                <label class="form-label-glass">Description (optional)</label>
                <textarea name="description" class="form-control-glass" rows="3" placeholder="A little about your family..."></textarea>
            </div>
        </div>
        <button type="submit" class="btn-primary-pill w-100 justify-content-center">
            <i class="fa-solid fa-people-roof"></i> Create Family
        </button>
    </form>
</div>
