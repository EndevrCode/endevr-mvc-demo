@model Nestled.Models.ServiceContact
@{
    ViewData["Title"] = "Edit Contact";
}
<div class="page-section">
    <div class="page-header">
        <h1 class="page-title">Edit Contact</h1>
        <a href="/ServiceContacts" class="btn-ghost"><i class="fa-solid fa-xmark"></i></a>
    </div>
    <form method="post" asp-action="Edit" asp-controller="ServiceContacts" asp-route-id="@Model.Id">
        @Html.AntiForgeryToken()
        <div class="glass-card mb-4">
            <div class="form-group">
                <label class="form-label-glass">Category *</label>
                <input type="text" name="Category" class="form-control-glass" value="@Model.Category" required />
            </div>
            <div class="form-group">
                <label class="form-label-glass">Name *</label>
                <input type="text" name="Name" class="form-control-glass" value="@Model.Name" required />
            </div>
            <div class="form-group">
                <label class="form-label-glass">Phone</label>
                <input type="tel" name="Phone" class="form-control-glass" value="@Model.Phone" />
            </div>
            <div class="form-group">
                <label class="form-label-glass">Email</label>
                <input type="email" name="Email" class="form-control-glass" value="@Model.Email" />
            </div>
            <div class="form-group">
                <label class="form-label-glass">Address</label>
                <input type="text" name="Address" class="form-control-glass" value="@Model.Address" />
            </div>
            <div class="form-group">
                <label class="form-label-glass">Notes</label>
                <textarea name="Notes" class="form-control-glass" rows="2">@Model.Notes</textarea>
            </div>
        </div>
        <button type="submit" class="btn-primary-pill w-100 justify-content-center">
            <i class="fa-solid fa-floppy-disk"></i> Save Changes
        </button>
    </form>
</div>
