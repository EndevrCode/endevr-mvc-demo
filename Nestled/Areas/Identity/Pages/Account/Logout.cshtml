@page
@model LogoutModel
@{
    ViewData["Title"] = "Signed Out";
    var isAuthenticated = User.Identity?.IsAuthenticated ?? false;
}

<div class="d-flex justify-content-center align-items-center vh-100">
    <div class="logout-card">

        <img src="~/icons/icon-192.png" alt="Nestled Logo" class="logo" />

        @if (!isAuthenticated)
        {
            <div class="checkmark-wrapper">
                <svg class="checkmark" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 52 52">
                    <circle class="checkmark__circle" cx="26" cy="26" r="25" fill="none" />
                    <path class="checkmark__check" fill="none" d="M16 26l8 8 14-14" />
                </svg>
            </div>
        }

        <h2>
            @if (isAuthenticated)
            {
                <text>Are you sure you want to sign out?</text>
            }
            else
            {
                <text>You’ve signed out</text>
            }
        </h2>

        @if (isAuthenticated)
        {
            <form asp-area="Identity"
                  asp-page="/Account/Logout"
                  asp-route-returnUrl="@Url.Page("/", new { area = "" })"
                  method="post" class="mb-3">
                <button type="submit" class="btn btn-nestled btn-nestled-primary w-100">Log Out</button>
            </form>
        }
        else
        {
            <p>You’ve successfully logged out of your Nestled account.</p>
        }

        <a href="@Url.Page("/", new { area = "" })" class="btn btn-nestled btn-nestled-secondary w-100">Return to Home</a>
    </div>
</div>
