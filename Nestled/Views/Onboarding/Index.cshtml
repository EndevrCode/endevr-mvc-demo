@{
    ViewData["Title"] = "Welcome to Nestled";
}

<div class="text-center py-5">
    <i class="fa-light fa-house-heart fa-3x mb-4 d-block" style="color:#6366f1;"></i>
    <h1 class="display-5 fw-bold mb-3">Welcome to <span style="color:#6366f1;">Nestled</span></h1>
    <p class="lead text-muted mb-2">
        Your all-in-one solution to manage your home, family, pets, staff, and more.
    </p>
    <p class="text-muted mb-5">
        We'll help you get set up in just a few steps. It's quick and painless!
    </p>

    <form asp-action="Complete" method="post">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-primary btn-lg rounded-pill px-5">
            <i class="fa-light fa-rocket me-2"></i>Let's Get Started
        </button>
    </form>
</div>
