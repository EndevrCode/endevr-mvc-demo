@{
    ViewData["Title"] = "Step 2: Your Family";
    var isInFamily = ViewData["IsInFamily"] as bool? == true;
}

<div class="text-center py-5">
    <i class="fa-light fa-people-roof fa-3x mb-4 d-block" style="color:#6366f1;"></i>
    <h2 class="fw-bold mb-3">Step 2: Your Family</h2>

    @if (isInFamily)
    {
        <p class="lead text-muted mb-2">You're already part of a family — you're all set!</p>
        <p class="text-muted mb-5">
            Head to your Dashboard to see bills, chores, upcoming birthdays, and more.
        </p>
        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary btn-lg rounded-pill px-5">
            <i class="fa-light fa-grid me-2"></i>Go to Dashboard
        </a>
    }
    else
    {
        <p class="lead text-muted mb-2">Create or join a family to unlock all features.</p>
        <p class="text-muted mb-5">
            Families are the heart of Nestled — share bills, chores, shopping lists, and more
            with the people you live with.
        </p>
        <div class="d-flex flex-column gap-3 align-items-center">
            <a asp-controller="Families" asp-action="Create" class="btn btn-primary btn-lg rounded-pill px-5">
                <i class="fa-light fa-plus me-2"></i>Create a Family
            </a>
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                <i class="fa-light fa-arrow-right me-1"></i> Skip for now
            </a>
        </div>
    }
</div>
