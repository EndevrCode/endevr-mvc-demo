@model IEnumerable<Nestled.Data.StaffPayment>
@using Nestled.Data

@{
    var staffMember = ViewData["StaffMember"] as StaffMember;
    ViewData["Title"] = $"Payment History – {staffMember?.PreferredName ?? staffMember?.FirstName}";

    var statusMsg = TempData["StatusMessage"] as string;
    var totalPaid = Model.Sum(p => p.AmountPaid);
}

<div class="mb-4">
    <h2 class="mb-0"><i class="fa-light fa-clock-rotate-left me-2"></i>Payment History</h2>
</div>

@if (staffMember != null)
{
    <div class="glass-card p-3 mb-4 d-flex align-items-center gap-3">
        @if (!string.IsNullOrEmpty(staffMember.PhotoPath))
        {
            <img src="@Url.Content(staffMember.PhotoPath)" alt="@staffMember.FirstName"
                 class="rounded-circle" style="width:50px;height:50px;object-fit:cover;" />
        }
        else
        {
            <div class="rounded-circle d-flex align-items-center justify-content-center"
                 style="width:50px;height:50px;background:rgba(255,255,255,.08);font-size:1.3rem;color:rgba(255,255,255,.5);">
                @staffMember.FirstName.Substring(0, 1).ToUpper()
            </div>
        }
        <div class="flex-grow-1">
            <div class="fw-semibold">@staffMember.FirstName @staffMember.LastName</div>
            @if (!string.IsNullOrEmpty(staffMember.PreferredName))
            {
                <div class="text-muted small">"@staffMember.PreferredName"</div>
            }
        </div>
        <div class="text-end">
            <div class="text-muted small">Total Paid</div>
            <div class="fw-semibold text-success fs-5">R @totalPaid.ToString("N2")</div>
        </div>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <span class="text-muted small">@Model.Count() payment@(Model.Count() == 1 ? "" : "s") recorded</span>
    <a asp-action="LogPayment" asp-route-id="@(staffMember?.Id)" class="btn btn-success rounded-pill px-3">
        <i class="fa-light fa-plus me-1"></i> Log Payment
    </a>
</div>

@if (!Model.Any())
{
    <div class="glass-card p-5 text-center">
        <i class="fa-light fa-money-bill-wave fa-3x mb-3" style="color:rgba(255,255,255,.3);"></i>
        <p class="text-muted mb-3">No payments recorded yet.</p>
        <a asp-action="LogPayment" asp-route-id="@(staffMember?.Id)" class="btn btn-success rounded-pill px-4">
            <i class="fa-light fa-plus me-1"></i> Log First Payment
        </a>
    </div>
}
else
{
    @foreach (var payment in Model)
    {
        <div class="glass-card p-3 mb-3">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="fw-semibold fs-5 text-success">R @payment.AmountPaid.ToString("N2")</div>
                    <div class="text-muted small">@payment.PaymentDate.ToString("dd MMMM yyyy")</div>
                </div>
                <span class="badge rounded-pill bg-secondary">@payment.PaymentMethod</span>
            </div>

            @if (payment.PeriodStart.HasValue || payment.PeriodEnd.HasValue)
            {
                <div class="mt-2 text-muted small">
                    <i class="fa-light fa-calendar-range me-1"></i>
                    Period:
                    @(payment.PeriodStart.HasValue ? payment.PeriodStart.Value.ToString("dd MMM yyyy") : "?")
                    –
                    @(payment.PeriodEnd.HasValue ? payment.PeriodEnd.Value.ToString("dd MMM yyyy") : "?")
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(payment.Notes))
            {
                <div class="mt-2 text-muted small">
                    <i class="fa-light fa-note me-1"></i> @payment.Notes
                </div>
            }

            <div class="d-flex justify-content-between align-items-center mt-2">
                <div class="text-muted" style="font-size:0.72rem;">
                    Recorded @payment.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")
                </div>
                <div class="d-flex gap-2 align-items-center">
                    <a asp-action="Payslip" asp-route-paymentId="@payment.Id"
                       class="btn btn-outline-info btn-sm rounded-pill px-3">
                        <i class="fa-light fa-file-invoice me-1"></i> Payslip
                    </a>
                    <form asp-action="DeletePayment" method="post" id="del-@payment.Id" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@payment.Id" />
                        <button type="button" class="btn btn-outline-danger btn-sm rounded-pill px-2"
                                onclick="confirmDeletePayment('@payment.Id', 'R @payment.AmountPaid.ToString("N2") on @payment.PaymentDate.ToString("dd MMM yyyy")')">
                            <i class="fa-light fa-trash"></i>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    }
}

<div class="d-flex justify-content-center mt-4">
    <a asp-action="Details" asp-route-id="@(staffMember?.Id)" class="btn btn-outline-secondary rounded-pill px-4">
        <i class="fa-light fa-arrow-left me-1"></i> Back to Profile
    </a>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            @if (!string.IsNullOrEmpty(statusMsg))
            {
                <text>Swal.fire({ titleText: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(statusMsg)), icon: 'success', toast: true, position: 'top-end', timer: 2500, showConfirmButton: false });</text>
            }
        });

        function confirmDeletePayment(id, label) {
            Swal.fire({
                titleText: 'Delete payment?',
                html: `<span class="text-muted small">${label}</span><br>This cannot be undone.`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Delete',
                confirmButtonColor: '#dc3545',
                cancelButtonText: 'Cancel',
                reverseButtons: true
            }).then(r => { if (r.isConfirmed) document.getElementById('del-' + id).submit(); });
        }
    </script>
}
