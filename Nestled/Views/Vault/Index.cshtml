@{
    ViewData["Title"] = "Vault";
    var biometricCount = (int)(ViewBag.BiometricCount ?? 0);
    var hasSessionKey  = (bool)(ViewBag.HasSessionVaultKey ?? false);

    string FileIcon(string ct) => ct switch
    {
        "application/pdf"                                                                        => "fa-file-pdf",
        "image/jpeg" or "image/jpg" or "image/png" or "image/gif" or "image/webp"
            or "image/svg+xml" or "image/bmp" or "image/tiff"                                   => "fa-file-image",
        "video/mp4" or "video/quicktime" or "video/x-msvideo" or "video/webm"                   => "fa-file-video",
        "audio/mpeg" or "audio/mp4" or "audio/ogg" or "audio/wav" or "audio/webm"               => "fa-file-audio",
        "application/zip" or "application/x-zip-compressed"
            or "application/x-rar-compressed" or "application/x-7z-compressed"                  => "fa-file-zipper",
        "text/plain"                                                                             => "fa-file-lines",
        "text/csv"                                                                               => "fa-file-csv",
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
            or "application/msword"                                                              => "fa-file-word",
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
            or "application/vnd.ms-excel"                                                        => "fa-file-excel",
        "application/vnd.openxmlformats-officedocument.presentationml.presentation"
            or "application/vnd.ms-powerpoint"                                                   => "fa-file-powerpoint",
        _                                                                                        => "fa-file"
    };
}

<div class="mb-4 d-flex justify-content-between align-items-center">
    <h2 class="mb-0"><i class="fa-light fa-vault me-2"></i>Vault</h2>
    <a asp-action="SetPin" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
        <i class="fa-light fa-key me-1"></i> Change PIN
    </a>
</div>

<p class="text-muted mb-4">Your secure place for sensitive documents and information.</p>

@* ── Vault category grid ─────────────────────────────── *@
<div class="row g-3 mb-5">
    <div class="col-6 col-md-4">
        <a asp-controller="VaultPasswords" asp-action="Index" class="text-decoration-none">
            <div class="glass-card text-center p-3 h-100">
                <i class="fa-light fa-lock-keyhole fa-2x mb-2 d-block text-primary"></i>
                <div class="fw-semibold">Passwords</div>
            </div>
        </a>
    </div>
    <div class="col-6 col-md-4">
        <a asp-controller="VaultBankAccounts" asp-action="Index" class="text-decoration-none">
            <div class="glass-card text-center p-3 h-100">
                <i class="fa-light fa-building-columns fa-2x mb-2 d-block text-success"></i>
                <div class="fw-semibold">Bank Accounts</div>
            </div>
        </a>
    </div>
    <div class="col-6 col-md-4">
        <a asp-controller="VaultDocuments" asp-action="Index" class="text-decoration-none">
            <div class="glass-card text-center p-3 h-100">
                <i class="fa-light fa-file-user fa-2x mb-2 d-block text-warning"></i>
                <div class="fw-semibold">Personal Documents</div>
            </div>
        </a>
    </div>
    <div class="col-6 col-md-4">
        <a asp-controller="VaultDocuments" asp-action="Index" asp-route-filter="6" class="text-decoration-none">
            <div class="glass-card text-center p-3 h-100">
                <i class="fa-light fa-house-chimney fa-2x mb-2 d-block text-info"></i>
                <div class="fw-semibold">House Plans</div>
            </div>
        </a>
    </div>
    <div class="col-6 col-md-4">
        <a asp-controller="VaultDocuments" asp-action="Index" asp-route-filter="3" class="text-decoration-none">
            <div class="glass-card text-center p-3 h-100">
                <i class="fa-light fa-file-contract fa-2x mb-2 d-block text-danger"></i>
                <div class="fw-semibold">Legal Documents</div>
            </div>
        </a>
    </div>
    <div class="col-6 col-md-4">
        <a asp-controller="VaultDocuments" asp-action="Index" class="text-decoration-none">
            <div class="glass-card text-center p-3 h-100">
                <i class="fa-light fa-file-circle-plus fa-2x mb-2 d-block text-secondary"></i>
                <div class="fw-semibold">Other Files</div>
            </div>
        </a>
    </div>
</div>

@* ── Secure file upload ──────────────────────────────── *@
<div class="glass-card p-4 mb-4">
    <h5 class="mb-3"><i class="fa-light fa-folder-open me-2"></i>Upload a Secure File</h5>

    <form id="uploadForm" asp-action="Upload" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <div class="mb-3">
            <input type="file" name="file" id="vaultFileInput" class="form-control" onchange="showFileSize(this)" />
            <div id="fileSizeHint" class="form-text d-none"></div>
            <div class="form-text text-muted">Maximum file size: 20 MB</div>
        </div>
        <button type="button" id="uploadBtn" class="btn btn-success rounded-pill px-4" onclick="submitUpload()">
            <i class="fa-light fa-shield-check me-1"></i> Encrypt &amp; Upload
        </button>
    </form>
</div>

@* ── Hidden download / delete forms ─────────────────── *@
<form id="downloadForm" asp-action="Download" method="post" class="d-none">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="downloadId" />
</form>

<form id="deleteForm" asp-action="DeleteFile" method="post" class="d-none">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="deleteId" />
</form>

@* ── Uploaded files list ─────────────────────────────── *@
@if (ViewData["UserFiles"] is List<Nestled.Data.Vault.VaultFile> userFiles && userFiles.Any())
{
    <div class="glass-card p-4 mb-4">
        <h5 class="mb-3"><i class="fa-light fa-folder-closed me-2"></i>Your Uploaded Files</h5>
        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th>File</th>
                        <th>Uploaded</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var file in userFiles)
                    {
                        <tr>
                            <td>
                                <i class="fa-light @FileIcon(file.ContentType) me-2 text-primary flex-shrink-0"></i>
                                <span class="text-break">@file.OriginalFileName</span>
                            </td>
                            <td class="text-muted small">@file.UploadedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                            <td class="text-end">
                                <button type="button"
                                        class="btn btn-sm btn-outline-primary rounded-pill px-2 me-1"
                                        onclick="submitDownload('@file.Id')">
                                    <i class="fa-light fa-cloud-arrow-down"></i>
                                </button>
                                <button type="button"
                                        class="btn btn-sm btn-outline-danger rounded-pill px-2"
                                        data-file-id="@file.Id"
                                        data-file-name="@file.OriginalFileName"
                                        onclick="confirmDelete(this.dataset.fileId, this.dataset.fileName)">
                                    <i class="fa-light fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="glass-card p-4 mb-4 text-center text-muted">
        <i class="fa-light fa-folder-open fa-2x mb-2 d-block"></i>
        No encrypted files uploaded yet.
    </div>
}

@* ── Biometric authentication management ─────────────── *@
<div class="glass-card p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="mb-0"><i class="fa-light fa-fingerprint me-2"></i>Biometric Authentication</h5>
        @if (biometricCount > 0)
        {
            <span class="badge bg-success rounded-pill">@biometricCount registered</span>
        }
    </div>

    @if (!hasSessionKey)
    {
        <div class="alert alert-warning small mb-3">
            <i class="fa-light fa-triangle-exclamation me-1"></i>
            Re-lock and unlock the vault with your PIN once to enable biometric registration.
        </div>
    }

    <p class="text-muted small mb-3">
        Register this device's Face ID or fingerprint to unlock the vault without typing your PIN.
        Your vault PIN is still required for the first unlock each session.
    </p>

    @if (biometricCount == 0)
    {
        <button type="button" class="btn btn-primary rounded-pill px-4"
                onclick="registerBiometric()" @(hasSessionKey ? "" : "disabled")>
            <i class="fa-light fa-fingerprint me-2"></i>Register This Device
        </button>
    }
    else
    {
        <div class="d-flex gap-2 flex-wrap">
            <button type="button" class="btn btn-outline-primary rounded-pill px-4"
                    onclick="registerBiometric()" @(hasSessionKey ? "" : "disabled")>
                <i class="fa-light fa-plus me-1"></i>Add Another Device
            </button>
            <button type="button" class="btn btn-outline-danger rounded-pill px-4"
                    onclick="removeAllBiometrics()">
                <i class="fa-light fa-trash me-1"></i>Remove All Biometrics
            </button>
        </div>
    }
</div>

@if (TempData["ShowVaultPinWarning"] != null)
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            Swal.fire({
                titleText: "Vault PIN Set",
                icon: "info",
                html: "Your Vault PIN has been successfully set.<br><br><strong>Please keep it safe.</strong><br>If lost, you will need to contact support.",
                confirmButtonText: "Understood"
            });
        });
    </script>
}

@section Scripts {
<script>
function showFileSize(input) {
    const hint = document.getElementById('fileSizeHint');
    if (input.files.length) {
        const mb = (input.files[0].size / 1024 / 1024).toFixed(2);
        hint.textContent = `Selected: ${input.files[0].name} (${mb} MB)`;
        hint.classList.remove('d-none');
        hint.className = 'form-text ' + (input.files[0].size > 20 * 1024 * 1024 ? 'text-danger' : 'text-muted');
    } else {
        hint.classList.add('d-none');
    }
}

function submitUpload() {
    const fi = document.getElementById('vaultFileInput');
    if (!fi.files.length) {
        Swal.fire({ titleText: 'No file selected', text: 'Please choose a file first.', icon: 'warning', toast: true, position: 'top-end', timer: 2500, showConfirmButton: false });
        return;
    }
    if (fi.files[0].size > 20 * 1024 * 1024) {
        Swal.fire({ titleText: 'File too large', text: 'Maximum upload size is 20 MB.', icon: 'error', confirmButtonText: 'OK' });
        return;
    }
    const btn = document.getElementById('uploadBtn');
    btn.disabled = true;
    btn.innerHTML = '<i class="fa-light fa-spinner fa-spin me-1"></i> Uploading…';
    document.getElementById('uploadForm').submit();
}

function submitDownload(fileId) {
    document.getElementById('downloadId').value = fileId;
    document.getElementById('downloadForm').submit();
}

function escapeHtml(str) {
    const d = document.createElement('div');
    d.textContent = str;
    return d.innerHTML;
}

async function confirmDelete(fileId, fileName) {
    const { isConfirmed } = await Swal.fire({
        titleText: 'Delete file?',
        html: `<span class="text-break">${escapeHtml(fileName)}</span><br><small class="text-muted">This cannot be undone.</small>`,
        icon: 'warning',
        showCancelButton: true,
        confirmButtonText: 'Delete',
        confirmButtonColor: '#dc3545',
        cancelButtonText: 'Cancel'
    });
    if (!isConfirmed) return;
    document.getElementById('deleteId').value = fileId;
    document.getElementById('deleteForm').submit();
}

// ── Biometric helpers ──────────────────────────────────────────────────────

function base64UrlDecode(b64url) {
    const b64 = b64url.replace(/-/g, '+').replace(/_/g, '/');
    const bin = atob(b64);
    return Uint8Array.from(bin, c => c.charCodeAt(0)).buffer;
}

function base64UrlEncode(buf) {
    const arr  = new Uint8Array(buf);
    let binary = '';
    arr.forEach(b => binary += String.fromCharCode(b));
    return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=/g, '');
}

const csrf = document.querySelector('#uploadForm input[name="__RequestVerificationToken"]').value;

async function registerBiometric() {
    try {
        // 1. Get registration options
        const optRes = await fetch('/Vault/BiometricRegisterOptions', {
            method: 'POST',
            headers: { 'RequestVerificationToken': csrf }
        });
        const options = await optRes.json();
        if (options.success === false) throw new Error(options.error ?? 'Failed to get registration options.');

        // 2. Prepare for WebAuthn
        options.challenge = base64UrlDecode(options.challenge);
        options.user.id   = base64UrlDecode(options.user.id);
        options.excludeCredentials = (options.excludeCredentials ?? []).map(c => ({
            ...c, id: base64UrlDecode(c.id)
        }));

        // 3. Prompt biometric
        Swal.fire({ titleText: 'Follow your device prompt…', text: 'Use Face ID or your fingerprint when prompted.', icon: 'info', showConfirmButton: false, allowOutsideClick: false });
        const cred = await navigator.credentials.create({ publicKey: options });
        Swal.close();

        // 4. Send to server
        const payload = {
            id:    cred.id,
            rawId: base64UrlEncode(cred.rawId),
            type:  cred.type,
            response: {
                attestationObject: base64UrlEncode(cred.response.attestationObject),
                clientDataJSON:    base64UrlEncode(cred.response.clientDataJSON)
            }
        };

        const completeRes = await fetch('/Vault/BiometricRegisterComplete', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': csrf },
            body: JSON.stringify(payload)
        });
        const result = await completeRes.json();

        if (result.success) {
            Swal.fire({ titleText: 'Biometric registered!', text: 'You can now unlock the vault with Face ID or your fingerprint.', icon: 'success', confirmButtonText: 'Great' })
                .then(() => location.reload());
        } else {
            throw new Error(result.error ?? 'Registration failed.');
        }
    } catch (err) {
        Swal.close();
        if (err.name === 'NotAllowedError') {
            Swal.fire({ titleText: 'Cancelled', text: 'Biometric registration was cancelled.', icon: 'warning', confirmButtonText: 'OK' });
        } else {
            Swal.fire({ titleText: 'Registration failed', text: err.message, icon: 'error', confirmButtonText: 'OK' });
        }
    }
}

async function removeAllBiometrics() {
    const { isConfirmed } = await Swal.fire({
        titleText: 'Remove all biometrics?',
        text: 'All registered devices will need to re-enrol. You can still unlock with your PIN.',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonText: 'Remove All',
        confirmButtonColor: '#dc3545'
    });
    if (!isConfirmed) return;

    const res = await fetch('/Vault/BiometricRemoveAll', {
        method: 'POST',
        headers: { 'RequestVerificationToken': csrf }
    });
    const data = await res.json();
    if (data.success) {
        Swal.fire({ titleText: 'Removed', icon: 'success', toast: true, position: 'top-end', timer: 2000, showConfirmButton: false })
            .then(() => location.reload());
    }
}

@if (TempData["UploadSuccess"] != null)
{
    <text>
    document.addEventListener('DOMContentLoaded', () => Swal.fire({ titleText: @Html.Raw(System.Text.Json.JsonSerializer.Serialize((string)TempData["UploadSuccess"])), icon: 'success', toast: true, position: 'top-end', timer: 2500, showConfirmButton: false }));
    </text>
}
@if (TempData["UploadError"] != null)
{
    <text>
    document.addEventListener('DOMContentLoaded', () => Swal.fire({ titleText: 'Upload failed', text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize((string)TempData["UploadError"])), icon: 'error', confirmButtonText: 'OK' }));
    </text>
}
</script>
}
