@model IEnumerable<Nestled.Data.Pet>

@{
    ViewData["Title"] = "Wall of Remembrance";
}

<div class="mb-4 text-center">
    <h2 class="mb-1"><i class="fa-light fa-hands-holding-heart me-2 text-muted"></i>Wall of Remembrance</h2>
    <p class="text-muted small">Forever in our hearts.</p>
</div>

@if (!Model.Any())
{
    <div class="glass-card text-center py-5">
        <i class="fa-light fa-dove fa-3x text-muted mb-3 d-block"></i>
        <p class="text-muted mb-0">No pets have been added to the Wall of Remembrance yet.</p>
    </div>
}

<div class="row g-3">
    @foreach (var pet in Model)
    {
        int? fullYears = null;
        int? fullMonths = null;
        if (pet.BirthDate.HasValue && pet.DateOfDeath.HasValue)
        {
            var birth = pet.BirthDate.Value;
            var death = pet.DateOfDeath.Value;
            int years = death.Year - birth.Year;
            if (death < birth.AddYears(years)) years--;
            int months = death.Month - birth.Month;
            if (death.Day < birth.Day) months--;
            if (months < 0) months += 12;
            fullYears = years;
            fullMonths = months;
        }

        <div class="col-md-4 col-sm-6">
            <div class="glass-card text-center p-4 h-100">
                @if (!string.IsNullOrEmpty(pet.PhotoPath))
                {
                    <img src="@pet.PhotoPath" alt="@pet.Name"
                         class="rounded mb-3 w-100"
                         style="height:180px;object-fit:cover;border-radius:12px;" />
                }
                else
                {
                    <div class="rounded mb-3 d-flex align-items-center justify-content-center mx-auto"
                         style="height:180px;background:rgba(255,255,255,.05);">
                        <i class="fa-light fa-paw fa-3x text-muted"></i>
                    </div>
                }

                <h5 class="fw-semibold mb-2">@pet.Name</h5>

                @if (fullYears.HasValue && fullMonths.HasValue)
                {
                    <p class="text-muted small mb-1">
                        Lived @fullYears year@(fullYears == 1 ? "" : "s")
                        @if (fullMonths > 0)
                        {
                            <text>, @fullMonths month@(fullMonths == 1 ? "" : "s")</text>
                        }
                    </p>
                }

                @if (pet.DateOfDeath.HasValue)
                {
                    <p class="text-muted small mb-3">
                        <i class="fa-light fa-heart me-1 text-danger"></i>@pet.DateOfDeath.Value.ToString("dd MMMM yyyy")
                    </p>
                }

                <a asp-controller="Pets" asp-action="Details" asp-route-id="@pet.Id"
                   class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                    <i class="fa-light fa-arrow-right me-1"></i> View
                </a>
            </div>
        </div>
    }
</div>
