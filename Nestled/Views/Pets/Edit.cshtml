@model Nestled.ViewModels.PetEditViewModel

@{
    ViewData["Title"] = "Edit Pet";
}

<div class="mb-4">
    <h2 class="mb-0"><i class="fa-light fa-pen-to-square me-2"></i>Edit Pet</h2>
</div>

<div class="glass-card p-4">
<form asp-action="Edit" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <input type="hidden" asp-for="Pet.Id" />

    <div class="row gx-3 gy-3">

        <!-- Pet Name / Species -->
        <div class="col-md-6">
            <label asp-for="Pet.Name" class="form-label"></label>
            <input asp-for="Pet.Name" class="form-control" />
            <span asp-validation-for="Pet.Name" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Pet.Species" class="form-label"></label>
            <input asp-for="Pet.Species" class="form-control" />
            <span asp-validation-for="Pet.Species" class="text-danger"></span>
        </div>

        <!-- Breed / Photo Picker -->
        <div class="col-md-6">
            <label asp-for="Pet.Breed" class="form-label"></label>
            <input asp-for="Pet.Breed" class="form-control" />
            <span asp-validation-for="Pet.Breed" class="text-danger"></span>
        </div>
        <div class="col-md-6 text-center">
            <label for="PhotoFile" class="form-label fw-semibold d-block">Pet Photo</label>

            @if (!string.IsNullOrEmpty(Model.PhotoPath))
            {
                <a href="#" data-bs-toggle="modal" data-bs-target="#photoModal">
                    <img src="@Url.Content(Model.PhotoPath)"
                         alt="Pet photo"
                         class="rounded-circle shadow-sm mb-2"
                         style="width: 120px; height: 120px; object-fit: cover; cursor: pointer;" />
                </a>
                <div class="badge bg-success mb-2">Photo on file</div>
            }
            else
            {
                <div class="text-muted small mb-2">No photo currently set</div>
            }

            <input type="file" name="PhotoFile" class="form-control" data-val="false" />
        </div>

        <!-- Family Dropdown -->
        <div class="col-md-6">
            <label asp-for="FamilyId" class="form-label fw-semibold">Family</label>
            <select asp-for="FamilyId" asp-items="ViewBag.FamilyOptions" class="form-select">
                <option value="">-- select family --</option>
            </select>
            <span asp-validation-for="FamilyId" class="text-danger small"></span>
        </div>

        <!-- Birthdate / Service Dates -->
        <div class="col-md-6">
            <label asp-for="Pet.BirthDate" class="form-label"></label>
            <input asp-for="Pet.BirthDate" class="form-control" type="date" />
            <span asp-validation-for="Pet.BirthDate" class="text-danger"></span>
        </div>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="LastWeightKg" class="form-label"></label>
                <input asp-for="LastWeightKg" class="form-control" placeholder="e.g. 12.5" step="0.1" />
                <span asp-validation-for="LastWeightKg" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="LastWeighedDate" class="form-label"></label>
                <input asp-for="LastWeighedDate" type="date" class="form-control" />
                <span asp-validation-for="LastWeighedDate" class="text-danger small"></span>
            </div>
        </div>

        <div class="col-md-6">
            <label asp-for="Pet.LastDewormingDate" class="form-label"></label>
            <input asp-for="Pet.LastDewormingDate" class="form-control" type="date" />
            <span asp-validation-for="Pet.LastDewormingDate" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Pet.LastTickFleaDate" class="form-label"></label>
            <input asp-for="Pet.LastTickFleaDate" class="form-control" type="date" />
            <span asp-validation-for="Pet.LastTickFleaDate" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Pet.LastGroomingDate" class="form-label"></label>
            <input asp-for="Pet.LastGroomingDate" class="form-control" type="date" />
            <span asp-validation-for="Pet.LastGroomingDate" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Pet.LastCheckupDate" class="form-label"></label>
            <input asp-for="Pet.LastCheckupDate" class="form-control" type="date" />
            <span asp-validation-for="Pet.LastCheckupDate" class="text-danger"></span>
        </div>

        <!-- Options Section -->
        <div class="col-12">
            <h5 class="fw-semibold mt-2 mb-3">Options</h5>
            <div class="row gx-3 gy-3">
                <div class="col-md-4">
                    <div class="form-check">
                        <input asp-for="Pet.HasInsurance" class="form-check-input" id="HasInsurance" />
                        <label asp-for="Pet.HasInsurance" class="form-check-label"></label>
                    </div>
                </div>
                <div class="col-md-8" id="insuranceNumberDiv" style="display:@(Model.Pet.HasInsurance ? "block" : "none");">
                    <label asp-for="Pet.InsuranceNumber" class="form-label"></label>
                    <input asp-for="Pet.InsuranceNumber" class="form-control" />
                    <span asp-validation-for="Pet.InsuranceNumber" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <div class="form-check">
                        <input asp-for="Pet.IsMicrochipped" class="form-check-input" id="IsMicrochipped" />
                        <label asp-for="Pet.IsMicrochipped" class="form-check-label"></label>
                    </div>
                </div>
                <div class="col-md-8" id="microchipNumberDiv" style="display:@(Model.Pet.IsMicrochipped ? "block" : "none");">
                    <label asp-for="Pet.MicrochipNumber" class="form-label"></label>
                    <input asp-for="Pet.MicrochipNumber" class="form-control" />
                    <span asp-validation-for="Pet.MicrochipNumber" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <div class="form-check">
                        <input asp-for="Pet.IsDeceased" class="form-check-input" id="IsDeceased" />
                        <label asp-for="Pet.IsDeceased" class="form-check-label"></label>
                    </div>
                </div>
                <div class="col-md-8" id="deathDateDiv" style="display:@(Model.Pet.IsDeceased ? "block" : "none");">
                    <label asp-for="Pet.DateOfDeath" class="form-label"></label>
                    <input asp-for="Pet.DateOfDeath" class="form-control" type="date" />
                    <span asp-validation-for="Pet.DateOfDeath" class="text-danger"></span>
                </div>
            </div>
        </div>

    </div>

    <div class="d-flex justify-content-between align-items-center mt-4">
        <a asp-action="Index" asp-route-familyId="@Model.FamilyId" class="btn btn-outline-secondary rounded-pill px-4">
            <i class="fa-light fa-arrow-left me-1"></i> Cancel
        </a>
        <button type="submit" class="btn btn-primary rounded-pill px-4">
            <i class="fa-light fa-floppy-disk me-1"></i> Save Changes
        </button>
    </div>
</form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('HasInsurance')
            .addEventListener('change', e => {
                document.getElementById('insuranceNumberDiv').style.display = e.target.checked ? 'block' : 'none';
            });
        document.getElementById('IsMicrochipped')
            .addEventListener('change', e => {
                document.getElementById('microchipNumberDiv').style.display = e.target.checked ? 'block' : 'none';
            });
        document.getElementById('IsDeceased')
            .addEventListener('change', e => {
                document.getElementById('deathDateDiv').style.display = e.target.checked ? 'block' : 'none';
            });
    </script>
}
