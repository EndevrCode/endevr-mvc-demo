@model Nestled.Data.ServiceContact

@{
    ViewData["Title"] = "Delete Service Contact";
    var familyId = Model.FamilyId;
}

<div class="mb-4">
    <h2 class="mb-0"><i class="fa-light fa-trash me-2 text-danger"></i>Delete Service Contact</h2>
</div>

<div class="glass-card p-4 mx-auto" style="max-width: 500px;">
    <div class="text-center mb-4">
        <div class="rounded-circle bg-danger bg-opacity-10 d-inline-flex align-items-center justify-content-center mb-3"
             style="width:64px;height:64px;">
            <i class="fa-light fa-screwdriver-wrench fa-2x text-danger"></i>
        </div>
        <h5 class="fw-semibold">@Model.Company</h5>
        <p class="text-muted mb-0">
            @Model.ServiceType
            @if (!string.IsNullOrEmpty(Model.ContactPerson))
            {
                <text>&bull; @Model.ContactPerson</text>
            }
        </p>
        @if (!string.IsNullOrEmpty(Model.ContactNumber))
        {
            <p class="text-muted small mb-0">@Model.ContactNumber</p>
        }
    </div>

    <p class="text-muted text-center small mb-4">
        Are you sure you want to delete this service contact? This cannot be undone.
    </p>

    <form asp-action="Delete" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="FamilyId" />

        <div class="d-flex justify-content-between gap-2">
            <a asp-action="Index" asp-route-familyId="@familyId"
               class="btn btn-outline-secondary rounded-pill px-4 flex-grow-1">
                <i class="fa-light fa-arrow-left me-1"></i> Cancel
            </a>
            <button type="submit" class="btn btn-danger rounded-pill px-4 flex-grow-1">
                <i class="fa-light fa-trash me-1"></i> Delete
            </button>
        </div>
    </form>
</div>
