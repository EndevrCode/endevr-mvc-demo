@model List<Nestled.Models.UtilitySummaryRow>
@{
    var type = (Nestled.Data.UtilityType)ViewData["UtilityType"]!;
    ViewData["Title"] = $"{type} Summary";
    var familyId = (Guid)ViewData["FamilyId"]!;
    var isElec = type == Nestled.Data.UtilityType.Electricity;
    var unitLabel = isElec ? "kWh" : "Litres";

    var chartLabels = System.Text.Json.JsonSerializer.Serialize(
        Model.Select(r => r.PurchaseDate.ToString("dd MMM yy")).ToList());
    var chartAmounts = System.Text.Json.JsonSerializer.Serialize(
        Model.Select(r => r.AmountPaid).ToList());
    var chartUnits = System.Text.Json.JsonSerializer.Serialize(
        Model.Select(r => r.UnitsReceived).ToList());
}

<div class="mb-4">
    <h2 class="mb-0"><i class="fa-light fa-chart-line me-2"></i>@ViewData["Title"]</h2>
</div>

@if (!Model.Any())
{
    <div class="glass-card text-center py-5">
        <i class="fa-light fa-chart-line fa-3x text-muted mb-3 d-block"></i>
        <p class="text-muted mb-0">No records yet to summarise.</p>
    </div>
}
else
{
    <!-- Chart -->
    <div class="glass-card p-3 mb-4">
        <canvas id="summaryChart" style="max-height:280px;"></canvas>
    </div>

    <!-- Desktop Table -->
    <div class="d-none d-md-block glass-card p-3 mb-4">
        <table class="table table-bordered mb-0">
            <thead>
                <tr>
                    <th>Purchase Date</th>
                    <th>@(isElec ? "Units Received (kWh)" : "Litres Received")</th>
                    <th>Amount Paid</th>
                    <th>Purchased From</th>
                    <th>Previous Purchase</th>
                    <th>Days Between</th>
                    <th>Average Daily Usage</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td>@r.PurchaseDate.ToString("dd MMMM yyyy")</td>
                        <td>@(r.UnitsReceived?.ToString("0.##") ?? "-")</td>
                        <td>R @r.AmountPaid.ToString("N2")</td>
                        <td>@r.PurchasedFrom</td>
                        <td>@(r.PreviousPurchase?.ToString("dd MMMM yyyy") ?? "-")</td>
                        <td>@(r.DaysBetween?.ToString() ?? "-")</td>
                        <td>@(r.AverageDailyUsage?.ToString("0.##") ?? "-")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Mobile Cards -->
    <div class="d-md-none mb-4">
        @foreach (var r in Model)
        {
            <div class="glass-card mb-3 p-3">
                <div class="fw-semibold mb-2">@r.PurchaseDate.ToString("dd MMMM yyyy")</div>
                <div class="row gy-2">
                    <div class="col-6">
                        <div class="text-muted small">@(isElec ? "Units (kWh)" : "Litres")</div>
                        <div>@(r.UnitsReceived?.ToString("0.##") ?? "-")</div>
                    </div>
                    <div class="col-6">
                        <div class="text-muted small">Amount Paid</div>
                        <div>R @r.AmountPaid.ToString("N2")</div>
                    </div>
                    <div class="col-6">
                        <div class="text-muted small">Purchased From</div>
                        <div>@(r.PurchasedFrom ?? "-")</div>
                    </div>
                    <div class="col-6">
                        <div class="text-muted small">Days Since Last</div>
                        <div>@(r.DaysBetween?.ToString() ?? "-")</div>
                    </div>
                    <div class="col-6">
                        <div class="text-muted small">Avg Daily Usage</div>
                        <div>@(r.AverageDailyUsage?.ToString("0.##") ?? "-")</div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<p class="text-center mt-2">
    <a asp-action="Index" asp-route-familyId="@familyId" class="btn btn-outline-secondary rounded-pill px-4">
        <i class="fa-light fa-arrow-left me-1"></i> Back to Utilities
    </a>
</p>

@if (Model.Any())
{
    @section Scripts {
        <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
        <script>
        (function () {
            const labels  = @Html.Raw(chartLabels);
            const amounts = @Html.Raw(chartAmounts);
            const units   = @Html.Raw(chartUnits);
            const unitLabel = '@unitLabel';

            const ctx = document.getElementById('summaryChart').getContext('2d');

            const datasets = [{
                label: 'Amount Paid (R)',
                data: amounts,
                type: 'bar',
                backgroundColor: 'rgba(99,102,241,.35)',
                borderColor: 'rgba(99,102,241,.8)',
                borderWidth: 1,
                yAxisID: 'yAmount'
            }];

            const hasUnits = units.some(u => u !== null);
            if (hasUnits) {
                datasets.push({
                    label: `Units (${unitLabel})`,
                    data: units,
                    type: 'line',
                    borderColor: 'rgba(16,185,129,.8)',
                    backgroundColor: 'rgba(16,185,129,.1)',
                    borderWidth: 2,
                    pointRadius: 4,
                    tension: 0.3,
                    fill: true,
                    yAxisID: 'yUnits'
                });
            }

            const scales = {
                x: { ticks: { color: 'rgba(255,255,255,.6)', maxRotation: 45 }, grid: { color: 'rgba(255,255,255,.05)' } },
                yAmount: {
                    position: 'left',
                    ticks: { color: 'rgba(99,102,241,.9)', callback: v => 'R' + v.toLocaleString() },
                    grid: { color: 'rgba(255,255,255,.05)' }
                }
            };

            if (hasUnits) {
                scales.yUnits = {
                    position: 'right',
                    ticks: { color: 'rgba(16,185,129,.9)', callback: v => v + ' ' + unitLabel },
                    grid: { drawOnChartArea: false }
                };
            }

            new Chart(ctx, {
                data: { labels, datasets },
                options: {
                    responsive: true,
                    interaction: { mode: 'index', intersect: false },
                    plugins: {
                        legend: { labels: { color: 'rgba(255,255,255,.7)' } },
                        tooltip: { callbacks: {
                            label: function (ctx) {
                                const v = ctx.parsed.y;
                                if (v === null) return null;
                                return ctx.dataset.yAxisID === 'yAmount'
                                    ? `R ${v.toFixed(2)}`
                                    : `${v} ${unitLabel}`;
                            }
                        }}
                    },
                    scales
                }
            });
        })();
        </script>
    }
}
