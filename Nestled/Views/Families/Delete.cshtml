@model Nestled.Data.Family

@{
    ViewData["Title"] = "Delete Family";
}

<div class="mb-4 d-flex justify-content-between align-items-center">
    <h2 class="mb-0"><i class="fa-light fa-trash me-2 text-danger"></i>Delete Family</h2>
</div>

<div class="glass-card p-4 mx-auto text-center" style="max-width:480px;">
    <i class="fa-light fa-triangle-exclamation fa-3x text-warning mb-3 d-block"></i>
    <h5 class="fw-bold mb-1">@Model.Name</h5>
    <p class="text-muted small mb-4">
        Deleting this family is permanent and cannot be undone. All members, pets, utilities,
        and other family data will be removed.
    </p>

    <form asp-action="Delete" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div class="d-flex justify-content-center gap-3">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-4">
                <i class="fa-light fa-arrow-left me-1"></i> Cancel
            </a>
            <button type="submit" class="btn btn-danger btn-sm rounded-pill px-4">
                <i class="fa-light fa-trash me-1"></i> Delete Family
            </button>
        </div>
    </form>
</div>
