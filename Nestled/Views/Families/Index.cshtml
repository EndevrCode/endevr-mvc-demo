@model IEnumerable<Nestled.Data.Family>

@{
    ViewData["Title"] = "My Families";
}

<div class="mb-4 d-flex justify-content-between align-items-center">
    <h2 class="mb-0"><i class="fa-light fa-people-group me-2"></i>My Families</h2>
    <a asp-action="Create" class="btn btn-primary btn-sm rounded-pill px-3">
        <i class="fa-light fa-plus me-1"></i> Create Family
    </a>
</div>

@if (!Model.Any())
{
    <div class="glass-card text-center py-5">
        <i class="fa-light fa-people-group fa-3x text-muted mb-3 d-block fs-1"></i>
        <p class="text-muted mb-2">You're not in any families yet.</p>
        <a asp-action="Create" class="btn btn-primary btn-sm rounded-pill px-3">
            <i class="fa-light fa-plus me-1"></i> Create Your First Family
        </a>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var family in Model)
        {
            <div class="col-md-4">
                <div class="glass-card h-100 p-3 d-flex flex-column">
                    <h5 class="fw-semibold mb-1">@family.Name</h5>
                    <p class="text-muted small mb-3">
                        Created by <strong>@(family.CreatedBy.Profile?.FirstName ?? family.CreatedBy.UserName)</strong>
                        on @family.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
                    </p>
                    <a asp-action="Details" asp-route-id="@family.Id"
                       class="btn btn-outline-primary btn-sm rounded-pill px-3 mt-auto">
                        <i class="fa-light fa-arrow-right me-1"></i> View Family
                    </a>
                </div>
            </div>
        }
    </div>
}
