@model Nestled.Data.Family

@{
    ViewData["Title"] = "Edit Family";
}

<div class="mb-4 d-flex justify-content-between align-items-center">
    <h2 class="mb-0"><i class="fa-light fa-pen-to-square me-2"></i>Edit Family</h2>
</div>

<div class="glass-card p-4 mx-auto" style="max-width:480px;">
    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="CreatedById" />
        <input type="hidden" asp-for="CreatedAt" />

        <div class="mb-4">
            <label asp-for="Name" class="form-label fw-semibold">Family Name</label>
            <input asp-for="Name" class="form-control" placeholder="e.g. The Smith Family" maxlength="200" />
            <span asp-validation-for="Name" class="text-danger small"></span>
        </div>

        <div class="d-flex justify-content-between align-items-center gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                <i class="fa-light fa-arrow-left me-1"></i> Cancel
            </a>
            <button type="submit" class="btn btn-primary btn-sm rounded-pill px-4">
                <i class="fa-light fa-floppy-disk me-1"></i> Save Changes
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
