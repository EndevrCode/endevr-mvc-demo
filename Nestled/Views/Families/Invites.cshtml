@model IEnumerable<Nestled.Data.FamilyInvite>

@{
    ViewData["Title"] = "Pending Invites";
    var familyId = (Guid)ViewData["FamilyId"];
}

<div class="mb-4 d-flex justify-content-between align-items-center">
    <h2 class="mb-0"><i class="fa-light fa-envelope me-2"></i>Pending Invites</h2>
    <a asp-action="Invite" asp-route-id="@familyId" class="btn btn-primary btn-sm rounded-pill px-3">
        <i class="fa-light fa-plus me-1"></i> New Invite
    </a>
</div>

@if (!Model.Any())
{
    <div class="glass-card p-4 text-center text-muted">
        <i class="fa-light fa-envelope-open fa-2x mb-2 d-block"></i>
        No pending invites.
    </div>
}
else
{
    <div class="glass-card p-0 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Invited Email</th>
                        <th>Expires</th>
                        <th class="text-end pe-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var invite in Model)
                    {
                        <tr>
                            <td class="ps-3">@invite.InvitedEmail</td>
                            <td class="text-muted small">@invite.ExpiresAt.ToString("dd MMM yyyy")</td>
                            <td class="text-end pe-3">
                                <form asp-action="Resend" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="token" value="@invite.Token" />
                                    <button type="submit" class="btn btn-sm btn-outline-primary rounded-pill px-3 me-1">
                                        <i class="fa-light fa-paper-plane me-1"></i>Resend
                                    </button>
                                </form>
                                <form asp-action="Revoke" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="token" value="@invite.Token" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                        <i class="fa-light fa-xmark me-1"></i>Revoke
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<div class="mt-3">
    <a asp-action="Details" asp-route-id="@familyId" class="btn btn-outline-secondary rounded-pill px-4">
        <i class="fa-light fa-arrow-left me-1"></i> Back to Family
    </a>
</div>
