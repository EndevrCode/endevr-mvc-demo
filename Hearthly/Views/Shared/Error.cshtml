@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="d-flex flex-column align-items-center justify-content-center text-center" style="min-height: 60vh;">
    <div class="glass-card p-5" style="max-width: 520px; width: 100%;">
        <i class="fa-light fa-triangle-exclamation fa-3x text-danger mb-3 d-block"></i>
        <h3 class="fw-semibold mb-2">Something went wrong</h3>
        <p class="text-muted mb-4">An error occurred while processing your request. Please try again or go back.</p>

        @if (Model.ShowRequestId)
        {
            <p class="text-muted small mb-4">
                Request ID: <code class="font-monospace">@Model.RequestId</code>
            </p>
        }

        <div class="d-flex gap-2 justify-content-center">
            <a href="javascript:history.back()" class="btn btn-outline-secondary rounded-pill px-4">
                <i class="fa-light fa-arrow-left me-1"></i> Go Back
            </a>
            <a href="/" class="btn btn-outline-primary rounded-pill px-4">
                <i class="fa-light fa-house me-1"></i> Home
            </a>
        </div>
    </div>
</div>
