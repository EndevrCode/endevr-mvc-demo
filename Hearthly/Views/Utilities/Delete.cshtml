@model Hearthly.Data.Utility

@{
    ViewData["Title"] = "Delete Utility";
}

<div class="mb-4">
    <h2 class="mb-0"><i class="fa-light fa-trash me-2 text-danger"></i>Delete Utility</h2>
</div>

<div class="glass-card p-4 mx-auto" style="max-width: 500px;">
    <div class="text-center mb-4">
        <div class="rounded-circle bg-danger bg-opacity-10 d-inline-flex align-items-center justify-content-center mb-3"
             style="width:64px;height:64px;">
            <i class="fa-light @(Model.Type == Hearthly.Data.UtilityType.Electricity ? "fa-bolt" : "fa-fire-flame-curved") fa-2x text-danger"></i>
        </div>
        <h5 class="fw-semibold">@Model.Type</h5>
        <p class="text-muted mb-0">
            R @Model.AmountPaid.ToString("N2")
            @if (!string.IsNullOrEmpty(Model.PurchasedFrom))
            {
                <text>&bull; @Model.PurchasedFrom</text>
            }
        </p>
        <p class="text-muted small mb-0">@Model.PurchaseDate.ToString("dd MMMM yyyy")</p>
    </div>

    <p class="text-muted text-center small mb-4">
        Are you sure you want to delete this utility record? This action cannot be undone.
    </p>

    <form asp-action="Delete" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div class="d-flex justify-content-between gap-2">
            <a asp-action="Index" asp-route-familyId="@Model.FamilyId" class="btn btn-outline-secondary rounded-pill px-4 flex-grow-1">
                <i class="fa-light fa-arrow-left me-1"></i> Cancel
            </a>
            <button type="submit" class="btn btn-danger rounded-pill px-4 flex-grow-1">
                <i class="fa-light fa-trash me-1"></i> Delete
            </button>
        </div>
    </form>
</div>
