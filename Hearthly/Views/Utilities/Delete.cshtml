@model Hearthly.Data.Utility

@{
    ViewData["Title"] = "Delete Utility";
}

<div class="mb-4">
    <h2 class="mb-0"><i class="fa-light fa-trash me-2"></i>Delete Utility</h2>
</div>

<div class="glass-card p-4 mx-auto" style="max-width: 560px;">
    <p class="text-muted mb-4">Are you sure you want to delete this utility record? This action cannot be undone.</p>

    <dl class="row mb-4">
        <dt class="col-sm-4">Type</dt>
        <dd class="col-sm-8">@Model.Type</dd>

        <dt class="col-sm-4">Amount Paid</dt>
        <dd class="col-sm-8">@Model.AmountPaid.ToString("C")</dd>

        <dt class="col-sm-4">Purchased From</dt>
        <dd class="col-sm-8">@(Model.PurchasedFrom ?? "—")</dd>

        <dt class="col-sm-4">Purchase Date</dt>
        <dd class="col-sm-8">@(Model.PurchaseDate?.ToString("dd MMMM yyyy") ?? "—")</dd>

        @if (!string.IsNullOrWhiteSpace(Model.TokenNumber))
        {
            <dt class="col-sm-4">Token Number</dt>
            <dd class="col-sm-8">@Model.TokenNumber</dd>
        }
    </dl>

    <form asp-action="Delete" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div class="d-flex justify-content-between align-items-center">
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3">Cancel</a>
            <button type="submit" class="btn btn-danger rounded-pill px-4">
                <i class="fa-light fa-trash me-1"></i> Delete
            </button>
        </div>
    </form>
</div>
