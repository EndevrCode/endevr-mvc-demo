@model IEnumerable<Hearthly.Data.Utility>
@{
    ViewData["Title"] = "Utilities";
    var familyId = (Guid)ViewData["FamilyId"]!;
}

<div class="mb-4 d-flex justify-content-between align-items-center">
    <h2 class="mb-0"><i class="fa-light fa-screwdriver-wrench me-2"></i>Utilities</h2>
    <a asp-action="Create"
       asp-route-familyId="@familyId"
       class="btn btn-primary btn-sm rounded-pill px-3">
        <i class="fa-light fa-plus me-1"></i> Add Utility
    </a>
</div>

@if (!Model.Any())
{
    <div class="glass-card text-center py-5 mb-4">
        <i class="fa-light fa-screwdriver-wrench fa-3x text-muted mb-3 d-block"></i>
        <p class="text-muted mb-3">No utility records yet.</p>
        <a asp-action="Create" asp-route-familyId="@familyId" class="btn btn-primary btn-sm rounded-pill px-3">
            <i class="fa-light fa-plus me-1"></i> Add First Record
        </a>
    </div>
}

@foreach (var u in Model)
{
    <div class="glass-card mb-4">
        <div class="card-body">
            <h5 class="card-title text-capitalize mb-3">
                <i class="fa-light fa-screwdriver-wrench me-1"></i> @u.Type
            </h5>

            <div class="row gy-2">
                <div class="col-6">
                    <small>Purchase Date</small>
                    <div>@u.PurchaseDate.ToString("dd MMMM yyyy")</div>
                </div>
                <div class="col-6">
                    <small>Amount Paid</small>
                    <div>@u.AmountPaid.ToString("C")</div>
                </div>
                <div class="col-6">
                    <small>Purchased From</small>
                    <div>@u.PurchasedFrom</div>
                </div>
                <div class="col-6">
                    <small>Account Used</small>
                    <div>@u.AccountUsed</div>
                </div>

                <div class="col-12 mt-2">
                    <small>Details</small>
                    @if (u.Type == Hearthly.Data.UtilityType.Electricity)
                    {
                        <div><strong>Token:</strong> @u.TokenNumber</div>
                        <div><strong>Units:</strong> @u.TotalUnits</div>
                    }
                    else
                    {
                        <div><strong>Liters:</strong> @u.TotalUnits</div>
                    }
                </div>
            </div>

            <div class="d-flex justify-content-end mt-4">
                <a asp-action="Edit"
                   asp-route-familyId="@familyId"
                   asp-route-id="@u.Id"
                   class="btn btn-sm btn-outline-primary rounded-pill me-2">
                    <i class="fa-light fa-pen-to-square"></i> Edit
                </a>
                <form id="deleteForm-@u.Id" asp-action="Delete"
                      asp-route-familyId="@familyId"
                      asp-route-id="@u.Id"
                      method="post"
                      class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="button"
                            class="btn btn-sm btn-outline-danger rounded-pill"
                            onclick="confirmDelete('@u.Id')">
                        <i class="fa-light fa-trash"></i> Delete
                    </button>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        function confirmDelete(id) {
            Swal.fire({
                title: 'Remove this record?',
                text: "This action cannot be undone.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, delete',
                confirmButtonColor: '#dc3545',
                cancelButtonText: 'Cancel',
                reverseButtons: true
            }).then(result => {
                if (result.isConfirmed) document.getElementById('deleteForm-' + id).submit();
            });
        }
    </script>
}

<div class="mt-5 d-flex flex-column gap-3">
    <a asp-action="ElectricitySummary"
       asp-route-familyId="@familyId"
       class="btn btn-outline-secondary rounded-pill">
        <i class="fa-light fa-bolt me-1"></i> View Electricity Summary
    </a>
    <a asp-action="GasSummary"
       asp-route-familyId="@familyId"
       class="btn btn-outline-secondary rounded-pill">
        <i class="fa-light fa-fire me-1"></i> View Gas Summary
    </a>
</div>
