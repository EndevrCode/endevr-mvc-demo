@model IEnumerable<Hearthly.Data.Utility>
@using Hearthly.Data
@{
    ViewData["Title"] = "Utilities";
    var familyId = (Guid)ViewData["FamilyId"]!;

    var lastElec = Model.FirstOrDefault(u => u.Type == UtilityType.Electricity);
    var lastGas  = Model.FirstOrDefault(u => u.Type == UtilityType.Gas);
    var monthStart = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
    var spentThisMonth = Model.Where(u => u.PurchaseDate >= monthStart).Sum(u => u.AmountPaid);

    int DaysAgo(DateTime d) => (DateTime.Today - d.Date).Days;
}

<div class="mb-4 d-flex justify-content-between align-items-center">
    <h2 class="mb-0"><i class="fa-light fa-screwdriver-wrench me-2"></i>Utilities</h2>
    <a asp-action="Create"
       asp-route-familyId="@familyId"
       class="btn btn-primary btn-sm rounded-pill px-3">
        <i class="fa-light fa-plus me-1"></i> Add Utility
    </a>
</div>

@if (Model.Any())
{
    <div class="d-flex gap-2 mb-3">
        <a asp-action="ElectricitySummary" asp-route-familyId="@familyId"
           class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="fa-light fa-bolt me-1 text-warning"></i> Electricity Summary
        </a>
        <a asp-action="GasSummary" asp-route-familyId="@familyId"
           class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="fa-light fa-fire me-1 text-danger"></i> Gas Summary
        </a>
    </div>
    <div class="glass-card p-3 mb-4">
        <div class="row g-3 text-center">
            <div class="col-4">
                <div class="text-muted small">This Month</div>
                <div class="fw-bold @(spentThisMonth > 0 ? "" : "text-muted")">
                    R @spentThisMonth.ToString("N0")
                </div>
            </div>
            <div class="col-4">
                @if (lastElec != null)
                {
                    var daysElec = DaysAgo(lastElec.PurchaseDate);
                    <div class="text-muted small"><i class="fa-light fa-bolt text-warning me-1"></i>Last Elec</div>
                    <div class="fw-bold @(daysElec > 45 ? "text-danger" : daysElec > 30 ? "text-warning" : "")">
                        @(daysElec == 0 ? "Today" : $"{daysElec}d ago")
                    </div>
                }
                else
                {
                    <div class="text-muted small"><i class="fa-light fa-bolt text-warning me-1"></i>Last Elec</div>
                    <div class="text-muted">—</div>
                }
            </div>
            <div class="col-4">
                @if (lastGas != null)
                {
                    var daysGas = DaysAgo(lastGas.PurchaseDate);
                    <div class="text-muted small"><i class="fa-light fa-fire text-danger me-1"></i>Last Gas</div>
                    <div class="fw-bold @(daysGas > 60 ? "text-danger" : daysGas > 45 ? "text-warning" : "")">
                        @(daysGas == 0 ? "Today" : $"{daysGas}d ago")
                    </div>
                }
                else
                {
                    <div class="text-muted small"><i class="fa-light fa-fire text-danger me-1"></i>Last Gas</div>
                    <div class="text-muted">—</div>
                }
            </div>
        </div>
    </div>
}
else
{
    <div class="glass-card text-center py-5 mb-4">
        <i class="fa-light fa-screwdriver-wrench fa-3x text-muted mb-3 d-block"></i>
        <p class="text-muted mb-3">No utility records yet.</p>
        <a asp-action="Create" asp-route-familyId="@familyId" class="btn btn-primary btn-sm rounded-pill px-3">
            <i class="fa-light fa-plus me-1"></i> Add First Record
        </a>
    </div>
}

@foreach (var u in Model)
{
    <div class="glass-card p-4 mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="mb-0 fw-semibold text-capitalize">
                @if (u.Type == Hearthly.Data.UtilityType.Electricity)
                {
                    <i class="fa-light fa-bolt me-2 text-warning"></i>
                }
                else
                {
                    <i class="fa-light fa-fire me-2 text-danger"></i>
                }
                @u.Type
            </h5>
            <div class="d-flex gap-2">
                <a asp-action="Edit"
                   asp-route-familyId="@familyId"
                   asp-route-id="@u.Id"
                   class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                    <i class="fa-light fa-pen-to-square"></i>
                </a>
                <form id="deleteForm-@u.Id" asp-action="Delete"
                      asp-route-familyId="@familyId"
                      asp-route-id="@u.Id"
                      method="post"
                      class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="button"
                            class="btn btn-sm btn-outline-danger rounded-pill px-3"
                            onclick="confirmDelete('@u.Id')">
                        <i class="fa-light fa-trash"></i>
                    </button>
                </form>
            </div>
        </div>

        <div class="row gy-2">
            <div class="col-6">
                <div class="text-muted small">Purchase Date</div>
                <div class="fw-semibold">@u.PurchaseDate.ToString("dd MMM yyyy")</div>
            </div>
            <div class="col-6">
                <div class="text-muted small">Amount Paid</div>
                <div class="fw-semibold">R @u.AmountPaid.ToString("N2")</div>
            </div>
            <div class="col-6">
                <div class="text-muted small">Purchased From</div>
                <div>@u.PurchasedFrom</div>
            </div>
            <div class="col-6">
                <div class="text-muted small">Account Used</div>
                <div>@u.AccountUsed</div>
            </div>
            @if (u.Type == Hearthly.Data.UtilityType.Electricity)
            {
                <div class="col-6">
                    <div class="text-muted small">Token Number</div>
                    <div class="font-monospace">@u.TokenNumber</div>
                </div>
                <div class="col-6">
                    <div class="text-muted small">Units (kWh)</div>
                    <div>@u.TotalUnits</div>
                </div>
            }
            else
            {
                <div class="col-6">
                    <div class="text-muted small">Litres</div>
                    <div>@u.TotalUnits</div>
                </div>
            }
        </div>
    </div>
}

@section Scripts {
    <script>
        function confirmDelete(id) {
            Swal.fire({
                title: 'Remove this record?',
                text: "This action cannot be undone.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, delete',
                confirmButtonColor: '#dc3545',
                cancelButtonText: 'Cancel',
                reverseButtons: true
            }).then(result => {
                if (result.isConfirmed) document.getElementById('deleteForm-' + id).submit();
            });
        }
    </script>
}

