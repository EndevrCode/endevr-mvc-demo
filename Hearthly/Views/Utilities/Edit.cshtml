@model Hearthly.Data.Utility

@{
    ViewData["Title"] = "Edit Utility";
    var familyId = ViewData["FamilyId"] as Guid? ?? Model.FamilyId;
}

<div class="mb-4">
    <h2 class="mb-0"><i class="fa-light fa-pen-to-square me-2"></i>Edit Utility</h2>
</div>

<div class="glass-card p-4 mx-auto" style="max-width: 500px;">
    <form asp-action="Edit"
          asp-route-familyId="@familyId"
          asp-route-id="@Model.Id"
          method="post"
          novalidate>
        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="FamilyId" />

        <div asp-validation-summary="All" class="alert alert-danger d-none"></div>

        <div class="mb-3">
            <label asp-for="Type" class="form-label fw-semibold">Type</label>
            <select asp-for="Type" class="form-select" id="utilityTypeSelect">
                <option value="">-- Select Type --</option>
                <option value="Gas" selected="(Model.Type == Hearthly.Data.UtilityType.Gas)">Gas</option>
                <option value="Electricity" selected="(Model.Type == Hearthly.Data.UtilityType.Electricity)">Electricity</option>
            </select>
            <span asp-validation-for="Type" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="AmountPaid" class="form-label fw-semibold">Amount Paid</label>
            <input asp-for="AmountPaid" class="form-control" />
            <span asp-validation-for="AmountPaid" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="PurchasedFrom" class="form-label fw-semibold">Purchased From</label>
            <input asp-for="PurchasedFrom" class="form-control" />
            <span asp-validation-for="PurchasedFrom" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="AccountUsed" class="form-label fw-semibold">Account Used</label>
            <input asp-for="AccountUsed" class="form-control" />
            <span asp-validation-for="AccountUsed" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="PurchaseDate" class="form-label fw-semibold">Purchase Date</label>
            <input asp-for="PurchaseDate" type="date" class="form-control" />
            <span asp-validation-for="PurchaseDate" class="text-danger small"></span>
        </div>

        <div id="electricityFields" style="display:none;">
            <div class="mb-3">
                <label asp-for="TokenNumber" class="form-label fw-semibold">Token Number</label>
                <input asp-for="TokenNumber" class="form-control" />
                <span asp-validation-for="TokenNumber" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="TotalUnits" class="form-label fw-semibold">Total Units (kWh)</label>
                <input asp-for="TotalUnits" class="form-control" />
                <span asp-validation-for="TotalUnits" class="text-danger small"></span>
            </div>
        </div>

        <div id="gasFields" style="display:none;">
            <div class="mb-3">
                <label asp-for="TotalUnits" class="form-label fw-semibold">Liters Received</label>
                <input asp-for="TotalUnits" class="form-control" />
                <span asp-validation-for="TotalUnits" class="text-danger small"></span>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center">
            <a asp-action="Index" asp-route-familyId="@familyId"
               class="btn btn-outline-secondary rounded-pill px-3">Cancel</a>
            <button type="submit" class="btn btn-primary rounded-pill px-4">
                <i class="fa-light fa-floppy-disk me-1"></i> Save Changes
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const select = document.getElementById('utilityTypeSelect');
        const elec   = document.getElementById('electricityFields');
        const gas    = document.getElementById('gasFields');

        function toggleExtras() {
            elec.style.display = select.value === 'Electricity' ? 'block' : 'none';
            gas.style.display  = select.value === 'Gas'         ? 'block' : 'none';
        }

        select.addEventListener('change', toggleExtras);
        toggleExtras();
    </script>
}
