@model Hearthly.Data.Utility

@{
    ViewData["Title"] = "Utility Details";
}

<div class="mb-4">
    <h2 class="mb-0"><i class="fa-light fa-bolt me-2"></i>Utility Details</h2>
</div>

<div class="glass-card p-4 mx-auto" style="max-width: 560px;">
    <dl class="row mb-4">
        <dt class="col-sm-4">Type</dt>
        <dd class="col-sm-8">@Model.Type</dd>

        <dt class="col-sm-4">Amount Paid</dt>
        <dd class="col-sm-8">@Model.AmountPaid.ToString("C")</dd>

        @if (!string.IsNullOrWhiteSpace(Model.PurchasedFrom))
        {
            <dt class="col-sm-4">Purchased From</dt>
            <dd class="col-sm-8">@Model.PurchasedFrom</dd>
        }

        @if (!string.IsNullOrWhiteSpace(Model.AccountUsed))
        {
            <dt class="col-sm-4">Account Used</dt>
            <dd class="col-sm-8">@Model.AccountUsed</dd>
        }

        @if (Model.PurchaseDate.HasValue)
        {
            <dt class="col-sm-4">Purchase Date</dt>
            <dd class="col-sm-8">@Model.PurchaseDate.Value.ToString("dd MMMM yyyy")</dd>
        }

        @if (!string.IsNullOrWhiteSpace(Model.TokenNumber))
        {
            <dt class="col-sm-4">Token Number</dt>
            <dd class="col-sm-8">@Model.TokenNumber</dd>
        }

        @if (Model.TotalUnits.HasValue)
        {
            <dt class="col-sm-4">
                @(Model.Type == Hearthly.Data.UtilityType.Electricity ? "Total Units (kWh)" : "Liters Received")
            </dt>
            <dd class="col-sm-8">@Model.TotalUnits.Value.ToString("0.##")</dd>
        }
    </dl>

    <div class="d-flex justify-content-between align-items-center">
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3">
            <i class="bi bi-arrow-left me-1"></i> Back
        </a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary rounded-pill px-4">
            <i class="fa-light fa-pen me-1"></i> Edit
        </a>
    </div>
</div>
