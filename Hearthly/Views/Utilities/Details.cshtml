@model Hearthly.Data.Utility

@{
    ViewData["Title"] = "Utility Details";
    var isElec = Model.Type == Hearthly.Data.UtilityType.Electricity;
}

<div class="mb-4">
    <h2 class="mb-0">
        <i class="fa-light @(isElec ? "fa-bolt text-warning" : "fa-fire-flame-curved text-danger") me-2"></i>@Model.Type Details
    </h2>
</div>

<div class="glass-card p-4 mx-auto" style="max-width: 560px;">
    <div class="row gy-3 mb-4">
        <div class="col-6">
            <div class="text-muted small">Type</div>
            <div>@Model.Type</div>
        </div>
        <div class="col-6">
            <div class="text-muted small">Amount Paid</div>
            <div class="fw-semibold">R @Model.AmountPaid.ToString("N2")</div>
        </div>

        <div class="col-6">
            <div class="text-muted small">Purchase Date</div>
            <div>@Model.PurchaseDate.ToString("dd MMMM yyyy")</div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.PurchasedFrom))
        {
            <div class="col-6">
                <div class="text-muted small">Purchased From</div>
                <div>@Model.PurchasedFrom</div>
            </div>
        }

        @if (Model.TotalUnits.HasValue)
        {
            <div class="col-6">
                <div class="text-muted small">@(isElec ? "Units (kWh)" : "Litres Received")</div>
                <div>@Model.TotalUnits.Value.ToString("0.##")</div>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.AccountUsed))
        {
            <div class="col-6">
                <div class="text-muted small">Account Used</div>
                <div>@Model.AccountUsed</div>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.TokenNumber))
        {
            <div class="col-12">
                <div class="text-muted small">Token Number</div>
                <div class="font-monospace">@Model.TokenNumber</div>
            </div>
        }
    </div>

    <div class="d-flex justify-content-between align-items-center">
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
            <i class="fa-light fa-arrow-left me-1"></i> Back
        </a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary rounded-pill px-4">
            <i class="fa-light fa-pen me-1"></i> Edit
        </a>
    </div>
</div>
