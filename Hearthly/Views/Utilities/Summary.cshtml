@model List<Hearthly.Models.UtilitySummaryRow>
@{
    var type = (Hearthly.Data.UtilityType)ViewData["UtilityType"]!;
    ViewData["Title"] = $"{type} Summary";
    var familyId = (Guid)ViewData["FamilyId"]!;
}

<div class="mb-4">
    <h2 class="mb-0"><i class="fa-light fa-chart-line me-2"></i>@ViewData["Title"]</h2>
</div>

<!-- Desktop Table -->
<div class="d-none d-md-block glass-card p-3">
    <table class="table table-bordered mb-0">
        <thead>
            <tr>
                <th>Purchase Date</th>
                <th>
                    @(type == Hearthly.Data.UtilityType.Electricity
                        ? "Units Received (kWh)"
                        : "Liters Received")
                </th>
                <th>Amount Paid</th>
                <th>Purchased From</th>
                <th>Previous Purchase</th>
                <th>Days Between</th>
                <th>Average Daily Usage</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td>@r.PurchaseDate.ToString("dd MMMM yyyy")</td>
                    <td>@(r.UnitsReceived?.ToString("0.##") ?? "-")</td>
                    <td>@r.AmountPaid.ToString("C")</td>
                    <td>@r.PurchasedFrom</td>
                    <td>@(r.PreviousPurchase?.ToString("dd MMMM yyyy") ?? "-")</td>
                    <td>@(r.DaysBetween?.ToString() ?? "-")</td>
                    <td>@(r.AverageDailyUsage?.ToString("0.##") ?? "-")</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Mobile Cards -->
<div class="d-md-none">
    @foreach (var r in Model)
    {
        <div class="glass-card mb-3 p-3">
            <h5 class="mb-2">@r.PurchaseDate.ToString("dd MMMM yyyy")</h5>
            <ul class="list-unstyled mb-0">
                <li><strong>@(type == Hearthly.Data.UtilityType.Electricity ? "Units Received (kWh)" : "Liters Received"):</strong> @(r.UnitsReceived?.ToString("0.##") ?? "-")</li>
                <li><strong>Amount Paid:</strong> @r.AmountPaid.ToString("C")</li>
                <li><strong>Purchased From:</strong> @r.PurchasedFrom</li>
                <li><strong>Previous Purchase:</strong> @(r.PreviousPurchase?.ToString("dd MMMM yyyy") ?? "-")</li>
                <li><strong>Days Between:</strong> @(r.DaysBetween?.ToString() ?? "-")</li>
                <li><strong>Average Daily Usage:</strong> @(r.AverageDailyUsage?.ToString("0.##") ?? "-")</li>
            </ul>
        </div>
    }
</div>

<p class="text-center mt-4">
    <a asp-action="Index" asp-route-familyId="@familyId" class="btn btn-outline-secondary rounded-pill px-4">
        <i class="bi bi-arrow-left me-1"></i> Back to Utilities
    </a>
</p>
