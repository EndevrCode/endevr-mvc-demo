@model List<Hearthly.Models.UtilitySummaryRow>
@{
    var type = (Hearthly.Data.UtilityType)ViewData["UtilityType"]!;
    ViewData["Title"] = $"{type} Summary";
    var familyId = (Guid)ViewData["FamilyId"]!;
}

<div class="mb-4">
    <h2 class="mb-0"><i class="fa-light fa-chart-line me-2"></i>@ViewData["Title"]</h2>
</div>

<!-- Desktop Table -->
<div class="d-none d-md-block glass-card p-3">
    <table class="table table-bordered mb-0">
        <thead>
            <tr>
                <th>Purchase Date</th>
                <th>
                    @(type == Hearthly.Data.UtilityType.Electricity
                        ? "Units Received (kWh)"
                        : "Liters Received")
                </th>
                <th>Amount Paid</th>
                <th>Purchased From</th>
                <th>Previous Purchase</th>
                <th>Days Between</th>
                <th>Average Daily Usage</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td>@r.PurchaseDate.ToString("dd MMMM yyyy")</td>
                    <td>@(r.UnitsReceived?.ToString("0.##") ?? "-")</td>
                    <td>R @r.AmountPaid.ToString("N2")</td>
                    <td>@r.PurchasedFrom</td>
                    <td>@(r.PreviousPurchase?.ToString("dd MMMM yyyy") ?? "-")</td>
                    <td>@(r.DaysBetween?.ToString() ?? "-")</td>
                    <td>@(r.AverageDailyUsage?.ToString("0.##") ?? "-")</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Mobile Cards -->
<div class="d-md-none">
    @foreach (var r in Model)
    {
        <div class="glass-card mb-3 p-3">
            <div class="fw-semibold mb-2">@r.PurchaseDate.ToString("dd MMMM yyyy")</div>
            <div class="row gy-2">
                <div class="col-6">
                    <div class="text-muted small">@(type == Hearthly.Data.UtilityType.Electricity ? "Units (kWh)" : "Litres")</div>
                    <div>@(r.UnitsReceived?.ToString("0.##") ?? "-")</div>
                </div>
                <div class="col-6">
                    <div class="text-muted small">Amount Paid</div>
                    <div>R @r.AmountPaid.ToString("N2")</div>
                </div>
                <div class="col-6">
                    <div class="text-muted small">Purchased From</div>
                    <div>@(r.PurchasedFrom ?? "-")</div>
                </div>
                <div class="col-6">
                    <div class="text-muted small">Days Since Last</div>
                    <div>@(r.DaysBetween?.ToString() ?? "-")</div>
                </div>
                <div class="col-6">
                    <div class="text-muted small">Avg Daily Usage</div>
                    <div>@(r.AverageDailyUsage?.ToString("0.##") ?? "-")</div>
                </div>
            </div>
        </div>
    }
</div>

<p class="text-center mt-4">
    <a asp-action="Index" asp-route-familyId="@familyId" class="btn btn-outline-secondary rounded-pill px-4">
        <i class="fa-light fa-arrow-left me-1"></i> Back to Utilities
    </a>
</p>
