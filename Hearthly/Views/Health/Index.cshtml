@model Hearthly.Data.HealthProfile
@{
    ViewData["Title"] = "My Health Profile";
    var hasData = !string.IsNullOrWhiteSpace(Model.BloodType)
               || !string.IsNullOrWhiteSpace(Model.Allergies)
               || !string.IsNullOrWhiteSpace(Model.CurrentMedications)
               || !string.IsNullOrWhiteSpace(Model.VaccinationNotes)
               || !string.IsNullOrWhiteSpace(Model.MedicalAidName)
               || !string.IsNullOrWhiteSpace(Model.DoctorName)
               || !string.IsNullOrWhiteSpace(Model.EmergencyNotes);
}

@{
    var statusMsg = TempData["StatusMessage"] as string;
}

<div class="mb-4 d-flex justify-content-between align-items-center">
    <h2 class="mb-0"><i class="fa-light fa-heart-pulse me-2"></i>Health Profile</h2>
    <a asp-action="Edit" class="btn btn-primary btn-sm rounded-pill px-3">
        <i class="fa-light fa-pen-to-square me-1"></i> Edit
    </a>
</div>

@if (!hasData)
{
    <div class="glass-card text-center py-5 mb-4">
        <i class="fa-light fa-heart-pulse fa-3x text-muted mb-3 d-block"></i>
        <p class="text-muted mb-3">No health information added yet.</p>
        <a asp-action="Edit" class="btn btn-primary btn-sm rounded-pill px-3">
            <i class="fa-light fa-plus me-1"></i> Add Health Info
        </a>
    </div>
}
else
{
    @if (!string.IsNullOrWhiteSpace(Model.EmergencyNotes))
    {
        <div class="glass-card p-4 mb-3 border border-danger border-opacity-50">
            <h6 class="fw-semibold text-danger mb-2">
                <i class="fa-light fa-triangle-exclamation me-1"></i> Emergency Medical Notes
            </h6>
            <p class="mb-0">@Model.EmergencyNotes</p>
        </div>
    }

    <div class="glass-card p-4 mb-3">
        <h6 class="fw-semibold mb-3"><i class="fa-light fa-droplet me-2 text-danger"></i>Basic Info</h6>
        <div class="row gy-3">
            <div class="col-md-6">
                <div class="text-muted small">Blood Type</div>
                <div class="fw-semibold">@(Model.BloodType ?? "—")</div>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.Allergies))
            {
                <div class="col-12">
                    <div class="text-muted small">Allergies</div>
                    <div>@Model.Allergies</div>
                </div>
            }
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.CurrentMedications))
    {
        <div class="glass-card p-4 mb-3">
            <h6 class="fw-semibold mb-3"><i class="fa-light fa-pills me-2 text-primary"></i>Current Medications</h6>
            <div>@Model.CurrentMedications</div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.VaccinationNotes))
    {
        <div class="glass-card p-4 mb-3">
            <h6 class="fw-semibold mb-3"><i class="fa-light fa-syringe me-2 text-success"></i>Vaccinations</h6>
            <div>@Model.VaccinationNotes</div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.MedicalAidName) || !string.IsNullOrWhiteSpace(Model.MedicalAidNumber))
    {
        <div class="glass-card p-4 mb-3">
            <h6 class="fw-semibold mb-3"><i class="fa-light fa-shield-halved me-2 text-info"></i>Medical Aid</h6>
            <div class="row gy-2">
                @if (!string.IsNullOrWhiteSpace(Model.MedicalAidName))
                {
                    <div class="col-md-6">
                        <div class="text-muted small">Provider</div>
                        <div>@Model.MedicalAidName</div>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.MedicalAidNumber))
                {
                    <div class="col-md-6">
                        <div class="text-muted small">Member Number</div>
                        <div>@Model.MedicalAidNumber</div>
                    </div>
                }
            </div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.DoctorName) || !string.IsNullOrWhiteSpace(Model.DoctorPhone))
    {
        <div class="glass-card p-4 mb-3">
            <h6 class="fw-semibold mb-3"><i class="fa-light fa-user-doctor me-2"></i>Doctor / GP</h6>
            <div class="row gy-2">
                @if (!string.IsNullOrWhiteSpace(Model.DoctorName))
                {
                    <div class="col-md-6">
                        <div class="text-muted small">Name</div>
                        <div>@Model.DoctorName</div>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.DoctorPhone))
                {
                    <div class="col-md-6">
                        <div class="text-muted small">Phone</div>
                        <a href="tel:@Model.DoctorPhone" class="text-decoration-none">@Model.DoctorPhone</a>
                    </div>
                }
            </div>
        </div>
    }

    <p class="text-muted small text-end">Last updated: @Model.UpdatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</p>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            @if (!string.IsNullOrEmpty(statusMsg))
            {
                <text>Swal.fire({ titleText: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(statusMsg)), icon: 'success', toast: true, position: 'top-end', timer: 2500, showConfirmButton: false });</text>
            }
        });
    </script>
}
