@model Hearthly.Data.HealthProfile
@{
    ViewData["Title"] = "Edit Health Profile";
}

<div class="mb-4 d-flex justify-content-between align-items-center">
    <h2 class="mb-0"><i class="fa-light fa-heart-pulse me-2"></i>Edit Health Profile</h2>
</div>

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="UserId" />

    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <!-- Basic Info -->
    <div class="glass-card p-4 mb-3">
        <h6 class="fw-semibold mb-3"><i class="fa-light fa-droplet me-2 text-danger"></i>Basic Info</h6>

        <div class="mb-3">
            <label asp-for="BloodType" class="form-label fw-semibold small"></label>
            <select asp-for="BloodType" class="form-select">
                <option value="">— Unknown —</option>
                @foreach (var bt in new[] { "A+", "A-", "B+", "B-", "AB+", "AB-", "O+", "O-" })
                {
                    <option value="@bt">@bt</option>
                }
            </select>
        </div>

        <div class="mb-3">
            <label asp-for="Allergies" class="form-label fw-semibold small"></label>
            <textarea asp-for="Allergies" class="form-control" rows="3"
                      placeholder="e.g. Penicillin, Nuts, Latex — list one per line or comma-separated"></textarea>
        </div>
    </div>

    <!-- Medications -->
    <div class="glass-card p-4 mb-3">
        <h6 class="fw-semibold mb-3"><i class="fa-light fa-pills me-2 text-primary"></i>Medications</h6>
        <div class="mb-3">
            <label asp-for="CurrentMedications" class="form-label fw-semibold small"></label>
            <textarea asp-for="CurrentMedications" class="form-control" rows="3"
                      placeholder="e.g. Metformin 500mg daily, Amlodipine 5mg daily"></textarea>
        </div>
    </div>

    <!-- Vaccinations -->
    <div class="glass-card p-4 mb-3">
        <h6 class="fw-semibold mb-3"><i class="fa-light fa-syringe me-2 text-success"></i>Vaccinations</h6>
        <div class="mb-3">
            <label asp-for="VaccinationNotes" class="form-label fw-semibold small"></label>
            <textarea asp-for="VaccinationNotes" class="form-control" rows="3"
                      placeholder="e.g. COVID-19 (Jan 2022), Tetanus (Mar 2021), Flu (annual)"></textarea>
        </div>
    </div>

    <!-- Medical Aid -->
    <div class="glass-card p-4 mb-3">
        <h6 class="fw-semibold mb-3"><i class="fa-light fa-shield-halved me-2 text-info"></i>Medical Aid</h6>
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="MedicalAidName" class="form-label fw-semibold small"></label>
                <input asp-for="MedicalAidName" class="form-control" placeholder="e.g. Discovery Health" />
            </div>
            <div class="col-md-6">
                <label asp-for="MedicalAidNumber" class="form-label fw-semibold small"></label>
                <input asp-for="MedicalAidNumber" class="form-control" placeholder="Member number" />
            </div>
        </div>
    </div>

    <!-- Doctor -->
    <div class="glass-card p-4 mb-3">
        <h6 class="fw-semibold mb-3"><i class="fa-light fa-user-doctor me-2"></i>Doctor / GP</h6>
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="DoctorName" class="form-label fw-semibold small"></label>
                <input asp-for="DoctorName" class="form-control" placeholder="Dr. Jane Smith" />
            </div>
            <div class="col-md-6">
                <label asp-for="DoctorPhone" class="form-label fw-semibold small"></label>
                <input asp-for="DoctorPhone" class="form-control" type="tel" placeholder="+27 11 000 0000" />
            </div>
        </div>
    </div>

    <!-- Emergency Notes -->
    <div class="glass-card p-4 mb-4 border border-danger border-opacity-25">
        <h6 class="fw-semibold mb-3 text-danger"><i class="fa-light fa-triangle-exclamation me-2"></i>Emergency Medical Notes</h6>
        <textarea asp-for="EmergencyNotes" class="form-control" rows="3"
                  placeholder="Critical information for first responders — e.g. diabetic, pacemaker, DNR, etc."></textarea>
        <small class="text-muted">This is shown prominently on your health profile.</small>
    </div>

    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 flex-grow-1">
            <i class="fa-light fa-arrow-left me-1"></i> Cancel
        </a>
        <button type="submit" class="btn btn-primary rounded-pill px-4 flex-grow-1">
            <i class="fa-light fa-floppy-disk me-1"></i> Save
        </button>
    </div>
</form>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
