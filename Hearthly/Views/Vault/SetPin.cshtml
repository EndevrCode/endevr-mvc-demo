@{
    ViewData["Title"] = "Set or Change Vault PIN";
}

<div class="container mt-5">
    <div class="card shadow-sm p-4 rounded-4 mx-auto" style="max-width: 400px;">
        <h4 class="text-center mb-3">🔑 Set or Change Vault PIN</h4>

        <p class="text-center mb-3">
            Your Vault PIN must be <strong>4 to 6 numeric digits</strong>. Please keep it safe – if lost, you will need to contact support and provide identifying documentation.
        </p>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success text-center">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger text-center">@TempData["Error"]</div>
        }

        <form asp-action="SetPin" method="post" novalidate onsubmit="return validatePinForm();">
            @if (ViewBag.HasExistingPin == true)
            {
                <div class="form-floating mb-3">
                    <input type="password" name="oldPin" class="form-control" id="oldPin" maxlength="6">
                    <label for="oldPin">Current PIN</label>
                </div>
            }

            <div class="form-floating mb-3">
                <input type="password" name="newPin" class="form-control" id="newPin" maxlength="6">
                <label for="newPin">New PIN</label>
            </div>

            <div class="form-floating mb-3">
                <input type="password" name="confirmPin" class="form-control" id="confirmPin" maxlength="6">
                <label for="confirmPin">Confirm New PIN</label>
            </div>

            <div id="pinError" class="text-danger text-center mb-3" style="display:none;"></div>

            <button type="submit" class="btn btn-primary w-100">Save PIN</button>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function validatePinForm() {
            const newPin = document.getElementById('newPin').value.trim();
            const confirmPin = document.getElementById('confirmPin').value.trim();
            const errorDiv = document.getElementById('pinError');

            errorDiv.style.display = 'none';
            errorDiv.innerText = '';

            const pinRegex = /^\d{4,6}$/;
            if (!pinRegex.test(newPin)) {
                errorDiv.innerText = "New PIN must be 4 to 6 digits only.";
                errorDiv.style.display = 'block';
                return false;
            }

            if (newPin !== confirmPin) {
                errorDiv.innerText = "New PIN and Confirm PIN do not match.";
                errorDiv.style.display = 'block';
                return false;
            }

            return true;
        }
    </script>
}
