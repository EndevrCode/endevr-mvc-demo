@{
    ViewData["Title"] = "Vault";
}

<div class="mb-4 d-flex justify-content-between align-items-center">
    <h2 class="mb-0"><i class="fa-light fa-vault me-2"></i>Vault</h2>
    <a asp-action="SetPin" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
        <i class="fa-light fa-key me-1"></i> Change PIN
    </a>
</div>

<p class="text-muted mb-4">Your secure place for sensitive documents and information.</p>

@* ── Vault category grid ─────────────────────────────── *@
<div class="row g-3 mb-5">
    <div class="col-6 col-md-4">
        <a asp-controller="VaultPasswords" asp-action="Index" class="text-decoration-none">
            <div class="glass-card text-center p-3 h-100">
                <i class="fa-light fa-lock-keyhole fa-2x mb-2 d-block text-primary"></i>
                <div class="fw-semibold">Passwords</div>
            </div>
        </a>
    </div>
    <div class="col-6 col-md-4">
        <a asp-controller="VaultBankAccounts" asp-action="Index" class="text-decoration-none">
            <div class="glass-card text-center p-3 h-100">
                <i class="fa-light fa-building-columns fa-2x mb-2 d-block text-success"></i>
                <div class="fw-semibold">Bank Accounts</div>
            </div>
        </a>
    </div>
    <div class="col-6 col-md-4">
        <a asp-controller="VaultDocuments" asp-action="Index" class="text-decoration-none">
            <div class="glass-card text-center p-3 h-100">
                <i class="fa-light fa-file-user fa-2x mb-2 d-block text-warning"></i>
                <div class="fw-semibold">Personal Documents</div>
            </div>
        </a>
    </div>
    <div class="col-6 col-md-4">
        <a asp-controller="VaultDocuments" asp-action="Index" asp-route-filter="6" class="text-decoration-none">
            <div class="glass-card text-center p-3 h-100">
                <i class="fa-light fa-house-chimney fa-2x mb-2 d-block text-info"></i>
                <div class="fw-semibold">House Plans</div>
            </div>
        </a>
    </div>
    <div class="col-6 col-md-4">
        <a asp-controller="VaultDocuments" asp-action="Index" asp-route-filter="3" class="text-decoration-none">
            <div class="glass-card text-center p-3 h-100">
                <i class="fa-light fa-file-contract fa-2x mb-2 d-block text-danger"></i>
                <div class="fw-semibold">Legal Documents</div>
            </div>
        </a>
    </div>
    <div class="col-6 col-md-4">
        <a asp-controller="VaultDocuments" asp-action="Index" class="text-decoration-none">
            <div class="glass-card text-center p-3 h-100">
                <i class="fa-light fa-file-circle-plus fa-2x mb-2 d-block text-secondary"></i>
                <div class="fw-semibold">Other Files</div>
            </div>
        </a>
    </div>
</div>

@* ── Secure file upload ──────────────────────────────── *@
<div class="glass-card p-4 mb-4">
    <h5 class="mb-3"><i class="fa-light fa-folder-open me-2"></i>Upload a Secure File</h5>

    <div class="mb-3">
        <input type="file" id="vaultFileInput" class="form-control" />
    </div>
    <button type="button" class="btn btn-success rounded-pill px-4" onclick="promptUpload()">
        <i class="fa-light fa-shield-check me-1"></i> Encrypt &amp; Upload
    </button>

    @* Hidden upload form — PIN injected by JS just before submit *@
    <form id="uploadForm" asp-action="Upload" method="post" enctype="multipart/form-data" class="d-none">
        @Html.AntiForgeryToken()
        <input type="file" name="file" id="uploadFormFile" />
        <input type="hidden" name="pin" id="uploadPin" />
    </form>
</div>

@* ── Hidden download form (reused per file) *@
<form id="downloadForm" asp-action="Download" method="post" class="d-none">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id"  id="downloadId" />
    <input type="hidden" name="pin" id="downloadPin" />
</form>

@* ── Hidden delete form *@
<form id="deleteForm" asp-action="DeleteFile" method="post" class="d-none">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id"  id="deleteId" />
    <input type="hidden" name="pin" id="deletePin" />
</form>

@* ── Uploaded files list ─────────────────────────────── *@
@if (ViewData["UserFiles"] is List<Hearthly.Data.Vault.VaultFile> userFiles && userFiles.Any())
{
    <div class="glass-card p-4">
        <h5 class="mb-3"><i class="fa-light fa-folder-closed me-2"></i>Your Uploaded Files</h5>
        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th>File</th>
                        <th>Uploaded</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var file in userFiles)
                    {
                        <tr>
                            <td class="text-break">@file.OriginalFileName</td>
                            <td class="text-muted small">@file.UploadedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                            <td class="text-end">
                                <button type="button"
                                        class="btn btn-sm btn-outline-primary rounded-pill me-1"
                                        onclick="promptDownload('@file.Id')">
                                    <i class="fa-light fa-cloud-arrow-down"></i>
                                </button>
                                <button type="button"
                                        class="btn btn-sm btn-outline-danger rounded-pill"
                                        onclick="promptDelete('@file.Id', '@Html.Encode(file.OriginalFileName)')">
                                    <i class="fa-light fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <p class="text-muted small">No files uploaded yet.</p>
}

@if (TempData["ShowVaultPinWarning"] != null)
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            Swal.fire({
                title: "Vault PIN Set",
                icon: "info",
                html: "Your Vault PIN has been successfully set.<br><br><strong>Please keep it safe.</strong><br>If lost, you will need to contact support and provide identifying documentation to reset it.",
                confirmButtonText: "Understood"
            });
        });
    </script>
}

@section Scripts {
<script>
async function promptPin(titleText) {
    const { value: pin, isConfirmed } = await Swal.fire({
        title: titleText,
        input: 'password',
        inputLabel: 'Enter your Vault PIN',
        inputAttributes: { inputmode: 'numeric', maxlength: '6', autocomplete: 'off' },
        inputPlaceholder: '••••••',
        showCancelButton: true,
        confirmButtonText: 'Confirm',
        cancelButtonText: 'Cancel',
        inputValidator: v => !v && 'PIN is required'
    });
    if (!isConfirmed) return null;
    return pin ?? null;
}

async function promptUpload() {
    const fileInput = document.getElementById('vaultFileInput');
    if (!fileInput.files.length) {
        Swal.fire({ title: 'No file selected', text: 'Please choose a file to upload.', icon: 'warning', toast: true, position: 'top-end', timer: 2500, showConfirmButton: false });
        return;
    }
    const pin = await promptPin('Encrypt & Upload');
    if (!pin) return;

    const dt = new DataTransfer();
    dt.items.add(fileInput.files[0]);
    document.getElementById('uploadFormFile').files = dt.files;
    document.getElementById('uploadPin').value = pin;
    document.getElementById('uploadForm').submit();
}

async function promptDownload(fileId) {
    const pin = await promptPin('Download File');
    if (!pin) return;
    document.getElementById('downloadId').value  = fileId;
    document.getElementById('downloadPin').value = pin;
    document.getElementById('downloadForm').submit();
}

async function promptDelete(fileId, fileName) {
    const confirm = await Swal.fire({
        title: 'Delete file?',
        html: `<span class="text-break">${fileName}</span><br><small class="text-muted">This cannot be undone.</small>`,
        icon: 'warning',
        showCancelButton: true,
        confirmButtonText: 'Delete',
        confirmButtonColor: '#dc3545',
        cancelButtonText: 'Cancel'
    });
    if (!confirm.isConfirmed) return;

    const pin = await promptPin('Confirm with PIN');
    if (!pin) return;
    document.getElementById('deleteId').value  = fileId;
    document.getElementById('deletePin').value = pin;
    document.getElementById('deleteForm').submit();
}

@if (TempData["UploadSuccess"] != null)
{
    <text>
    document.addEventListener('DOMContentLoaded', () => Swal.fire({ title: '@Html.Raw(TempData["UploadSuccess"])', icon: 'success', toast: true, position: 'top-end', timer: 2500, showConfirmButton: false }));
    </text>
}
@if (TempData["UploadError"] != null)
{
    <text>
    document.addEventListener('DOMContentLoaded', () => Swal.fire({ title: 'Upload failed', text: '@Html.Raw(TempData["UploadError"])', icon: 'error', confirmButtonText: 'OK' }));
    </text>
}
</script>
}
