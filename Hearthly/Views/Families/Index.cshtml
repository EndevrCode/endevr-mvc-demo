@model IEnumerable<Hearthly.Data.Family>

@{
    ViewData["Title"] = "My Families";
}

<h2>@ViewData["Title"]</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-patch-plus"></i> Create New Family
    </a>
</p>

<div class="row">
    @foreach (var family in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card glass-card h-100">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">@family.Name</h5>
                    <p class="card-text mb-4">
                        Created by <strong>@family.CreatedBy.UserName</strong>
                    </p>
                    <a asp-action="Details"
                       asp-route-id="@family.Id"
                       class="btn btn-outline-primary mt-auto">
                        View Members
                    </a>
                </div>
            </div>
        </div>
    }
</div>
