@model Hearthly.Data.Family

@{
    ViewData["Title"] = "Create Family";
}

<div class="mb-4 d-flex justify-content-between align-items-center">
    <h2 class="mb-0"><i class="fa-light fa-people-group me-2"></i>Create Family</h2>
</div>

<div class="glass-card p-4" style="max-width:560px;">
    <form id="familyForm" asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="All" class="alert alert-danger"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label fw-semibold"></label>
            <input asp-for="Name" class="form-control" placeholder="e.g. The Smith Family" maxlength="200" />
            <span asp-validation-for="Name" class="text-danger small"></span>
        </div>

        <div class="d-flex justify-content-between mt-4">
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                <i class="fa-light fa-arrow-left me-1"></i> Cancel
            </a>
            <button type="submit" class="btn btn-primary rounded-pill px-4">
                <i class="fa-light fa-plus me-1"></i> Create
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('familyForm').addEventListener('submit', async function (e) {
            if (!navigator.serviceWorker || !('SyncManager' in window)) return;

            e.preventDefault();

            const form = e.target;
            const data = {
                name: form.Name.value
            };

            const db = await openDB('Hearthly', 1, {
                upgrade(db) {
                    if (!db.objectStoreNames.contains('families')) {
                        db.createObjectStore('families', { autoIncrement: true });
                    }
                }
            });

            await db.add('families', data);

            const reg = await navigator.serviceWorker.ready;
            await reg.sync.register('sync-families');

            Swal.fire({ title: 'Saved Offline', text: 'Will sync automatically when back online.', icon: 'info', timer: 2500, showConfirmButton: false });
            window.location.href = '@Url.Action("Index")';
        });

        async function openDB(name, version, { upgrade }) {
            return new Promise((resolve, reject) => {
                const req = indexedDB.open(name, version);
                req.onerror = () => reject(req.error);
                req.onupgradeneeded = () => upgrade(req.result);
                req.onsuccess = () => resolve(req.result);
            });
        }
    </script>
}
