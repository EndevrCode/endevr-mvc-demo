@model Hearthly.Data.FamilyInvite

@{
    ViewData["Title"] = "Invite to Family: " + (string)ViewData["FamilyName"];
}

<div class="mb-4">
    <h2 class="mb-0"><i class="fa-light fa-user-plus me-2"></i>@ViewData["Title"]</h2>
</div>

<div class="glass-card p-4 mx-auto" style="max-width: 500px;">
    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <form asp-action="Invite" asp-route-id="@(ViewData["FamilyId"])" method="post">
        @Html.AntiForgeryToken()

        <div class="mb-4">
            <label asp-for="InvitedEmail" class="form-label fw-semibold"></label>
            <input asp-for="InvitedEmail" class="form-control" placeholder="member@email.com" />
            <span asp-validation-for="InvitedEmail" class="text-danger small"></span>
        </div>

        <div class="d-flex justify-content-between gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                <i class="fa-light fa-arrow-left me-1"></i> Cancel
            </a>
            <button type="submit" class="btn btn-primary rounded-pill px-4">
                <i class="fa-light fa-paper-plane me-1"></i> Send Invite
            </button>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
