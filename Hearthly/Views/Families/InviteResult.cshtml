@{
    ViewData["Title"] = "Invite Generated";

    var scheme = Context.Request.Scheme;
    var host = Context.Request.Host.Value;
    var token = (Guid)ViewData["InviteToken"];
    var expires = (DateTime)ViewData["InviteExpires"];
    var acceptUrl = Url.Action(
        "Accept",
        "Families",
        new { token },
        scheme,
        host
    );
}

<div class="mb-4">
    <h2 class="mb-0"><i class="bi bi-envelope-paper me-2"></i>@ViewData["Title"]</h2>
</div>

<div class="glass-card p-3 mb-3">
    <dl class="row mb-0">
        <dt class="col-sm-3">Invite Email</dt>
        <dd class="col-sm-9"><strong>@ViewData["InviteEmail"]</strong></dd>

        <dt class="col-sm-3">Token</dt>
        <dd class="col-sm-9 text-muted small">@token</dd>

        <dt class="col-sm-3">Expires</dt>
        <dd class="col-sm-9">@expires.ToLocalTime().ToString("dd MMM yyyy HH:mm")</dd>
    </dl>
</div>

<div class="mb-4">
    <p class="text-muted">Share this link with your family member:</p>
    <div class="input-group">
        <input type="text"
               class="form-control"
               id="inviteLink"
               readonly
               value="@acceptUrl" />
        <button class="btn btn-outline-secondary"
                type="button"
                id="btnCopyInvite">
            <i class="bi bi-clipboard me-1"></i> Copy
        </button>
    </div>
</div>

<a asp-action="Index" class="btn btn-secondary">
    <i class="bi bi-arrow-left me-1"></i> Back to Families
</a>

@section Scripts {
    <script>
        document.getElementById('btnCopyInvite').addEventListener('click', async () => {
            const link = document.getElementById('inviteLink').value;
            try {
                await navigator.clipboard.writeText(link);
                Swal.fire({ title: 'Copied!', text: 'Invite link copied to clipboard.', icon: 'success', timer: 1500, showConfirmButton: false });
            } catch {
                Swal.fire({ title: 'Could not copy', text: 'Please select and copy the link manually.', icon: 'warning' });
            }
        });
    </script>
}
