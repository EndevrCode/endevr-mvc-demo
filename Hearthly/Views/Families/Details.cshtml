@model Hearthly.Data.FamilyInfo

@{
    ViewData["Title"] = Model.Family.Name;
    var isAdmin = (ViewData["IsAdmin"] as bool?) == true;

    var creatorName = Model.Family.CreatedBy?.Profile is { } p
        ? $"{p.FirstName} {p.LastName}".Trim()
        : Model.Family.CreatedBy?.UserName ?? "Unknown";
}

<div class="mb-4 d-flex justify-content-between align-items-center">
    <h2 class="mb-0">
        <i class="fa-light fa-people-roof me-2"></i>@Model.Family.Name
    </h2>
    @if (isAdmin)
    {
        <div class="dropdown">
            <button class="btn btn-outline-secondary btn-sm rounded-pill dropdown-toggle" data-bs-toggle="dropdown">
                <i class="fa-light fa-ellipsis me-1"></i> Manage
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
                <li>
                    <a class="dropdown-item" asp-action="Invite" asp-route-id="@Model.Family.Id">
                        <i class="fa-light fa-user-plus me-2"></i>Invite Member
                    </a>
                </li>
                <li>
                    <a class="dropdown-item" asp-action="Edit" asp-route-id="@Model.Family.Id">
                        <i class="fa-light fa-pen-to-square me-2"></i>Edit Family
                    </a>
                </li>
                <li><hr class="dropdown-divider" /></li>
                <li>
                    <a class="dropdown-item text-danger" href="#"
                       onclick="confirmDeleteFamily('@Url.Action("Delete","Families",new { id = Model.Family.Id })')">
                        <i class="fa-light fa-trash me-2"></i>Delete Family
                    </a>
                </li>
            </ul>
        </div>
    }
</div>

<p class="text-muted small mb-4">
    Created by <strong>@creatorName</strong> on @Model.Family.CreatedAt.ToString("dd MMMM yyyy")
</p>

@* ── Members ── *@
<h5 class="mb-3 fw-semibold"><i class="fa-light fa-people-group me-2"></i>Members</h5>
@if (Model.Members.Any())
{
    <div class="row g-3 mb-4">
        @foreach (var m in Model.Members)
        {
            var photoUrl = !string.IsNullOrEmpty(m.PhotoPath)
                ? m.PhotoPath
                : Url.Content("~/images/placeholder-user.png");

            <div class="col-12 col-md-6 col-lg-4">
                <div class="glass-card text-center p-4">
                    <a asp-controller="Profile" asp-action="Details" asp-route-id="@m.UserId"
                       class="text-decoration-none d-block">
                        <img src="@photoUrl" alt="@m.PreferredName"
                             class="rounded-circle mb-3"
                             style="width:72px;height:72px;object-fit:cover;border:2.5px solid rgba(255,255,255,.15);" />
                        <h6 class="mb-0 fw-semibold">@(m.PreferredName ?? m.Email ?? "Member")</h6>
                    </a>
                    <a asp-controller="Health" asp-action="View" asp-route-userId="@m.UserId"
                       class="btn btn-sm btn-outline-secondary rounded-pill px-3 mt-2">
                        <i class="fa-light fa-heart-pulse me-1"></i> Health
                    </a>
                    <p class="small text-muted mt-1 mb-0">@m.Role</p>

                    @if (isAdmin)
                    {
                        <div class="mt-3 d-flex flex-column gap-2">
                            <form asp-action="ChangeRole" method="post"
                                  class="d-flex align-items-center justify-content-center gap-2">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="familyId" value="@Model.Family.Id" />
                                <input type="hidden" name="userId"   value="@m.UserId" />
                                <select name="newRole" class="form-select form-select-sm w-auto">
                                    <option value="@Hearthly.Data.IdentityRoles.Admin"
                                            @(m.Role == Hearthly.Data.IdentityRoles.Admin ? "selected" : "")>Admin</option>
                                    <option value="@Hearthly.Data.IdentityRoles.Member"
                                            @(m.Role == Hearthly.Data.IdentityRoles.Member ? "selected" : "")>Member</option>
                                </select>
                                <button type="submit" class="btn btn-sm btn-outline-primary rounded-pill px-3">Save</button>
                            </form>

                            <form asp-action="RemoveMember"
                                  asp-route-id="@Model.Family.Id"
                                  asp-route-userId="@m.UserId"
                                  method="post">
                                @Html.AntiForgeryToken()
                                <button type="button"
                                        class="btn btn-sm btn-outline-danger rounded-pill w-100 leave-family-btn">
                                    <i class="fa-light fa-user-minus me-1"></i>Remove
                                </button>
                            </form>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}
else
{
    <p class="text-muted small mb-4">No members yet.</p>
}

@* ── Pets ── *@
@if (Model.Pets.Any(p => !p.IsDeceased))
{
    <h5 class="mb-3 fw-semibold"><i class="fa-light fa-paw me-2"></i>Family Pets</h5>
    <div class="row g-3 mb-4">
        @foreach (var pet in Model.Pets.Where(p => !p.IsDeceased))
        {
            var petPhoto = !string.IsNullOrEmpty(pet.PhotoPath)
                ? pet.PhotoPath
                : Url.Content("~/images/placeholder-pet.png");

            <div class="col-12 col-md-6 col-lg-4">
                <div class="glass-card text-center p-3">
                    <img src="@petPhoto" class="rounded mb-3" alt="@pet.Name"
                         style="height:160px;width:100%;object-fit:cover;border-radius:10px;" />
                    <h6 class="fw-semibold mb-2">@pet.Name</h6>
                    <a asp-controller="Pets" asp-action="Details" asp-route-id="@pet.Id"
                       class="btn btn-sm btn-outline-primary rounded-pill px-3">
                        View Details
                    </a>
                </div>
            </div>
        }
    </div>
}

<a asp-controller="Dashboard" asp-action="Index"
   class="btn btn-outline-secondary btn-sm rounded-pill">
    <i class="fa-light fa-arrow-left me-1"></i> Back to Dashboard
</a>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function () {
        @if (TempData["ErrorMessage"] is string error)
        {
            <text>
            Swal.fire({ icon: 'error', title: 'Oops!',
                text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(error)) });
            </text>
        }
        @if (TempData["StatusMessage"] is string success)
        {
            <text>
            Swal.fire({ icon: 'success', title: 'Done!',
                text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(success)) });
            </text>
        }
        @if (TempData["SweetError"] is string msg)
        {
            <text>
            Swal.fire({ icon: 'error', title: 'Oops!',
                text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(msg)) });
            </text>
        }
    });

    document.querySelectorAll('.leave-family-btn').forEach(btn => {
        btn.addEventListener('click', e => {
            e.preventDefault();
            Swal.fire({
                icon: 'warning',
                title: 'Remove member?',
                text: 'They will be removed from this family.',
                showCancelButton: true,
                confirmButtonText: 'Remove',
                confirmButtonColor: '#dc3545',
                cancelButtonText: 'Cancel'
            }).then(r => { if (r.isConfirmed) btn.closest('form').submit(); });
        });
    });

    function confirmDeleteFamily(url) {
        Swal.fire({
            icon: 'warning',
            title: 'Delete family?',
            text: 'This will permanently delete the family and all its data.',
            showCancelButton: true,
            confirmButtonText: 'Delete',
            confirmButtonColor: '#dc3545',
            cancelButtonText: 'Cancel'
        }).then(r => { if (r.isConfirmed) window.location.href = url; });
    }
</script>
}
