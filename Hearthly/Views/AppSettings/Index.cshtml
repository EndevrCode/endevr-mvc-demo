@model Hearthly.ViewModels.AppSettingsViewModel
@{
    ViewData["Title"] = "App Settings";
}

<div class="mb-4">
    <h2 class="mb-0"><i class="fa-light fa-sliders me-2"></i>App Settings</h2>
</div>


<div class="glass-card p-4">
    <form asp-action="Index" method="post">
        @Html.AntiForgeryToken()

        <h5 class="mb-3">Appearance</h5>

        <div class="mb-3">
            <label asp-for="ThemeMode" class="form-label fw-semibold">Theme</label>
            <select asp-for="ThemeMode" class="form-select">
                <option value="system">System Default</option>
                <option value="light">Light</option>
                <option value="dark">Dark</option>
            </select>
        </div>

        <div class="mb-4">
            <label asp-for="FontSize" class="form-label fw-semibold">Font Size</label>
            <select asp-for="FontSize" class="form-select">
                <option value="small">Small</option>
                <option value="medium">Medium</option>
                <option value="large">Large</option>
            </select>
        </div>

        <button type="submit" class="btn btn-success rounded-pill px-4">
            <i class="fa-light fa-floppy-disk me-1"></i> Save Settings
        </button>
    </form>
</div>

@section Scripts {
@if (TempData["Success"] != null)
{
    <script>
        document.addEventListener('DOMContentLoaded', () =>
            Swal.fire({ title: '@Html.Raw(TempData["Success"])', icon: 'success', toast: true, position: 'top-end', timer: 2500, showConfirmButton: false }));
    </script>
}
}
