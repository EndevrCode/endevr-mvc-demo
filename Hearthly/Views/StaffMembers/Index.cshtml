@model IEnumerable<Hearthly.Data.StaffMember>
@using System

@{
    ViewData["Title"] = "Staff Members";
    var lastPayments = ViewData["LastPayments"] as Dictionary<Guid, (DateTime LastDate, decimal Total)>
                       ?? new Dictionary<Guid, (DateTime, decimal)>();
}

<div class="mb-4 d-flex justify-content-between align-items-center">
    <h2 class="mb-0"><i class="fa-light fa-people-roof me-2"></i>Staff Members</h2>
    <a asp-action="Create" class="btn btn-primary btn-sm rounded-pill px-3">
        <i class="fa-light fa-circle-plus me-1"></i> Add Staff Member
    </a>
</div>

@if (!Model.Any())
{
    <div class="glass-card text-center py-5">
        <i class="fa-light fa-person-walking-dashed-line-arrow-right fa-3x text-muted mb-3 d-block"></i>
        <p class="text-muted mb-2">No staff members added yet.</p>
        <a asp-action="Create" class="btn btn-primary btn-sm rounded-pill px-3">
            <i class="fa-light fa-circle-plus me-1"></i> Add Staff Member
        </a>
    </div>
}
else
{
    <div class="row">
        @foreach (var staff in Model)
        {
            var displayName = !string.IsNullOrWhiteSpace(staff.PreferredName)
            ? staff.PreferredName
            : $"{staff.FirstName} {staff.LastName}";
            <div class="col-6 col-sm-4 col-md-3 mb-4">
                <a asp-action="Details" asp-route-id="@staff.Id"
                   class="glass-card text-center p-3 h-100 text-decoration-none d-flex flex-column align-items-center justify-content-center">
                    @if (!string.IsNullOrEmpty(staff.PhotoPath))
                    {
                        <img src="@staff.PhotoPath"
                             alt="@displayName"
                             class="rounded-circle mb-2"
                             style="width:100px; height:100px; object-fit:cover;" />
                    }
                    else
                    {
                        <div class="rounded-circle d-flex align-items-center justify-content-center mb-2"
                             style="width:100px; height:100px; background:rgba(255,255,255,.08);">
                            <i class="fa-light fa-user fa-2x text-muted"></i>
                        </div>
                    }
                    <h6 class="fw-semibold mb-1">@displayName</h6>
                    @if (lastPayments.TryGetValue(staff.Id, out var pay))
                    {
                        <small class="text-muted" style="font-size:0.7rem;">
                            <i class="fa-light fa-money-bill-wave me-1"></i>@pay.LastDate.ToString("dd MMM yyyy")
                        </small>
                    }
                    else
                    {
                        <small class="text-muted" style="font-size:0.7rem;">No payments yet</small>
                    }
                </a>
            </div>
        }
    </div>
}
