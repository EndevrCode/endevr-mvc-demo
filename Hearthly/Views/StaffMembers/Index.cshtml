@model IEnumerable<Hearthly.Data.StaffMember>

@{
    ViewData["Title"] = "Staff Members";
}

<h2>@ViewData["Title"]</h2>

<p>
    <a asp-action="Create" class="btn btn-success">
        <i class="bi bi-patch-plus"></i> Add Staff Member
    </a>
</p>

@if (!Model.Any())
{
    <div class="alert alert-info">
        There are no staff members yet.
    </div>
}
else
{
    <div class="row">
        @foreach (var staff in Model)
        {
            var displayName = !string.IsNullOrWhiteSpace(staff.PreferredName)
            ? staff.PreferredName
            : $"{staff.FirstName} {staff.LastName}";
            <div class="col-6 col-sm-4 col-md-3 mb-4">
                <a asp-action="Details" asp-route-id="@staff.Id"
                   class="card glass-card text-center h-100 text-decoration-none text-dark">
                    <div class="card-body d-flex flex-column align-items-center justify-content-center">
                        @if (!string.IsNullOrEmpty(staff.PhotoPath))
                        {
                            <img src="@staff.PhotoPath"
                                 alt="@displayName"
                                 class="rounded-circle mb-2"
                                 style="width:100px; height:100px; object-fit:cover;" />
                        }
                        else
                        {
                            <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center mb-2"
                                 style="width:100px; height:100px; font-size:2rem;">
                                @displayName.Substring(0, 1).ToUpper()
                            </div>
                        }
                        <h5 class="card-title mb-0">@displayName</h5>
                    </div>
                </a>
            </div>
        }
    </div>
}
