@model Hearthly.Data.StaffMember
@using System
@using System.Linq
@using System.Security.Claims

@{
    ViewData["Title"] = $"{Model.FirstName} {Model.LastName}";

    var today = DateTime.Today;
    var daysInMonth = DateTime.DaysInMonth(today.Year, today.Month);
    var workDays = (Model.WorkDays ?? "")
                   .Split(',', StringSplitOptions.RemoveEmptyEntries)
                   .Select(d => d.Trim())
                   .ToHashSet(StringComparer.OrdinalIgnoreCase);

    int daysThisMonth = Enumerable
        .Range(1, daysInMonth)
        .Select(d => new DateTime(today.Year, today.Month, d).DayOfWeek.ToString())
        .Count(dow => workDays.Contains(dow));

    decimal daily = Model.DailyWageZAR ?? 0m;
    decimal totalMonthly = daily * daysThisMonth;
}

@{
    var statusMsg = TempData["StatusMessage"] as string;
    var paidThisMonth = (decimal)(ViewData["PaidThisMonth"] ?? 0m);
    var outstanding = Math.Max(0m, totalMonthly - paidThisMonth);
}

<div class="text-center mt-5 mb-4">
    @if (!string.IsNullOrEmpty(Model.PhotoPath))
    {
        <a href="#" data-bs-toggle="modal" data-bs-target="#photoModal">
            <img src="@Url.Content(Model.PhotoPath)"
                 alt="@Model.FirstName"
                 class="rounded-circle shadow"
                 style="width:130px; height:130px; object-fit:cover; cursor:pointer;" />
        </a>
    }
    else
    {
        <div class="rounded-circle d-flex align-items-center justify-content-center mx-auto"
             style="width:130px;height:130px;background:rgba(255,255,255,.08);font-size:2.5rem;color:rgba(255,255,255,.5);">
            @Model.FirstName.Substring(0, 1).ToUpper()
        </div>
    }

    <h2 class="mt-3">@Model.FirstName @Model.LastName</h2>
    <small>Staff Member</small>
</div>

<div class="glass-card p-4 mb-4">
    <div class="row gy-3">
        <div class="col-12 col-md-6">
            <div class="text-muted small">Preferred Name</div>
            <div>@(Model.PreferredName ?? "-")</div>
        </div>
        <div class="col-12 col-md-6">
            <div class="text-muted small">Contact Number</div>
            <div>@(Model.ContactNumber ?? "-")</div>
        </div>
        <div class="col-12 col-md-6">
            <div class="text-muted small">Nationality</div>
            <div>@(Model.Nationality ?? "-")</div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.IdNumber))
        {
            <div class="col-12 col-md-6">
                <div class="text-muted small">ID Number</div>
                <div>@Model.IdNumber</div>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.PassportNumber))
        {
            <div class="col-12 col-md-6">
                <div class="text-muted small">Passport Number</div>
                <div>@Model.PassportNumber</div>
            </div>
        }

        @if (Model.BirthDate.HasValue)
        {
            <div class="col-12 col-md-6">
                <div class="text-muted small">Birth Date</div>
                <div>@Model.BirthDate.Value.ToString("dd MMMM yyyy")</div>
            </div>
        }

        <div class="col-12 col-md-6">
            <div class="text-muted small">Work Days</div>
            <div>@(Model.WorkDays ?? "-")</div>
        </div>

        <div class="col-12 col-md-6">
            <div class="text-muted small">Daily Wage (ZAR)</div>
            <div class="fw-semibold">R @daily.ToString("N2")</div>
        </div>

        <div class="col-12 col-md-6">
            <div class="text-muted small">Days This Month</div>
            <div>@daysThisMonth days</div>
        </div>

        <div class="col-12 col-md-6">
            <div class="text-muted small">Est. Monthly Salary</div>
            <div class="fw-semibold text-success">R @totalMonthly.ToString("N2")</div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Address))
        {
            <div class="col-12">
                <div class="text-muted small">Address</div>
                <div>@Model.Address</div>
                <div class="text-center mt-3">
                    <div class="rounded-circle overflow-hidden mx-auto"
                         style="width: 280px; height: 280px; border: 3px solid #ccc;">
                        <iframe src="https://www.google.com/maps?q=@System.Net.WebUtility.UrlEncode(Model.Address)&output=embed"
                                width="280"
                                height="280"
                                frameborder="0"
                                style="border:0;"
                                allowfullscreen
                                loading="lazy"
                                referrerpolicy="no-referrer-when-downgrade">
                        </iframe>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- This month payment summary -->
@if (daily > 0)
{
    <div class="glass-card p-4 mb-4">
        <h6 class="fw-semibold mb-3">
            <i class="fa-light fa-calendar-check me-2"></i>@DateTime.Today.ToString("MMMM yyyy")
        </h6>
        <div class="row gy-3">
            <div class="col-4 text-center">
                <div class="text-muted small">Estimated</div>
                <div class="fw-semibold">R @totalMonthly.ToString("N0")</div>
            </div>
            <div class="col-4 text-center">
                <div class="text-muted small">Paid</div>
                <div class="fw-semibold text-success">R @paidThisMonth.ToString("N0")</div>
            </div>
            <div class="col-4 text-center">
                <div class="text-muted small">Outstanding</div>
                <div class="fw-semibold @(outstanding > 0 ? "text-warning" : "text-success")">
                    R @outstanding.ToString("N0")
                </div>
            </div>
        </div>
        @if (totalMonthly > 0)
        {
            var pct = Math.Min(100, (int)Math.Round(paidThisMonth / totalMonthly * 100));
            <div class="progress mt-3" style="height:6px;">
                <div class="progress-bar bg-success" style="width:@pct%;"></div>
            </div>
            <div class="text-muted small text-end mt-1">@pct% paid</div>
        }
    </div>
}

<!-- Action buttons -->
<div class="d-flex justify-content-center flex-wrap gap-2 mb-5">
    <a asp-action="LogPayment" asp-route-id="@Model.Id" class="btn btn-success rounded-pill px-4">
        <i class="fa-light fa-money-bill-wave me-1"></i> Log Payment
    </a>
    <a asp-action="PaymentHistory" asp-route-id="@Model.Id" class="btn btn-outline-info rounded-pill px-4">
        <i class="fa-light fa-clock-rotate-left me-1"></i> Payment History
    </a>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary rounded-pill px-4">
        <i class="fa-light fa-pen-to-square me-1"></i> Edit
    </a>
    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
        <i class="fa-light fa-arrow-left me-1"></i> Back
    </a>
    <form id="deleteForm" asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline">
        @Html.AntiForgeryToken()
        <button type="button" class="btn btn-outline-danger rounded-pill px-4" onclick="confirmDelete()">
            <i class="fa-light fa-trash me-1"></i> Delete
        </button>
    </form>
</div>

@section Scripts {
    <script>
        @if (!string.IsNullOrEmpty(statusMsg))
        {
            <text>
        document.addEventListener('DOMContentLoaded', () =>
            Swal.fire({ title: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(statusMsg)), icon: 'success', toast: true, position: 'top-end', timer: 2500, showConfirmButton: false }));
            </text>
        }

        function confirmDelete() {
            Swal.fire({
                title: 'Delete Staff Member?',
                text: "This action cannot be undone.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, delete',
                confirmButtonColor: '#dc3545',
                cancelButtonText: 'Cancel',
                reverseButtons: true
            }).then(result => {
                if (result.isConfirmed) document.getElementById('deleteForm').submit();
            });
        }
    </script>
}

<!-- Photo Modal -->
<div class="modal fade" id="photoModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-transparent border-0">
            <div class="modal-body text-center p-0">
                <button type="button" class="btn-close btn-close-white position-absolute top-0 end-0 m-2"
                        data-bs-dismiss="modal" aria-label="Close"></button>
                <img src="@Url.Content(Model.PhotoPath)"
                     alt="Photo large"
                     class="img-fluid rounded" />
            </div>
        </div>
    </div>
</div>
