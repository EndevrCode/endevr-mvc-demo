@model Hearthly.Data.StaffMember
@{
    ViewData["Title"] = "Edit Staff Member";
}

<div class="mb-4">
    <h2 class="mb-0"><i class="fa-light fa-pen-to-square me-2"></i>Edit Staff Member</h2>
</div>

<div class="glass-card p-4">
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input asp-for="FamilyId" type="hidden" />

    <div asp-validation-summary="All" class="alert alert-danger"></div>

    <!-- Photo preview & upload -->
    <div class="mb-3">
        <label class="form-label">Profile Photo</label><br />
        <img id="photoPreview"
             src="@(string.IsNullOrEmpty(Model.PhotoPath) ? "/images/placeholder.png" : Model.PhotoPath)"
             alt="Preview"
             class="rounded-circle mb-2"
             style="width:100px;height:100px;object-fit:cover;" />
        <input type="file" name="photo" class="form-control" accept="image/*"
               onchange="previewImage(event)" />
    </div>

    <div class="mb-3">
        <label asp-for="FirstName" class="form-label"></label>
        <input asp-for="FirstName" class="form-control" />
        <span asp-validation-for="FirstName" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="LastName" class="form-label"></label>
        <input asp-for="LastName" class="form-control" />
        <span asp-validation-for="LastName" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="PreferredName" class="form-label"></label>
        <input asp-for="PreferredName" class="form-control" />
        <span asp-validation-for="PreferredName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ContactNumber" class="form-label"></label>
        <input asp-for="ContactNumber" class="form-control" />
        <span asp-validation-for="ContactNumber" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Nationality" class="form-label"></label>
        <select asp-for="Nationality" class="form-select" id="nationality">
            <option value="">Select Country</option>
            <option value="South Africa">South Africa</option>
            <option value="Zimbabwe">Zimbabwe</option>
            <option value="Lesotho">Lesotho</option>
            <option value="Malawi">Malawi</option>
            <option value="Other">Other</option>
        </select>
        <span asp-validation-for="Nationality" class="text-danger"></span>
    </div>

    @{
        var isSANat = string.IsNullOrEmpty(Model.Nationality) || Model.Nationality == "South Africa";
    }
    <div class="mb-3" id="idField" style="@(isSANat ? "" : "display:none;")">
        <label asp-for="IdNumber" class="form-label"></label>
        <input asp-for="IdNumber" class="form-control" />
        <span asp-validation-for="IdNumber" class="text-danger"></span>
    </div>

    <div class="mb-3" id="passportField" style="@(isSANat ? "display:none;" : "")">
        <label asp-for="PassportNumber" class="form-label"></label>
        <input asp-for="PassportNumber" class="form-control" />
        <span asp-validation-for="PassportNumber" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="BirthDate" class="form-label"></label>
        <input asp-for="BirthDate" type="date" class="form-control" />
        <span asp-validation-for="BirthDate" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="WorkDays" class="form-label">Days Available</label><br />
        @{
            var days = new[] { "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday" };
            var selected = (Model.WorkDays ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries);
        }
        @foreach (var day in days)
        {
            var isChecked = selected.Contains(day);
            <div class="form-check form-check-inline">
                <input class="form-check-input"
                       type="checkbox"
                       name="WorkDays"
                       value="@day"
                       id="day_@day"
                       @(isChecked ? "checked" : "") />
                <label class="form-check-label" for="day_@day">@day</label>
            </div>
        }
    </div>

    <div class="mb-3">
        <label asp-for="DailyWageZAR" class="form-label"></label>
        <input asp-for="DailyWageZAR"
               type="number"
               step="0.01"
               class="form-control" />
        <span asp-validation-for="DailyWageZAR" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="BankName" class="form-label"></label>
        <input asp-for="BankName" class="form-control" />
        <span asp-validation-for="BankName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="AccountName" class="form-label"></label>
        <input asp-for="AccountName" class="form-control" />
        <span asp-validation-for="AccountName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="AccountNumber" class="form-label"></label>
        <input asp-for="AccountNumber" class="form-control" />
        <span asp-validation-for="AccountNumber" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="BranchCode" class="form-label"></label>
        <input asp-for="BranchCode" class="form-control" />
        <span asp-validation-for="BranchCode" class="text-danger"></span>
    </div>

    <!-- Address with autocomplete -->
    <div class="mb-3">
        <label asp-for="Address" class="form-label"></label>
        <input asp-for="Address" id="autocomplete" class="form-control" autocomplete="off" />
        <span asp-validation-for="Address" class="text-danger"></span>
    </div>

        <div class="d-flex justify-content-between align-items-center mt-3">
            <a asp-action="Index" asp-route-familyId="@Model.FamilyId" class="btn btn-outline-secondary rounded-pill px-4">
                <i class="fa-light fa-arrow-left me-1"></i> Cancel
            </a>
            <button type="submit" class="btn btn-primary rounded-pill px-4">
                <i class="fa-light fa-floppy-disk me-1"></i> Save Changes
            </button>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        function previewImage(event) {
            var reader = new FileReader();
            reader.onload = function () {
                document.getElementById('photoPreview').src = reader.result;
            };
            reader.readAsDataURL(event.target.files[0]);
        }

        // Init Google Places
        window.initAutocomplete = function () {
            var input = document.getElementById('autocomplete');
            if (!input) return;
            new google.maps.places.Autocomplete(input, {
                types: ['address'],
                componentRestrictions: { country: 'za' }
            });
        };

        // Toggle ID vs Passport field
        function toggleIdPassport() {
            const isSA = document.getElementById('nationality').value === 'South Africa';
            document.getElementById('idField').style.display = isSA ? 'block' : 'none';
            document.getElementById('passportField').style.display = isSA ? 'none'  : 'block';
        }

        document.getElementById('nationality').addEventListener('change', toggleIdPassport);

        // On load
        toggleIdPassport();
    </script>
}
