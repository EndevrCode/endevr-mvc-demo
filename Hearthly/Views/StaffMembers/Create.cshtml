@model Hearthly.Data.StaffMember
@{
    ViewData["Title"] = "Add Staff Member";
}

<div class="mb-4 d-flex justify-content-between align-items-center">
    <h2 class="mb-0"><i class="fa-light fa-user-plus me-2"></i>Add Staff Member</h2>
</div>

<div class="glass-card p-4">
    <form id="staffForm" asp-action="Create" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input asp-for="FamilyId" type="hidden" />

        <div asp-validation-summary="All" class="alert alert-danger"></div>

        <div class="mb-3 text-center">
            <label class="form-label fw-semibold d-block">Profile Photo</label>
            <img id="photoPreview" src="/images/placeholder.png"
                 alt="Preview"
                 class="rounded-circle mb-2"
                 style="width:100px;height:100px;object-fit:cover;" />
            <input type="file" name="photo" class="form-control" accept="image/*"
                   onchange="previewImage(event)" />
        </div>

        <div class="row g-3 mb-3">
            <div class="col-6">
                <label asp-for="FirstName" class="form-label fw-semibold"></label>
                <input asp-for="FirstName" class="form-control" />
                <span asp-validation-for="FirstName" class="text-danger small"></span>
            </div>
            <div class="col-6">
                <label asp-for="LastName" class="form-label fw-semibold"></label>
                <input asp-for="LastName" class="form-control" />
                <span asp-validation-for="LastName" class="text-danger small"></span>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="PreferredName" class="form-label fw-semibold"></label>
            <input asp-for="PreferredName" class="form-control" />
            <span asp-validation-for="PreferredName" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ContactNumber" class="form-label fw-semibold"></label>
            <input asp-for="ContactNumber" class="form-control" />
            <span asp-validation-for="ContactNumber" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Nationality" class="form-label fw-semibold"></label>
            <select asp-for="Nationality" class="form-select" id="nationality">
                <option value="">Select Country</option>
                <option value="South Africa">South Africa</option>
                <option value="Zimbabwe">Zimbabwe</option>
                <option value="Lesotho">Lesotho</option>
                <option value="Malawi">Malawi</option>
                <option value="Other">Other</option>
            </select>
            <span asp-validation-for="Nationality" class="text-danger small"></span>
        </div>

        <div class="mb-3" id="idField">
            <label asp-for="IdNumber" class="form-label fw-semibold"></label>
            <input asp-for="IdNumber" class="form-control" />
            <span asp-validation-for="IdNumber" class="text-danger small"></span>
        </div>

        <div class="mb-3" id="passportField" style="display:none;">
            <label asp-for="PassportNumber" class="form-label fw-semibold"></label>
            <input asp-for="PassportNumber" class="form-control" />
            <span asp-validation-for="PassportNumber" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="BirthDate" class="form-label fw-semibold"></label>
            <input asp-for="BirthDate" type="date" class="form-control" />
            <span asp-validation-for="BirthDate" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">Days Available</label><br />
            @{
                var days = new[] { "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday" };
            }
            @foreach (var day in days)
            {
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="checkbox" name="WorkDays" value="@day" id="day_@day" />
                    <label class="form-check-label" for="day_@day">@day</label>
                </div>
            }
        </div>

        <div class="mb-3">
            <label asp-for="DailyWageZAR" class="form-label fw-semibold"></label>
            <input asp-for="DailyWageZAR" type="number" step="0.01" class="form-control" />
            <span asp-validation-for="DailyWageZAR" class="text-danger small"></span>
        </div>

        <hr class="my-3" />
        <h6 class="text-muted mb-3">Banking Details</h6>

        <div class="row g-3 mb-3">
            <div class="col-6">
                <label asp-for="BankName" class="form-label fw-semibold"></label>
                <input asp-for="BankName" class="form-control" />
                <span asp-validation-for="BankName" class="text-danger small"></span>
            </div>
            <div class="col-6">
                <label asp-for="AccountName" class="form-label fw-semibold"></label>
                <input asp-for="AccountName" class="form-control" />
                <span asp-validation-for="AccountName" class="text-danger small"></span>
            </div>
            <div class="col-6">
                <label asp-for="AccountNumber" class="form-label fw-semibold"></label>
                <input asp-for="AccountNumber" class="form-control" />
                <span asp-validation-for="AccountNumber" class="text-danger small"></span>
            </div>
            <div class="col-6">
                <label asp-for="BranchCode" class="form-label fw-semibold"></label>
                <input asp-for="BranchCode" class="form-control" />
                <span asp-validation-for="BranchCode" class="text-danger small"></span>
            </div>
        </div>

        <div class="mb-4">
            <label asp-for="Address" class="form-label fw-semibold"></label>
            <input asp-for="Address" id="autocomplete" class="form-control" autocomplete="off" />
            <span asp-validation-for="Address" class="text-danger small"></span>
        </div>

        <div class="d-flex justify-content-between">
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                <i class="fa-light fa-arrow-left me-1"></i> Cancel
            </a>
            <button type="submit" class="btn btn-success rounded-pill px-4">
                <i class="fa-light fa-user-plus me-1"></i> Add Staff
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="/js/background-sync.js"></script>
    <script>
        function previewImage(event) {
            const reader = new FileReader();
            reader.onload = function () {
                document.getElementById('photoPreview').src = reader.result;
            };
            reader.readAsDataURL(event.target.files[0]);
        }

        window.initAutocomplete = function () {
            const input = document.getElementById('autocomplete');
            if (!input) return;
            new google.maps.places.Autocomplete(input, {
                types: ['address'],
                componentRestrictions: { country: 'za' }
            });
        };

        document.getElementById("nationality").addEventListener("change", function () {
            const isSA = this.value === "South Africa";
            document.getElementById("idField").style.display = isSA ? "block" : "none";
            document.getElementById("passportField").style.display = isSA ? "none" : "block";
        });

        document.getElementById("staffForm").addEventListener("submit", async function (e) {
            if (!navigator.onLine) {
                e.preventDefault();

                const form = e.target;
                const formData = new FormData(form);
                const plain = {};
                formData.forEach((v, k) => {
                    if (plain[k]) {
                        if (!Array.isArray(plain[k])) plain[k] = [plain[k]];
                        plain[k].push(v);
                    } else {
                        plain[k] = v;
                    }
                });

                const db = await getDb();
                const tx = db.transaction('staffQueue', 'readwrite');
                await tx.objectStore('staffQueue').add(plain);
                await tx.done;

                if ('serviceWorker' in navigator && 'SyncManager' in window) {
                    const reg = await navigator.serviceWorker.ready;
                    await reg.sync.register('sync-staff');
                }

                Swal.fire({ title: "Saved Offline", text: "Will sync when back online.", icon: "info", timer: 2500, showConfirmButton: false });
                form.reset();
            }
        });
    </script>
}
