@model Hearthly.Data.StaffPayment
@using Hearthly.Data

@{
    var staffMember = ViewData["StaffMember"] as StaffMember;
    ViewData["Title"] = $"Log Payment – {staffMember?.PreferredName ?? staffMember?.FirstName}";
}

<div class="mb-4">
    <h2 class="mb-0"><i class="fa-light fa-money-bill-wave me-2"></i>Log Payment</h2>
</div>

@if (staffMember != null)
{
    <div class="glass-card p-3 mb-4 d-flex align-items-center gap-3">
        @if (!string.IsNullOrEmpty(staffMember.PhotoPath))
        {
            <img src="@Url.Content(staffMember.PhotoPath)" alt="@staffMember.FirstName"
                 class="rounded-circle" style="width:50px;height:50px;object-fit:cover;" />
        }
        else
        {
            <div class="rounded-circle d-flex align-items-center justify-content-center"
                 style="width:50px;height:50px;background:rgba(255,255,255,.08);font-size:1.3rem;color:rgba(255,255,255,.5);">
                @staffMember.FirstName.Substring(0, 1).ToUpper()
            </div>
        }
        <div>
            <div class="fw-semibold">@staffMember.FirstName @staffMember.LastName</div>
            @if (!string.IsNullOrEmpty(staffMember.PreferredName))
            {
                <div class="text-muted small">"@staffMember.PreferredName"</div>
            }
            @if (staffMember.DailyWageZAR.HasValue)
            {
                <div class="text-muted small">Daily rate: R @staffMember.DailyWageZAR.Value.ToString("N2")</div>
            }
        </div>
    </div>
}

<div class="glass-card p-4">
    <form asp-action="LogPayment" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="StaffMemberId" />

        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

        <div class="row gy-3">
            <div class="col-12 col-md-6">
                <label asp-for="AmountPaid" class="form-label text-muted small"></label>
                <div class="input-group">
                    <span class="input-group-text">R</span>
                    <input asp-for="AmountPaid" class="form-control" placeholder="0.00" step="0.01" min="0" />
                </div>
                <span asp-validation-for="AmountPaid" class="text-danger small"></span>
            </div>

            <div class="col-12 col-md-6">
                <label asp-for="PaymentDate" class="form-label text-muted small"></label>
                <input asp-for="PaymentDate" class="form-control" type="date" />
                <span asp-validation-for="PaymentDate" class="text-danger small"></span>
            </div>

            <div class="col-12 col-md-6">
                <label asp-for="PeriodStart" class="form-label text-muted small"></label>
                <input asp-for="PeriodStart" class="form-control" type="date" />
                <span asp-validation-for="PeriodStart" class="text-danger small"></span>
            </div>

            <div class="col-12 col-md-6">
                <label asp-for="PeriodEnd" class="form-label text-muted small"></label>
                <input asp-for="PeriodEnd" class="form-control" type="date" />
                <span asp-validation-for="PeriodEnd" class="text-danger small"></span>
            </div>

            <div class="col-12 col-md-6">
                <label asp-for="PaymentMethod" class="form-label text-muted small"></label>
                <select asp-for="PaymentMethod" class="form-select">
                    <option value="Cash">Cash</option>
                    <option value="Bank Transfer">Bank Transfer</option>
                    <option value="EFT">EFT</option>
                    <option value="Cheque">Cheque</option>
                    <option value="Other">Other</option>
                </select>
            </div>

            <div class="col-12">
                <label asp-for="Notes" class="form-label text-muted small"></label>
                <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Optional notes..."></textarea>
                <span asp-validation-for="Notes" class="text-danger small"></span>
            </div>
        </div>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-success rounded-pill px-4 flex-grow-1">
                <i class="fa-light fa-check me-1"></i> Save Payment
            </button>
            <a asp-action="Details" asp-route-id="@Model.StaffMemberId" asp-route-familyId="@staffMember?.FamilyId" class="btn btn-outline-secondary rounded-pill px-4 flex-grow-1">
                <i class="fa-light fa-arrow-left me-1"></i> Cancel
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
