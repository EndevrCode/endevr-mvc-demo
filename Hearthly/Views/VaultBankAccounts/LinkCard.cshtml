@model Hearthly.Models.Vault.LinkCardViewModel

@{
    ViewData["Title"] = "Link Card";
}

<div class="mb-4">
    <h2 class="mb-0"><i class="fa-light fa-credit-card me-2"></i>Link a Card</h2>
</div>

<div class="glass-card p-4 mx-auto" style="max-width: 500px;">
    <div class="mb-4">
        <div class="row g-2 text-muted small">
            <div class="col-6"><strong class="text-body">Account Holder</strong><br />@Model.AccountHolder</div>
            <div class="col-6"><strong class="text-body">Bank</strong><br />@Model.BankName</div>
            <div class="col-6"><strong class="text-body">Account Number</strong><br />••• ••• @Model.LastFourDigits</div>
        </div>
    </div>

    <form asp-action="LinkCard" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="AccountId" />

        <div class="mb-3">
            <label asp-for="CardFront" class="form-label fw-semibold">Card Front</label>
            <input asp-for="CardFront" class="form-control" type="file" accept="image/*" />
            <span asp-validation-for="CardFront" class="text-danger small"></span>
        </div>

        <div class="mb-4">
            <label asp-for="CardBack" class="form-label fw-semibold">Card Back</label>
            <input asp-for="CardBack" class="form-control" type="file" accept="image/*" />
            <span asp-validation-for="CardBack" class="text-danger small"></span>
        </div>

        <div class="d-flex justify-content-between gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                <i class="fa-light fa-arrow-left me-1"></i> Cancel
            </a>
            <button type="submit" class="btn btn-primary rounded-pill px-4 flex-grow-1">
                <i class="fa-light fa-link me-1"></i> Link Card
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
