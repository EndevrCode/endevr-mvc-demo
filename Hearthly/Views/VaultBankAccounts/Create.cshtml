@model Hearthly.Data.Vault.VaultBankAccount
@{
    ViewData["Title"] = "Add Bank Account";
}

<div class="mb-4">
    <h2 class="mb-0"><i class="fa-light fa-building-columns me-2"></i>Add Bank Account</h2>
</div>

<div class="glass-card p-4 mx-auto" style="max-width: 600px;">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label asp-for="AccountHolder" class="form-label"></label>
            <input asp-for="AccountHolder" class="form-control" />
            <span asp-validation-for="AccountHolder" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="BankName" class="form-label"></label>
            <select asp-for="BankName" class="form-select"
                    asp-items="Html.GetEnumSelectList<Hearthly.Data.Vault.BankName>()"></select>
            <span asp-validation-for="BankName" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="AccountType" class="form-label"></label>
            <select asp-for="AccountType" class="form-select"
                    asp-items="Html.GetEnumSelectList<Hearthly.Data.Vault.AccountType>()"></select>
            <span asp-validation-for="AccountType" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="AccountNumber" class="form-label"></label>
            <input asp-for="AccountNumber" class="form-control" />
            <span asp-validation-for="AccountNumber" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="BranchCode" class="form-label"></label>
            <input asp-for="BranchCode" class="form-control" placeholder="Optional" />
            <span asp-validation-for="BranchCode" class="text-danger small"></span>
        </div>

        <div class="form-check mb-4">
            <input type="hidden" name="IsMine" value="false" />
            <input type="checkbox" name="IsMine" value="true" class="form-check-input" id="isMineCheckbox" />
            <label class="form-check-label" for="isMineCheckbox">This is my account</label>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-grow-1">
                <i class="fa-light fa-floppy-disk me-1"></i> Save Account
            </button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
