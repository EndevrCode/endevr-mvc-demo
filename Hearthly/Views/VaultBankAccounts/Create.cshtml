@model Hearthly.Data.Vault.VaultBankAccount
@{
    ViewData["Title"] = "Add Bank Account";
}

<div class="container mt-4">
    <div class="card shadow-sm p-4 rounded-4 mx-auto" style="max-width: 600px;">
        <h4 class="text-center mb-4">🏦 Add a Bank Account</h4>

        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label asp-for="AccountHolder" class="form-label"></label>
                <input asp-for="AccountHolder" class="form-control" />
                <span asp-validation-for="AccountHolder" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="BankName" class="form-label"></label>
                <select asp-for="BankName" class="form-select"
                        asp-items="Html.GetEnumSelectList<Hearthly.Data.Vault.BankName>()"></select>
                <span asp-validation-for="BankName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="AccountType" class="form-label"></label>
                <select asp-for="AccountType" class="form-select"
                        asp-items="Html.GetEnumSelectList<Hearthly.Data.Vault.AccountType>()"></select>
                <span asp-validation-for="AccountType" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="AccountNumber" class="form-label"></label>
                <input asp-for="AccountNumber" class="form-control" />
                <span asp-validation-for="AccountNumber" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="BranchCode" class="form-label"></label>
                <input asp-for="BranchCode" class="form-control" placeholder="Optional" />
                <span asp-validation-for="BranchCode" class="text-danger"></span>
            </div>

            <div class="form-check mb-3">
                <input type="hidden" name="IsMine" value="false" />
                <input type="checkbox" name="IsMine" value="true" class="form-check-input" id="isMineCheckbox" />
                <label class="form-check-label" for="isMineCheckbox"> This is my card </label>
            </div>

            <button type="submit" class="btn btn-primary w-100">Save Account</button>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
