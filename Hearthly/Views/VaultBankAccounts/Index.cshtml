@model IEnumerable<Hearthly.Data.Vault.VaultBankAccount>
@{
    ViewData["Title"] = "My Bank Accounts";
}

<div class="mb-4 d-flex justify-content-between align-items-center">
    <h2 class="mb-0"><i class="fa-light fa-building-columns me-2"></i>Bank Accounts</h2>
    <a class="btn btn-primary btn-sm rounded-pill px-3" asp-action="Create">
        <i class="fa-light fa-plus me-1"></i> Add Account
    </a>
</div>

@if (TempData["Success"] is string ok)
{
    <div class="alert alert-success">@ok</div>
}
@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger">@err</div>
}

@if (!Model.Any())
{
    <div class="glass-card text-center py-4">
        <p class="text-muted mb-2">No bank accounts added yet.</p>
        <a asp-action="Create" class="btn btn-primary btn-sm rounded-pill px-3">
            <i class="fa-light fa-plus me-1"></i> Add Your First Account
        </a>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var account in Model)
        {
            <div class="col-md-6">
                <div class="glass-card p-3">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <h6 class="mb-0 fw-semibold">@account.AccountHolder</h6>
                            <small class="text-muted">@account.BankName · @account.AccountType</small>
                        </div>
                        <span class="badge bg-secondary">**** @ViewData[$"Last4_{account.Id}"]</span>
                    </div>

                    <div class="d-flex gap-2 mt-3">
                        <button class="btn btn-sm btn-outline-primary flex-grow-1"
                                onclick="promptBankAccountPin('@account.AccountHolder', '@account.AccountNumber')">
                            <i class="fa-light fa-eye me-1"></i> View
                        </button>

                        @if (string.IsNullOrEmpty(account.CardFrontPath) && string.IsNullOrEmpty(account.CardBackPath))
                        {
                            <a asp-action="LinkCard" asp-route-id="@account.Id"
                               class="btn btn-sm btn-outline-secondary flex-grow-1">
                                <i class="fa-light fa-credit-card me-1"></i> Link Card
                            </a>
                        }
                        else
                        {
                            <button type="button"
                                    class="btn btn-sm btn-outline-success flex-grow-1"
                                    onclick="promptCardPin('@account.CardFrontPath', '@account.CardBackPath', @account.Id)">
                                <i class="fa-light fa-check me-1"></i> Card Linked
                            </button>
                        }

                        <form id="deleteForm-@account.Id" asp-action="Delete" asp-route-id="@account.Id" method="post">
                            @Html.AntiForgeryToken()
                            <button type="button" class="btn btn-sm btn-outline-danger"
                                    onclick="confirmDelete('@account.Id')">
                                <i class="fa-light fa-trash"></i>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}

<!-- Bank Account Details Modal -->
<div class="modal fade" id="bankDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content glass-card">
            <div class="modal-header">
                <h5 class="modal-title mx-auto fw-bold">
                    <i class="fa-light fa-building-columns me-2"></i>Account Details
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center">
                <p><strong>Account Holder:</strong> <span id="modalHolder" class="text-info"></span></p>
                <p>
                    <strong>Account Number:</strong>
                    <span id="modalAccount">••••••••</span>
                    <button id="toggleAccountBtn" type="button" class="btn btn-sm btn-outline-secondary ms-2">
                        <i class="fa-light fa-eye"></i>
                    </button>
                </p>
            </div>
        </div>
    </div>
</div>

<!-- Vault PIN Prompt Modal -->
<div class="modal fade" id="vaultPinModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content glass-card">
            <div class="modal-header">
                <h5 class="modal-title mx-auto fw-bold">Enter your Vault PIN</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center">
                <input id="vaultPinInput" type="password" class="form-control mb-3 text-center" maxlength="6" placeholder="••••••" />
                <button class="btn btn-primary rounded-pill w-100 mb-2" onclick="confirmPin()">Unlock</button>
                <button class="btn btn-secondary w-100" data-bs-dismiss="modal">Cancel</button>
            </div>
        </div>
    </div>
</div>

<!-- Linked Card Modal -->
<div class="modal fade" id="linkedCardModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content glass-card">
            <div class="modal-header">
                <h5 class="modal-title mx-auto fw-bold">
                    <i class="fa-light fa-credit-card me-2"></i>Linked Card Images
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center">
                <div id="linkedCardImages" class="d-flex justify-content-center gap-3 flex-wrap"></div>
            </div>
            <div class="modal-footer justify-content-center">
                <button class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                <button id="removeCardBtn" class="btn btn-outline-danger" onclick="confirmUnlink()">
                    <i class="fa-light fa-trash me-1"></i> Remove Linked Card
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        window.accountHolderToReveal = '';
        window.accountNumberToReveal = '';
        window.accountShown = false;
        window.cardFrontToShow = null;
        window.cardBackToShow = null;
        window.cardAccountId = null;

        function promptBankAccountPin(holder, number) {
            window.accountHolderToReveal = holder;
            window.accountNumberToReveal = number;
            window.cardFrontToShow = null;
            window.cardBackToShow = null;
            window.accountShown = false;

            document.getElementById('vaultPinInput').value = '';
            document.getElementById('modalAccount').textContent = '••••••••';
            document.getElementById('toggleAccountBtn').innerHTML = '<i class="fa-light fa-eye"></i>';
            new bootstrap.Modal(document.getElementById('vaultPinModal')).show();
        }

        function promptCardPin(frontPath, backPath, accountId) {
            window.cardFrontToShow = frontPath;
            window.cardBackToShow = backPath;
            window.cardAccountId = accountId;

            document.getElementById('vaultPinInput').value = '';
            new bootstrap.Modal(document.getElementById('vaultPinModal')).show();
        }

        function confirmPin() {
            const pin = document.getElementById('vaultPinInput').value;
            if (!pin) return;

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || "";

            fetch('/Vault/ValidatePinAjax', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                body: JSON.stringify({ pin })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    bootstrap.Modal.getInstance(document.getElementById('vaultPinModal')).hide();

                    if (window.cardFrontToShow || window.cardBackToShow) {
                        showLinkedCardModal();
                    } else {
                        document.getElementById('modalHolder').textContent = window.accountHolderToReveal;
                        document.getElementById('modalAccount').textContent = '••••••••';
                        window.accountShown = false;
                        new bootstrap.Modal(document.getElementById('bankDetailsModal')).show();
                    }
                } else {
                    Swal.fire({ title: 'Incorrect PIN', icon: 'error', confirmButtonText: 'Try again' });
                }
            })
            .catch(() => Swal.fire({ title: 'Error', text: 'Could not validate PIN.', icon: 'error' }));
        }

        function showLinkedCardModal() {
            const container = document.getElementById('linkedCardImages');
            container.innerHTML = '';

            if (window.cardFrontToShow) {
                const img = document.createElement('img');
                img.src = `/VaultBankAccounts/GetCardImage/${window.cardAccountId}?side=front`;
                img.className = 'img-thumbnail';
                img.style.maxHeight = '120px';
                img.alt = 'Card Front';
                container.appendChild(img);
            }

            if (window.cardBackToShow) {
                const img = document.createElement('img');
                img.src = `/VaultBankAccounts/GetCardImage/${window.cardAccountId}?side=back`;
                img.className = 'img-thumbnail';
                img.style.maxHeight = '120px';
                img.alt = 'Card Back';
                container.appendChild(img);
            }

            new bootstrap.Modal(document.getElementById('linkedCardModal')).show();
        }

        function confirmUnlink() {
            Swal.fire({
                title: 'Remove Linked Card?',
                text: "This will permanently unlink the card images from this account.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, remove it',
                cancelButtonText: 'Cancel',
                reverseButtons: true
            }).then(result => {
                if (result.isConfirmed)
                    window.location.href = `/VaultBankAccounts/UnlinkCard/${window.cardAccountId}`;
            });
        }

        function confirmDelete(accountId) {
            Swal.fire({
                title: 'Delete Account?',
                text: "This action cannot be undone.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, delete it',
                cancelButtonText: 'Cancel',
                reverseButtons: true
            }).then(result => {
                if (result.isConfirmed)
                    document.getElementById('deleteForm-' + accountId).submit();
            });
        }

        document.addEventListener("DOMContentLoaded", () => {
            document.getElementById('toggleAccountBtn')?.addEventListener('click', () => {
                window.accountShown = !window.accountShown;
                document.getElementById('modalAccount').textContent =
                    window.accountShown ? window.accountNumberToReveal : '••••••••';
                document.getElementById('toggleAccountBtn').innerHTML =
                    window.accountShown ? '<i class="fa-light fa-eye-slash"></i>' : '<i class="fa-light fa-eye"></i>';
            });

            document.getElementById('vaultPinInput')?.addEventListener('keydown', e => {
                if (e.key === 'Enter') confirmPin();
            });
        });
    </script>
}
