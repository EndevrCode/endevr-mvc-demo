@model IEnumerable<Hearthly.Data.Vault.VaultBankAccount>
@{
    ViewData["Title"] = "My Bank Accounts";
}

<div class="container mt-4">
    <div class="position-relative mb-4">
        <!-- Add Button (top-right) -->
        <div class="position-absolute top-0 end-0">
            <a class="btn btn-success" asp-action="Create">➕ Add New</a>
        </div>

        <!-- Spacer for settings icon overlap -->
        <div style="height: 2rem;"></div>

        <!-- Title centered and pushed down -->
        <h4 class="text-center fw-bold mt-4">🏦 My Bank Accounts</h4>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">
            You haven't added any bank accounts yet.
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var account in Model)
            {
                <div class="col-md-6">
                    <div class="card shadow-sm rounded-4 p-3">
                        <h6 class="mb-2">
                            <strong>@account.AccountHolder</strong>
                        </h6>
                        <p class="mb-1">
                            Ending in **** @ViewData[$"Last4_{account.Id}"]
                        </p>

                        <div class="d-flex justify-content-center gap-2 mt-2">
                            <button class="btn btn-sm btn-outline-primary"
                                    onclick="promptBankAccountPin('@account.AccountHolder', '@account.AccountNumber')">
                                🔍 View
                            </button>

                            @if (string.IsNullOrEmpty(account.CardFrontPath) && string.IsNullOrEmpty(account.CardBackPath))
                            {
                                <a asp-action="LinkCard"
                                   asp-route-id="@account.Id"
                                   class="btn btn-sm btn-outline-secondary">
                                    💳 Link Card
                                </a>
                            }
                            else
                            {
                                <button type="button"
                                        class="btn btn-sm btn-success"
                                        onclick="promptCardPin('@account.CardFrontPath', '@account.CardBackPath', @account.Id)">
                                    ✅ Card Linked
                                </button>
                            }

                            <form id="deleteForm-@account.Id" asp-action="Delete" asp-route-id="@account.Id" method="post">
                                @Html.AntiForgeryToken()
                                <button type="button" class="btn btn-sm btn-outline-danger"
                                        onclick="confirmDelete('@account.Id')">
                                    🗑️
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<div class="text-center mt-5 mb-4">
    <a class="btn btn-outline-light rounded-pill px-4 py-2" href="javascript:history.back()">
        ← Back
    </a>
</div>

<!-- Bank Account Details Modal -->
<div class="modal fade" id="bankDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content glass-card">
            <div class="modal-header">
                <h5 class="modal-title mx-auto fw-bold">🏦 Account Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center">
                <p><strong>Account Holder:</strong> <span id="modalHolder" class="text-info"></span></p>
                <p>
                    <strong>Account Number:</strong>
                    <span id="modalAccount">••••••••</span>
                    <button id="toggleAccountBtn" type="button" class="btn btn-sm btn-outline-secondary ms-2">
                        <i class="bi bi-eye"></i>
                    </button>
                </p>
            </div>
        </div>
    </div>
</div>

<!-- Vault PIN Prompt Modal -->
<div class="modal fade" id="vaultPinModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content glass-card">
            <div class="modal-header">
                <h5 class="modal-title mx-auto fw-bold">Enter your Vault PIN</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center">
                <input id="vaultPinInput" type="password" class="form-control mb-3 text-center" maxlength="6" />
                <button class="btn btn-primary w-100 mb-2" onclick="confirmPin()">Unlock</button>
                <button class="btn btn-secondary w-100" data-bs-dismiss="modal">Cancel</button>
            </div>
        </div>
    </div>
</div>

<!-- Linked Card Modal -->
<div class="modal fade" id="linkedCardModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content glass-card">
            <div class="modal-header">
                <h5 class="modal-title mx-auto fw-bold">💳 Linked Card Images</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center">
                <div id="linkedCardImages" class="d-flex justify-content-center gap-3 flex-wrap">
                    <!-- Images injected here -->
                </div>
            </div>
            <div class="modal-footer justify-content-center">
                <button class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                <button id="removeCardBtn" class="btn btn-outline-danger" onclick="confirmUnlink()">🗑️ Remove Linked Card</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Global state
        window.accountHolderToReveal = '';
        window.accountNumberToReveal = '';
        window.accountShown = false;
        window.cardFrontToShow = null;
        window.cardBackToShow = null;
        window.cardAccountId = null;

        function promptBankAccountPin(holder, number) {
            window.accountHolderToReveal = holder;
            window.accountNumberToReveal = number;
            window.accountShown = false;

            waitForModalElements(() => {
                document.getElementById('vaultPinInput').value = '';
                document.getElementById('modalAccount').textContent = '••••••••';
                document.getElementById('toggleAccountBtn').innerHTML = '<i class="bi bi-eye"></i>';
                new bootstrap.Modal(document.getElementById('vaultPinModal')).show();
            });
        }

        function promptCardPin(frontPath, backPath, accountId) {
            window.cardFrontToShow = frontPath;
            window.cardBackToShow = backPath;
            window.cardAccountId = accountId;

            waitForModalElements(() => {
                document.getElementById('vaultPinInput').value = '';
                document.getElementById('modalAccount').textContent = '••••••••';
                document.getElementById('toggleAccountBtn').innerHTML = '<i class="bi bi-eye"></i>';
                new bootstrap.Modal(document.getElementById('vaultPinModal')).show();
            });
        }

        function confirmPin() {
            const pin = document.getElementById('vaultPinInput').value;
            if (!pin) {
                alert("Please enter your vault PIN.");
                return;
            }

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || "";

            fetch('/Vault/ValidatePinAjax', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify({ pin })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    bootstrap.Modal.getInstance(document.getElementById('vaultPinModal')).hide();

                    if (window.cardFrontToShow || window.cardBackToShow) {
                        showLinkedCardModal();
                    } else {
                        document.getElementById('modalHolder').textContent = window.accountHolderToReveal;
                        document.getElementById('modalAccount').textContent = window.accountNumberToReveal;
                        new bootstrap.Modal(document.getElementById('bankDetailsModal')).show();
                    }
                } else {
                    alert("Incorrect PIN.");
                }
            })
            .catch(err => {
                console.error(err);
                alert("Error validating PIN.");
            });
        }

        function showLinkedCardModal() {
            const container = document.getElementById('linkedCardImages');
            container.innerHTML = '';

            if (window.cardFrontToShow) {
                const frontImg = document.createElement('img');
                frontImg.src = `/VaultBankAccounts/GetCardImage/${window.cardAccountId}?side=front`;
                frontImg.className = 'img-thumbnail';
                frontImg.style.maxHeight = '120px';
                frontImg.alt = 'Card Front';
                container.appendChild(frontImg);
            }

            if (window.cardBackToShow) {
                const backImg = document.createElement('img');
                backImg.src = `/VaultBankAccounts/GetCardImage/${window.cardAccountId}?side=back`;
                backImg.className = 'img-thumbnail';
                backImg.style.maxHeight = '120px';
                backImg.alt = 'Card Back';
                container.appendChild(backImg);
            }

            new bootstrap.Modal(document.getElementById('linkedCardModal')).show();
        }

        function confirmUnlink() {
            Swal.fire({
                title: 'Remove Linked Card?',
                text: "This will permanently unlink the card images from this account.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, remove it',
                cancelButtonText: 'Cancel',
                reverseButtons: true
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = `/VaultBankAccounts/UnlinkCard/${window.cardAccountId}`;
                }
            });
        }

        function confirmDelete(accountId) {
            Swal.fire({
                title: 'Delete Account?',
                text: "This action cannot be undone.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, delete it',
                cancelButtonText: 'Cancel',
                reverseButtons: true
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById('deleteForm-' + accountId).submit();
                }
            });
        }

        function waitForModalElements(callback) {
            const check = setInterval(() => {
                const vaultPinInput = document.getElementById('vaultPinInput');
                const modalAccount = document.getElementById('modalAccount');
                const toggleBtn = document.getElementById('toggleAccountBtn');
                if (vaultPinInput && modalAccount && toggleBtn) {
                    clearInterval(check);
                    callback();
                }
            }, 100);
        }

        document.addEventListener("DOMContentLoaded", () => {
            const toggleBtn = document.getElementById('toggleAccountBtn');
            if (toggleBtn) {
                toggleBtn.addEventListener('click', () => {
                    window.accountShown = !window.accountShown;
                    const accElem = document.getElementById('modalAccount');
                    const btn = document.getElementById('toggleAccountBtn');

                    accElem.textContent = window.accountShown ? window.accountNumberToReveal : '••••••••';
                    btn.innerHTML = window.accountShown
                        ? '<i class="bi bi-eye-slash"></i>'
                        : '<i class="bi bi-eye"></i>';
                });
            }
        });
    </script>
}
