@model Hearthly.Data.Vault.VaultPassword

@{
    ViewData["Title"] = "Password Details";
}

<!-- Anti-forgery token needed for JS fetch -->
<form id="antiForgeryForm">
    @Html.AntiForgeryToken()
</form>

<div class="container mt-4">
    <div class="card shadow-sm p-4 rounded-4 mx-auto" style="max-width: 600px;">
        <h4 class="mb-3 text-center">🔐 Password Details</h4>

        <div class="mb-3">
            <label class="form-label fw-bold">Password Type</label>
            <div class="form-control bg-light">@Model.PasswordType</div>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Title</label>
            <div class="form-control bg-light">@Model.Title</div>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Username / Email</label>
            <div class="form-control bg-light">@Model.Username</div>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Password</label>
            <div class="input-group">
                <input type="password" id="passwordField" class="form-control" value="@Model.Password" readonly />
                <button class="btn btn-outline-secondary" type="button" id="revealPasswordBtn">🔓 Reveal</button>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Notes))
        {
            <div class="mb-3">
                <label class="form-label fw-bold">Notes</label>
                <div class="form-control bg-light">@Model.Notes</div>
            </div>
        }

        <div class="text-center mt-4">
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById("revealPasswordBtn").addEventListener("click", function () {
            const pin = prompt("Enter your Vault PIN to reveal the password:");
            if (!pin) return;

            const token = document.querySelector('#antiForgeryForm input[name="__RequestVerificationToken"]').value;

            fetch('/VaultPasswords/VerifyPin', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify({ pin: pin })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    document.getElementById("passwordField").type = "text";
                    this.disabled = true;
                    this.textContent = "🔓 Revealed";
                } else {
                    alert("Incorrect PIN. Try again.");
                }
            });
        });
    </script>
}
