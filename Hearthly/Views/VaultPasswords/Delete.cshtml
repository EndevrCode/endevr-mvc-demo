@model Hearthly.Data.Vault.VaultPassword

@{
    ViewData["Title"] = "Delete Password";
}

<div class="container mt-4">
    <div class="card shadow-sm p-4 rounded-4 mx-auto border-danger" style="max-width: 600px;">
        <h4 class="text-center text-danger mb-3">⚠️ Confirm Deletion</h4>

        <p class="text-center text-muted">
            Are you sure you want to permanently delete the following password entry?
        </p>

        <dl class="row small">
            <dt class="col-sm-5">Password Type</dt>
            <dd class="col-sm-7">@Model.PasswordType</dd>

            <dt class="col-sm-5">Title</dt>
            <dd class="col-sm-7">@Model.Title</dd>

            <dt class="col-sm-5">Username / Email</dt>
            <dd class="col-sm-7">@Model.Username</dd>

            <dt class="col-sm-5">Created</dt>
            <dd class="col-sm-7">@Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</dd>
        </dl>

        <form asp-action="DeleteConfirmed" method="post" class="text-center mt-4">
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.Id)

            <button type="submit" class="btn btn-danger w-100 mb-2">🗑️ Yes, Delete Permanently</button>
            <a asp-action="Index" class="btn btn-secondary w-100">Cancel</a>
        </form>
    </div>
</div>
