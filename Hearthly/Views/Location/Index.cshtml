@using Hearthly.Data
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

@{
    ViewData["Title"] = "Family Tracker";
    Layout = "~/Views/Shared/_LandingLayout.cshtml";

    var noFamily   = ViewBag.NoFamily as bool? == true;
    var familyId   = noFamily ? Guid.Empty : (Guid)ViewBag.FamilyId;
    var families   = noFamily ? null : (List<Family>)ViewBag.Families;
    var members    = noFamily ? null : (List<FamilyMember>)ViewBag.Members;
    var profiles   = noFamily ? null : (List<UserProfile>)ViewBag.Profiles;
    var locations  = noFamily ? null : (List<FamilyLocation>)ViewBag.Locations;
    var places     = noFamily ? null : (List<FamilyPlace>)ViewBag.Places;
    var myLocation = noFamily ? null : ViewBag.MyLocation as FamilyLocation;
    var myUserId   = noFamily ? "" : (string)ViewBag.CurrentUserId;
}

@section Styles {
<style>
    /* Override layout padding for this full-screen page */
    .container-main { padding: 0 !important; }

    .tracker-shell {
        display: flex;
        flex-direction: column;
        height: calc(100svh - 64px);
        overflow: hidden;
        position: relative;
        background: #0f0f14;
    }

    /* ─── Top bar ─── */
    .tracker-topbar {
        position: absolute;
        top: 0; left: 0; right: 0;
        z-index: 10;
        padding: 10px 12px;
        display: flex;
        align-items: center;
        gap: 8px;
        background: linear-gradient(to bottom, rgba(0,0,0,.65) 0%, transparent 100%);
        pointer-events: none;
    }
    .tracker-topbar > * { pointer-events: auto; }

    .family-pill {
        background: rgba(255,255,255,.12);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255,255,255,.15);
        border-radius: 20px;
        padding: 5px 12px;
        font-size: 13px;
        font-weight: 600;
        color: #fff;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 6px;
        text-decoration: none;
        flex-shrink: 0;
    }
    .family-pill:hover { background: rgba(255,255,255,.2); color: #fff; }

    .tracking-badge {
        display: flex;
        align-items: center;
        gap: 5px;
        background: rgba(0,0,0,.45);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255,255,255,.12);
        border-radius: 20px;
        padding: 5px 11px;
        font-size: 12px;
        font-weight: 600;
        color: #aaa;
        cursor: pointer;
        transition: all .2s;
        white-space: nowrap;
    }
    .tracking-badge.active {
        background: rgba(16, 185, 129, .2);
        border-color: rgba(16, 185, 129, .5);
        color: #10b981;
    }
    .tracking-dot {
        width: 7px; height: 7px;
        border-radius: 50%;
        background: #555;
        flex-shrink: 0;
    }
    .tracking-badge.active .tracking-dot {
        background: #10b981;
        box-shadow: 0 0 6px #10b981;
        animation: pulse-dot 2s infinite;
    }
    @keyframes pulse-dot {
        0%, 100% { opacity: 1; }
        50% { opacity: .4; }
    }

    .places-btn {
        margin-left: auto;
        background: rgba(255,255,255,.1);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255,255,255,.12);
        border-radius: 20px;
        padding: 5px 11px;
        font-size: 12px;
        font-weight: 600;
        color: #ddd;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 5px;
    }
    .places-btn:hover { background: rgba(255,255,255,.18); }

    /* ─── Map ─── */
    #familyMap {
        flex: 1;
        width: 100%;
        min-height: 0;
    }

    /* ─── Bottom panel ─── */
    .tracker-bottom {
        background: #111118;
        border-top: 1px solid rgba(255,255,255,.07);
        flex-shrink: 0;
    }

    .panel-drag-handle {
        width: 36px; height: 4px;
        background: rgba(255,255,255,.15);
        border-radius: 2px;
        margin: 8px auto 0;
    }

    /* My status row */
    .my-status-row {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 8px 14px 6px;
        border-bottom: 1px solid rgba(255,255,255,.05);
    }
    .my-status-note {
        flex: 1;
        background: rgba(255,255,255,.06);
        border: 1px solid rgba(255,255,255,.1);
        border-radius: 20px;
        padding: 5px 12px;
        font-size: 12px;
        color: #bbb;
        outline: none;
        min-width: 0;
    }
    .my-status-note::placeholder { color: #555; }
    .my-status-note:focus { border-color: rgba(99,102,241,.5); }
    .visibility-toggle {
        width: 32px; height: 32px;
        border-radius: 50%;
        border: none;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        cursor: pointer;
        flex-shrink: 0;
        transition: all .2s;
    }
    .visibility-toggle.visible   { background: rgba(16,185,129,.15); color: #10b981; }
    .visibility-toggle.hidden    { background: rgba(100,100,100,.2); color: #666; }

    /* Member rail */
    .member-rail {
        display: flex;
        gap: 10px;
        padding: 10px 14px 12px;
        overflow-x: auto;
        scrollbar-width: none;
        -ms-overflow-style: none;
    }
    .member-rail::-webkit-scrollbar { display: none; }

    .member-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
        min-width: 72px;
        cursor: pointer;
        flex-shrink: 0;
        padding: 8px 6px;
        border-radius: 14px;
        border: 1.5px solid transparent;
        transition: all .2s;
    }
    .member-card:hover { background: rgba(255,255,255,.05); }
    .member-card.selected {
        border-color: rgba(99,102,241,.6);
        background: rgba(99,102,241,.1);
    }

    .member-avatar-wrap {
        position: relative;
        width: 48px; height: 48px;
    }
    .member-avatar-img,
    .member-avatar-initial {
        width: 48px; height: 48px;
        border-radius: 50%;
        border: 2.5px solid #333;
        object-fit: cover;
        font-size: 18px;
        font-weight: 700;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #3b3b50;
    }
    .member-card.is-me .member-avatar-img,
    .member-card.is-me .member-avatar-initial {
        border-color: #6366f1;
    }

    .battery-pip {
        position: absolute;
        bottom: -2px; right: -2px;
        background: #111118;
        border-radius: 10px;
        padding: 1px 4px;
        font-size: 9px;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 2px;
        line-height: 1;
    }
    .battery-pip.high   { color: #10b981; }
    .battery-pip.medium { color: #f59e0b; }
    .battery-pip.low    { color: #ef4444; }
    .battery-pip.charging { color: #6366f1; }

    .member-name-label {
        font-size: 11px;
        font-weight: 600;
        color: #ccc;
        max-width: 68px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        text-align: center;
    }
    .member-status-label {
        font-size: 10px;
        color: #666;
        text-align: center;
        max-width: 68px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    .member-status-label.at-place { color: #10b981; }
    .member-status-label.driving  { color: #f59e0b; }
    .member-status-label.hidden   { color: #555; font-style: italic; }

    /* ─── Places sheet ─── */
    .places-sheet {
        position: absolute;
        bottom: 0; left: 0; right: 0;
        background: #16161f;
        border-radius: 20px 20px 0 0;
        border-top: 1px solid rgba(255,255,255,.08);
        z-index: 20;
        transform: translateY(100%);
        transition: transform .3s cubic-bezier(.4,0,.2,1);
        max-height: 75vh;
        display: flex;
        flex-direction: column;
    }
    .places-sheet.open { transform: translateY(0); }

    .places-sheet-header {
        padding: 16px 16px 10px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid rgba(255,255,255,.06);
        flex-shrink: 0;
    }
    .places-sheet-title {
        font-size: 15px;
        font-weight: 700;
        color: #eee;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .places-sheet-body {
        overflow-y: auto;
        flex: 1;
        padding: 10px 14px 20px;
    }

    .place-row {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 10px;
        border-radius: 12px;
        margin-bottom: 6px;
        background: rgba(255,255,255,.04);
        border: 1px solid rgba(255,255,255,.06);
    }
    .place-icon {
        width: 36px; height: 36px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        flex-shrink: 0;
    }
    .place-icon.home   { background: rgba(99,102,241,.2);  color: #818cf8; }
    .place-icon.work   { background: rgba(245,158,11,.15); color: #fbbf24; }
    .place-icon.school { background: rgba(16,185,129,.15); color: #34d399; }
    .place-icon.custom { background: rgba(239,68,68,.15);  color: #f87171; }

    .place-info { flex: 1; min-width: 0; }
    .place-info-name { font-size: 13px; font-weight: 600; color: #ddd; }
    .place-info-radius { font-size: 11px; color: #666; }

    .place-delete-btn {
        width: 28px; height: 28px;
        background: rgba(239,68,68,.1);
        border: none;
        border-radius: 8px;
        color: #f87171;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: 12px;
        flex-shrink: 0;
    }

    .add-place-btn-row {
        margin-top: 12px;
        display: flex;
        gap: 8px;
    }
    .add-place-trigger {
        flex: 1;
        background: rgba(99,102,241,.15);
        border: 1.5px dashed rgba(99,102,241,.4);
        border-radius: 12px;
        color: #818cf8;
        font-size: 13px;
        font-weight: 600;
        padding: 10px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
    }
    .add-place-trigger:hover { background: rgba(99,102,241,.25); }

    /* Sheet overlay */
    .sheet-overlay {
        position: absolute;
        inset: 0;
        background: rgba(0,0,0,.5);
        z-index: 19;
        display: none;
    }
    .sheet-overlay.visible { display: block; }

    /* Member detail popup on map */
    .map-member-popup {
        background: #16161f;
        border: 1px solid rgba(255,255,255,.1);
        border-radius: 16px;
        padding: 14px 16px;
        min-width: 200px;
        max-width: 260px;
        font-family: inherit;
    }
    .popup-name { font-size: 15px; font-weight: 700; color: #eee; margin-bottom: 4px; }
    .popup-place { font-size: 13px; color: #10b981; margin-bottom: 2px; }
    .popup-address { font-size: 12px; color: #888; margin-bottom: 4px; }
    .popup-note { font-size: 12px; color: #aaa; font-style: italic; }
    .popup-meta { font-size: 11px; color: #555; margin-top: 6px; }

    /* No family state */
    .tracker-empty {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 12px;
        padding: 40px 24px;
        text-align: center;
    }

    /* Speed badge */
    .speed-badge {
        display: inline-flex;
        align-items: center;
        gap: 3px;
        font-size: 9px;
        padding: 1px 5px;
        border-radius: 8px;
        font-weight: 700;
        line-height: 1.4;
    }
    .speed-badge.driving { background: rgba(245,158,11,.2); color: #fbbf24; }
    .speed-badge.walking { background: rgba(99,102,241,.2);  color: #818cf8; }

    /* Refresh indicator */
    .refresh-indicator {
        position: absolute;
        top: 52px; right: 12px;
        z-index: 11;
        font-size: 10px;
        color: rgba(255,255,255,.3);
        pointer-events: none;
        display: flex;
        align-items: center;
        gap: 4px;
    }
</style>
}

@if (noFamily)
{
    <div class="tracker-shell">
        <div class="tracker-empty">
            <i class="fa-light fa-people-roof fa-3x" style="color:#6366f1;opacity:.6;"></i>
            <p style="color:#888;margin:0;">You need to be in a family to use Family Tracker.</p>
            <a asp-controller="Families" asp-action="Create" class="btn btn-sm btn-primary rounded-pill px-4">
                <i class="fa-light fa-plus me-1"></i> Create a Family
            </a>
        </div>
    </div>
    return;
}

@{
    var isVisible = myLocation?.IsVisible ?? true;
}

<div class="tracker-shell" id="trackerShell">

    @* ─── Top bar ─── *@
    <div class="tracker-topbar">
        @if (families!.Count > 1)
        {
            <div class="dropdown">
                <div class="family-pill" data-bs-toggle="dropdown">
                    <i class="fa-light fa-people-roof"></i>
                    <span id="activeFamilyName">@(families.FirstOrDefault(f => f.Id == familyId)?.Name ?? "Family")</span>
                    <i class="fa-light fa-chevron-down" style="font-size:10px;opacity:.6;"></i>
                </div>
                <ul class="dropdown-menu dropdown-menu-dark">
                    @foreach (var f in families)
                    {
                        <li>
                            <a class="dropdown-item @(f.Id == familyId ? "active" : "")"
                               href="@Url.Action("Index", "Location", new { familyId = f.Id })">
                                @f.Name
                            </a>
                        </li>
                    }
                </ul>
            </div>
        }
        else
        {
            <div class="family-pill" style="cursor:default;">
                <i class="fa-light fa-people-roof"></i>
                <span>@(families.FirstOrDefault()?.Name ?? "Family")</span>
            </div>
        }

        <div class="tracking-badge" id="trackingBadge" onclick="toggleTracking()">
            <span class="tracking-dot"></span>
            <span id="trackingLabel">Tracking off</span>
        </div>

        <div class="places-btn" id="placesBtnTrigger" onclick="openPlacesSheet()">
            <i class="fa-light fa-map-pin"></i>
            <span>Places</span>
        </div>
    </div>

    @* Refresh indicator *@
    <div class="refresh-indicator" id="refreshIndicator" style="display:none;">
        <i class="fa-light fa-arrows-rotate fa-spin" style="font-size:10px;"></i> Updating…
    </div>

    @* ─── Map ─── *@
    <div id="familyMap"></div>

    @* ─── Bottom panel ─── *@
    <div class="tracker-bottom">
        <div class="panel-drag-handle"></div>

        @* My status row *@
        <div class="my-status-row">
            <button class="visibility-toggle @(isVisible ? "visible" : "hidden")"
                    id="visibilityToggleBtn"
                    title="@(isVisible ? "Hide my location" : "Show my location")"
                    onclick="doToggleVisibility()">
                <i class="fa-light fa-@(isVisible ? "eye" : "eye-slash")"></i>
            </button>
            <input type="text"
                   class="my-status-note"
                   id="statusNoteInput"
                   placeholder="Set a status…"
                   maxlength="100"
                   value="@(myLocation?.Note ?? "")"
                   onkeydown="if(event.key==='Enter')saveNote()" />
            <button class="btn btn-sm rounded-pill"
                    style="background:rgba(99,102,241,.2);color:#818cf8;border:none;font-size:11px;font-weight:600;padding:5px 10px;white-space:nowrap;"
                    onclick="saveNote()">Save</button>
        </div>

        @* Member rail *@
        <div class="member-rail" id="memberRail">
            @foreach (var member in members!)
            {
                var prof = profiles!.FirstOrDefault(p => p.UserId == member.UserId);
                var loc  = locations!.FirstOrDefault(l => l.UserId == member.UserId);
                var name = prof?.PreferredName ?? prof?.FirstName ?? member.User?.UserName ?? "Member";
                var isMe = member.UserId == myUserId;
                var hidden   = loc?.IsVisible == false && !isMe;
                var hasLoc   = loc?.Latitude != null && loc.IsVisible;
                var atPlace  = !string.IsNullOrEmpty(loc?.PlaceName);
                var speed    = loc?.Speed;
                var isDriving = speed > 4.0;
                var isWalking = speed is >= 1.0 and <= 4.0;

                var statusText = hidden ? "Hidden"
                    : atPlace ? loc!.PlaceName!
                    : isDriving ? "Driving"
                    : isWalking ? "Walking"
                    : hasLoc ? TimeSince(loc!.UpdatedAt)
                    : "No location";

                var statusClass = hidden ? "hidden"
                    : atPlace ? "at-place"
                    : isDriving ? "driving"
                    : "";

                var battery = loc?.BatteryLevel;
                var charging = loc?.IsCharging == true;
                var batteryClass = charging ? "charging"
                    : battery < 20 ? "low"
                    : battery < 50 ? "medium"
                    : "high";

                <div class="member-card @(isMe ? "is-me" : "")"
                     id="mc-@member.UserId"
                     onclick="focusMember('@member.UserId')">
                    <div class="member-avatar-wrap">
                        @if (!string.IsNullOrEmpty(prof?.PhotoPath))
                        {
                            <img src="@prof.PhotoPath" class="member-avatar-img" alt="@name" />
                        }
                        else
                        {
                            <div class="member-avatar-initial">@name[..1].ToUpper()</div>
                        }

                        @if (battery.HasValue)
                        {
                            <div class="battery-pip @batteryClass">
                                <i class="fa-solid fa-@(charging ? "bolt" : "battery-half")" style="font-size:8px;"></i>
                                @battery%
                            </div>
                        }
                    </div>
                    <div class="member-name-label">@(isMe ? "You" : name)</div>
                    <div class="member-status-label @statusClass">@statusText</div>
                </div>
            }
        </div>
    </div>

    @* ─── Places sheet overlay ─── *@
    <div class="sheet-overlay" id="sheetOverlay" onclick="closePlacesSheet()"></div>

    @* ─── Places sheet ─── *@
    <div class="places-sheet" id="placesSheet">
        <div class="places-sheet-header">
            <div class="places-sheet-title">
                <i class="fa-light fa-map-pin" style="color:#6366f1;"></i>
                Family Places
            </div>
            <button onclick="closePlacesSheet()" style="background:none;border:none;color:#888;font-size:18px;cursor:pointer;padding:0 4px;">
                <i class="fa-light fa-xmark"></i>
            </button>
        </div>
        <div class="places-sheet-body" id="placesSheetBody">
            @* Rendered by JS from server data *@
        </div>
    </div>

</div>

@* Hidden CSRF / data forms *@
<form id="csrfForm" class="d-none">@Html.AntiForgeryToken()</form>

@functions {
    static string TimeSince(DateTime dt)
    {
        var diff = DateTime.UtcNow - dt;
        if (diff.TotalSeconds < 60)  return "just now";
        if (diff.TotalMinutes < 60)  return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalHours < 24)    return $"{(int)diff.TotalHours}h ago";
        return dt.ToLocalTime().ToString("dd MMM HH:mm");
    }
}

@section Scripts {
<script>
// ── Server data injected at render time ──────────────────────────────────────
const FAMILY_ID  = '@familyId';
const MY_USER_ID = '@myUserId';
const CSRF_TOKEN = () => document.querySelector('#csrfForm input[name="__RequestVerificationToken"]')?.value;

const INITIAL_MEMBERS = [
    @foreach (var member in members!)
    {
        var prof = profiles!.FirstOrDefault(p => p.UserId == member.UserId);
        var loc  = locations!.FirstOrDefault(l => l.UserId == member.UserId);
        var name = prof?.PreferredName ?? prof?.FirstName ?? member.User?.UserName ?? "Member";
        var visible = loc?.IsVisible ?? true;
        <text>{
            userId:   @Html.Raw(System.Text.Json.JsonSerializer.Serialize(member.UserId)),
            name:     @Html.Raw(System.Text.Json.JsonSerializer.Serialize(name)),
            initials: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(name[..1].ToUpper())),
            photoPath:@Html.Raw(System.Text.Json.JsonSerializer.Serialize(prof?.PhotoPath ?? "")),
            lat:      @(visible && loc?.Latitude != null ? loc!.Latitude!.Value.ToString("R", System.Globalization.CultureInfo.InvariantCulture) : "null"),
            lng:      @(visible && loc?.Longitude != null ? loc!.Longitude!.Value.ToString("R", System.Globalization.CultureInfo.InvariantCulture) : "null"),
            address:  @Html.Raw(System.Text.Json.JsonSerializer.Serialize(visible ? loc?.Address ?? "" : "")),
            placeName:@Html.Raw(System.Text.Json.JsonSerializer.Serialize(visible ? loc?.PlaceName ?? "" : "")),
            note:     @Html.Raw(System.Text.Json.JsonSerializer.Serialize(loc?.Note ?? "")),
            battery:  @(loc?.BatteryLevel?.ToString() ?? "null"),
            charging: @((loc?.IsCharging == true).ToString().ToLower()),
            speed:    @(loc?.Speed?.ToString("R", System.Globalization.CultureInfo.InvariantCulture) ?? "null"),
            isVisible:@((loc?.IsVisible ?? true).ToString().ToLower()),
            isMe:     @((member.UserId == myUserId).ToString().ToLower())
        },</text>
    }
];

const INITIAL_PLACES = [
    @foreach (var place in places!)
    {
        <text>{
            id:          @Html.Raw(System.Text.Json.JsonSerializer.Serialize(place.Id.ToString())),
            name:        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(place.Name)),
            placeType:   @((int)place.PlaceType),
            lat:         @place.Latitude.ToString("R", System.Globalization.CultureInfo.InvariantCulture),
            lng:         @place.Longitude.ToString("R", System.Globalization.CultureInfo.InvariantCulture),
            radiusMeters:@place.RadiusMeters
        },</text>
    }
];

// ── State ─────────────────────────────────────────────────────────────────────
let map, markers = {}, placeMarkers = [], placeCircles = [];
let placePickerMarker = null, placePickerLatLng = null;
let trackingOn = localStorage.getItem('hearthly_tracking') === '1';
let watchId = null;
let lastSentLat = null, lastSentLng = null, lastSentTime = 0;
let currentPlaces = [...INITIAL_PLACES];
let selectedMemberId = null;
let pollTimer = null;

// ── Google Maps init (called by Maps API callback) ────────────────────────────
window.initAutocomplete = function () { initMap(); };

function initMap() {
    map = new google.maps.Map(document.getElementById('familyMap'), {
        zoom: 10,
        center: { lat: -28.4793, lng: 24.6727 },
        mapTypeControl:    false,
        streetViewControl: false,
        fullscreenControl: false,
        zoomControl:       true,
        zoomControlOptions: { position: google.maps.ControlPosition.RIGHT_CENTER },
        styles: [
            { featureType: 'all',  elementType: 'geometry',   stylers: [{ color: '#1a1a2e' }] },
            { featureType: 'water',elementType: 'geometry',   stylers: [{ color: '#0f0f23' }] },
            { featureType: 'road', elementType: 'geometry',   stylers: [{ color: '#2a2a3e' }] },
            { featureType: 'road', elementType: 'labels.text.fill', stylers: [{ color: '#555' }] },
            { featureType: 'poi',  elementType: 'labels',     stylers: [{ visibility: 'off' }] },
            { featureType: 'transit', elementType: 'labels',  stylers: [{ visibility: 'off' }] },
            { featureType: 'landscape', elementType: 'geometry', stylers: [{ color: '#16161f' }] },
            { featureType: 'administrative', elementType: 'labels.text.fill', stylers: [{ color: '#444' }] },
        ]
    });

    // Render initial data
    renderAllMembers(INITIAL_MEMBERS);
    renderPlaces(INITIAL_PLACES);
    fitMapToContent();

    // Start tracking if it was on
    if (trackingOn) startTracking();
    updateTrackingBadge();

    // Render places sheet
    renderPlacesSheet();

    // Start polling every 30s
    pollTimer = setInterval(pollLocations, 30000);
}

// ── Member markers ────────────────────────────────────────────────────────────
function memberIcon(initials, isMe, photoPath) {
    const canvas = document.createElement('canvas');
    canvas.width = 46; canvas.height = 56;
    const ctx = canvas.getContext('2d');

    const cx = 23, cy = 23, r = 21;
    const color = isMe ? '#6366f1' : '#4b5563';

    ctx.beginPath();
    ctx.arc(cx, cy, r, 0, 2 * Math.PI);
    ctx.fillStyle = color;
    ctx.fill();

    ctx.beginPath();
    ctx.arc(cx, cy, r - 2.5, 0, 2 * Math.PI);
    ctx.fillStyle = '#111118';
    ctx.fill();

    ctx.beginPath();
    ctx.arc(cx, cy, r - 5, 0, 2 * Math.PI);
    ctx.fillStyle = color;
    ctx.fill();

    ctx.fillStyle = '#fff';
    ctx.font = `bold 17px -apple-system,sans-serif`;
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillText(initials, cx, cy);

    // pointer
    ctx.beginPath();
    ctx.moveTo(cx - 6, cy + r - 3);
    ctx.lineTo(cx, cy + r + 9);
    ctx.lineTo(cx + 6, cy + r - 3);
    ctx.fillStyle = color;
    ctx.fill();

    return { url: canvas.toDataURL(), scaledSize: new google.maps.Size(46, 56), anchor: new google.maps.Point(23, 56) };
}

function renderAllMembers(memberList) {
    memberList.forEach(m => renderMemberMarker(m));
}

function renderMemberMarker(m) {
    if (markers[m.userId]) { markers[m.userId].setMap(null); }
    if (!m.lat || !m.lng || !m.isVisible) { delete markers[m.userId]; return; }

    const pos = { lat: m.lat, lng: m.lng };
    const marker = new google.maps.Marker({
        position: pos,
        map,
        title: m.name,
        icon: memberIcon(m.initials, m.isMe, m.photoPath),
        zIndex: m.isMe ? 10 : 5
    });

    const speed = m.speed;
    const movingText = speed > 4 ? '<i class="fa-light fa-car" style="font-size:11px;"></i> Driving' : speed > 1 ? '<i class="fa-light fa-person-walking" style="font-size:11px;"></i> Walking' : '';
    const popupHtml = `
        <div class="map-member-popup">
            <div class="popup-name">${escHtml(m.name)}${m.isMe ? ' <span style="font-size:10px;color:#6366f1;">(You)</span>' : ''}</div>
            ${m.placeName ? `<div class="popup-place"><i class="fa-solid fa-location-dot" style="font-size:11px;"></i> ${escHtml(m.placeName)}</div>` : ''}
            ${m.address && !m.placeName ? `<div class="popup-address">${escHtml(m.address)}</div>` : ''}
            ${m.note ? `<div class="popup-note">"${escHtml(m.note)}"</div>` : ''}
            ${movingText ? `<div class="popup-meta">${movingText}</div>` : ''}
            <div class="popup-meta">${m.battery != null ? `<i class="fa-solid fa-battery-half" style="font-size:10px;"></i> ${m.battery}%${m.charging ? ' <i class="fa-solid fa-bolt" style="font-size:9px;color:#818cf8;"></i>' : ''}  ·  ` : ''}Updated just now</div>
        </div>`;

    const infoWindow = new google.maps.InfoWindow({ content: popupHtml, disableAutoPan: false });
    marker.addListener('click', () => {
        closeAllInfoWindows();
        infoWindow.open(map, marker);
        openInfoWindows.push(infoWindow);
        selectMemberCard(m.userId);
    });

    marker._infoWindow = infoWindow;
    markers[m.userId] = marker;
}

let openInfoWindows = [];
function closeAllInfoWindows() {
    openInfoWindows.forEach(w => w.close());
    openInfoWindows = [];
}

// ── Places ────────────────────────────────────────────────────────────────────
const PLACE_ICONS = ['🏠', '💼', '🏫', '📍'];
const PLACE_COLORS = ['#6366f1','#f59e0b','#10b981','#ef4444'];

function renderPlaces(placeList) {
    placeMarkers.forEach(m => m.setMap(null));
    placeCircles.forEach(c => c.setMap(null));
    placeMarkers = []; placeCircles = [];

    placeList.forEach(p => {
        const circle = new google.maps.Circle({
            map,
            center: { lat: p.lat, lng: p.lng },
            radius: p.radiusMeters,
            fillColor: PLACE_COLORS[p.placeType] || '#6366f1',
            fillOpacity: 0.08,
            strokeColor: PLACE_COLORS[p.placeType] || '#6366f1',
            strokeOpacity: 0.3,
            strokeWeight: 1.5,
            clickable: false
        });
        placeCircles.push(circle);

        const marker = new google.maps.Marker({
            position: { lat: p.lat, lng: p.lng },
            map,
            title: p.name,
            label: {
                text: PLACE_ICONS[p.placeType] || '📍',
                fontSize: '18px'
            },
            icon: {
                path: google.maps.SymbolPath.CIRCLE,
                scale: 0,
                fillOpacity: 0
            },
            zIndex: 1
        });
        placeMarkers.push(marker);
    });
}

// ── Fit map ───────────────────────────────────────────────────────────────────
function fitMapToContent() {
    const bounds = new google.maps.LatLngBounds();
    let hasPoints = false;

    Object.values(markers).forEach(m => { bounds.extend(m.getPosition()); hasPoints = true; });
    currentPlaces.forEach(p => { bounds.extend({ lat: p.lat, lng: p.lng }); hasPoints = true; });

    if (hasPoints) {
        map.fitBounds(bounds, { top: 80, bottom: 220, left: 20, right: 20 });
        if (Object.keys(markers).length === 1 && currentPlaces.length === 0)
            map.setZoom(15);
    }
}

// ── Focus member ──────────────────────────────────────────────────────────────
function focusMember(userId) {
    selectMemberCard(userId);
    const marker = markers[userId];
    if (marker) {
        map.panTo(marker.getPosition());
        map.setZoom(16);
        closeAllInfoWindows();
        google.maps.event.trigger(marker, 'click');
    }
}

function selectMemberCard(userId) {
    document.querySelectorAll('.member-card').forEach(el => el.classList.remove('selected'));
    const card = document.getElementById(`mc-${userId}`);
    if (card) { card.classList.add('selected'); card.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' }); }
    selectedMemberId = userId;
}

// ── Tracking ──────────────────────────────────────────────────────────────────
function toggleTracking() {
    trackingOn = !trackingOn;
    localStorage.setItem('hearthly_tracking', trackingOn ? '1' : '0');
    if (trackingOn) startTracking();
    else            stopTracking();
    updateTrackingBadge();
}

function startTracking() {
    if (!navigator.geolocation) {
        Swal.fire({ titleText: 'Not supported', text: 'Your browser does not support geolocation.', icon: 'warning', background: '#16161f', color: '#eee' });
        trackingOn = false;
        return;
    }
    watchId = navigator.geolocation.watchPosition(
        pos => onPositionUpdate(pos),
        err => {
            if (err.code === 1) {
                trackingOn = false;
                localStorage.setItem('hearthly_tracking', '0');
                updateTrackingBadge();
            }
        },
        { enableHighAccuracy: true, maximumAge: 20000, timeout: 20000 }
    );
}

function stopTracking() {
    if (watchId !== null) { navigator.geolocation.clearWatch(watchId); watchId = null; }
}

function updateTrackingBadge() {
    const badge = document.getElementById('trackingBadge');
    const label = document.getElementById('trackingLabel');
    badge.classList.toggle('active', trackingOn);
    label.textContent = trackingOn ? 'Tracking on' : 'Tracking off';
}

async function onPositionUpdate(pos) {
    const lat = pos.coords.latitude;
    const lng = pos.coords.longitude;
    const spd = pos.coords.speed ?? 0;
    const now = Date.now();

    // Only send if moved >20 m or >60 s elapsed
    const dist = lastSentLat ? haversineMeter(lat, lng, lastSentLat, lastSentLng) : Infinity;
    if (dist < 20 && (now - lastSentTime) < 60000) return;

    lastSentLat = lat; lastSentLng = lng; lastSentTime = now;

    let battery = null, charging = false;
    try {
        const batt = await navigator.getBattery();
        battery = Math.round(batt.level * 100);
        charging = batt.charging;
    } catch {}

    // Reverse geocode only if moved significantly
    let address = '';
    if (window.google?.maps?.Geocoder) {
        try {
            const gc = new google.maps.Geocoder();
            const res = await new Promise((resolve, reject) =>
                gc.geocode({ location: { lat, lng } }, (r, s) => s === 'OK' ? resolve(r) : reject(s)));
            address = res[0]?.formatted_address ?? '';
        } catch {}
    }

    await sendCheckIn({ lat, lng, address, batteryLevel: battery, isCharging: charging, speed: spd });
}

async function sendCheckIn({ lat, lng, address = '', note = null, batteryLevel = null, isCharging = null, speed = null }) {
    const body = new URLSearchParams({
        familyId: FAMILY_ID,
        latitude: lat,
        longitude: lng,
        address,
        __RequestVerificationToken: CSRF_TOKEN()
    });
    if (note !== null)         body.append('note', note);
    if (batteryLevel !== null) body.append('batteryLevel', batteryLevel);
    if (isCharging !== null)   body.append('isCharging', isCharging);
    if (speed !== null)        body.append('speed', speed);

    try {
        const res = await fetch('@Url.Action("CheckIn","Location")', {
            method: 'POST',
            headers: { 'RequestVerificationToken': CSRF_TOKEN() },
            body
        });
        const data = await res.json();
        if (data.success) refreshMyCard();
    } catch {}
}

function refreshMyCard() {
    pollLocations(true);
}

// ── Polling ───────────────────────────────────────────────────────────────────
async function pollLocations(silent = false) {
    if (!silent) showRefreshIndicator();
    try {
        const res = await fetch(`@Url.Action("GetLocations","Location")?familyId=${FAMILY_ID}`);
        const data = await res.json();
        if (!data.success) return;
        data.members.forEach(m => {
            renderMemberMarker(m);
            updateMemberCard(m);
        });
    } catch {}
    if (!silent) hideRefreshIndicator();
}

function showRefreshIndicator() {
    const el = document.getElementById('refreshIndicator');
    if (el) el.style.display = 'flex';
}
function hideRefreshIndicator() {
    setTimeout(() => {
        const el = document.getElementById('refreshIndicator');
        if (el) el.style.display = 'none';
    }, 800);
}

function updateMemberCard(m) {
    const speed = m.speed;
    const isDriving = speed > 4;
    const isWalking = speed >= 1 && speed <= 4;
    const atPlace = m.placeName;
    const hidden = !m.isVisible && !m.isMe;

    let statusText = hidden ? 'Hidden'
        : atPlace ? m.placeName
        : isDriving ? 'Driving'
        : isWalking ? 'Walking'
        : m.lat ? 'just now'
        : 'No location';

    let statusClass = hidden ? 'hidden' : atPlace ? 'at-place' : isDriving ? 'driving' : '';

    const card = document.getElementById(`mc-${m.userId}`);
    if (!card) return;
    const statusEl = card.querySelector('.member-status-label');
    if (statusEl) {
        statusEl.textContent = statusText;
        statusEl.className = `member-status-label ${statusClass}`;
    }
    if (m.battery != null) {
        const batEl = card.querySelector('.battery-pip');
        if (batEl) {
            batEl.textContent = `${m.battery}%`;
            const cls = m.charging ? 'charging' : m.battery < 20 ? 'low' : m.battery < 50 ? 'medium' : 'high';
            batEl.className = `battery-pip ${cls}`;
        }
    }
}

// ── Note saving ───────────────────────────────────────────────────────────────
async function saveNote() {
    const note = document.getElementById('statusNoteInput').value.trim();
    try {
        await fetch('@Url.Action("UpdateNote","Location")', {
            method: 'POST',
            headers: { 'RequestVerificationToken': CSRF_TOKEN() },
            body: new URLSearchParams({ familyId: FAMILY_ID, note, __RequestVerificationToken: CSRF_TOKEN() })
        });
    } catch {}
}

// ── Visibility toggle ─────────────────────────────────────────────────────────
async function doToggleVisibility() {
    const btn = document.getElementById('visibilityToggleBtn');
    try {
        const res = await fetch('@Url.Action("ToggleVisibility","Location")', {
            method: 'POST',
            headers: { 'RequestVerificationToken': CSRF_TOKEN() },
            body: new URLSearchParams({ familyId: FAMILY_ID, __RequestVerificationToken: CSRF_TOKEN() })
        });
        const data = await res.json();
        if (data.success) {
            const vis = data.isVisible;
            btn.className = `visibility-toggle ${vis ? 'visible' : 'hidden'}`;
            btn.title = vis ? 'Hide my location' : 'Show my location';
            btn.querySelector('i').className = `fa-light fa-${vis ? 'eye' : 'eye-slash'}`;
        }
    } catch {}
}

// ── Places sheet ──────────────────────────────────────────────────────────────
function openPlacesSheet() {
    document.getElementById('placesSheet').classList.add('open');
    document.getElementById('sheetOverlay').classList.add('visible');
}
function closePlacesSheet() {
    document.getElementById('placesSheet').classList.remove('open');
    document.getElementById('sheetOverlay').classList.remove('visible');
}

function renderPlacesSheet() {
    const body = document.getElementById('placesSheetBody');
    const typeLabels = ['Home', 'Work', 'School', 'Place'];
    const typeClasses = ['home', 'work', 'school', 'custom'];
    const typeIcons = ['fa-house', 'fa-briefcase', 'fa-school', 'fa-map-pin'];

    let html = '';
    if (currentPlaces.length === 0) {
        html = `<div style="text-align:center;padding:30px 0;color:#555;">
            <i class="fa-light fa-map-pin fa-2x" style="margin-bottom:8px;display:block;"></i>
            No saved places yet. Add your home, work, or school.
        </div>`;
    } else {
        currentPlaces.forEach(p => {
            const tc = typeClasses[p.placeType] || 'custom';
            const ti = typeIcons[p.placeType]  || 'fa-map-pin';
            html += `<div class="place-row">
                <div class="place-icon ${tc}"><i class="fa-light ${ti}"></i></div>
                <div class="place-info">
                    <div class="place-info-name">${escHtml(p.name)}</div>
                    <div class="place-info-radius">${p.radiusMeters}m radius · ${typeLabels[p.placeType] || 'Place'}</div>
                </div>
                <button class="place-delete-btn" onclick="deletePlace('${p.id}')">
                    <i class="fa-light fa-trash"></i>
                </button>
            </div>`;
        });
    }

    html += `<div class="add-place-btn-row">
        <button class="add-place-trigger" onclick="startAddPlace()">
            <i class="fa-light fa-plus"></i> Add a Place
        </button>
    </div>`;

    body.innerHTML = html;
}

function startAddPlace() {
    closePlacesSheet();
    Swal.fire({
        titleText: 'Add a Place',
        html: `
            <div style="text-align:left;display:flex;flex-direction:column;gap:10px;">
                <div>
                    <label style="font-size:12px;color:#aaa;font-weight:600;">Place Name</label>
                    <input id="swal-place-name" class="swal2-input" placeholder="e.g. Home, Work, School" style="margin:4px 0 0;" maxlength="100" />
                </div>
                <div>
                    <label style="font-size:12px;color:#aaa;font-weight:600;">Type</label>
                    <select id="swal-place-type" class="swal2-select" style="margin:4px 0 0;display:block;width:100%;">
                        <option value="0">🏠 Home</option>
                        <option value="1">💼 Work</option>
                        <option value="2">🏫 School</option>
                        <option value="3">📍 Custom</option>
                    </select>
                </div>
                <div>
                    <label style="font-size:12px;color:#aaa;font-weight:600;">Radius</label>
                    <select id="swal-place-radius" class="swal2-select" style="margin:4px 0 0;display:block;width:100%;">
                        <option value="100">100m (small building)</option>
                        <option value="200" selected>200m (block)</option>
                        <option value="500">500m (neighbourhood)</option>
                        <option value="1000">1km (large area)</option>
                    </select>
                </div>
                <div>
                    <label style="font-size:12px;color:#aaa;font-weight:600;">Location</label>
                    <button onclick="useCurrentLocationForPlace()" class="btn btn-sm rounded-pill" style="margin-top:4px;background:rgba(99,102,241,.2);color:#818cf8;border:none;font-size:12px;font-weight:600;padding:6px 14px;">
                        <i class="fa-light fa-location-crosshairs me-1"></i> Use My Current Location
                    </button>
                    <div id="swal-place-coords" style="font-size:11px;color:#666;margin-top:4px;"></div>
                </div>
            </div>`,
        background: '#16161f',
        color: '#eee',
        showCancelButton: true,
        confirmButtonText: 'Save Place',
        confirmButtonColor: '#6366f1',
        cancelButtonColor: '#374151',
        preConfirm: () => {
            const name   = document.getElementById('swal-place-name').value.trim();
            const type   = parseInt(document.getElementById('swal-place-type').value);
            const radius = parseInt(document.getElementById('swal-place-radius').value);
            if (!name) { Swal.showValidationMessage('Please enter a name'); return false; }
            if (!window._addPlaceLat) { Swal.showValidationMessage('Please select a location'); return false; }
            return { name, type, radius, lat: window._addPlaceLat, lng: window._addPlaceLng };
        }
    }).then(result => {
        if (result.isConfirmed) savePlace(result.value);
    });
}

window.useCurrentLocationForPlace = function () {
    navigator.geolocation.getCurrentPosition(pos => {
        window._addPlaceLat = pos.coords.latitude;
        window._addPlaceLng = pos.coords.longitude;
        document.getElementById('swal-place-coords').textContent =
            `📍 ${pos.coords.latitude.toFixed(5)}, ${pos.coords.longitude.toFixed(5)}`;
    }, () => {
        document.getElementById('swal-place-coords').textContent = 'Could not get location.';
    }, { enableHighAccuracy: true, timeout: 10000 });
};

async function savePlace({ name, type, radius, lat, lng }) {
    try {
        const res = await fetch('@Url.Action("SavePlace","Location")', {
            method: 'POST',
            headers: { 'RequestVerificationToken': CSRF_TOKEN() },
            body: new URLSearchParams({
                familyId: FAMILY_ID, name, placeType: type, latitude: lat, longitude: lng,
                radiusMeters: radius, __RequestVerificationToken: CSRF_TOKEN()
            })
        });
        const data = await res.json();
        if (data.success) {
            currentPlaces.push(data);
            renderPlaces(currentPlaces);
            renderPlacesSheet();
            openPlacesSheet();
        }
    } catch {}
}

async function deletePlace(id) {
    const confirmed = await Swal.fire({
        titleText: 'Remove Place?',
        text: 'This place will be removed for the whole family.',
        icon: 'warning',
        background: '#16161f',
        color: '#eee',
        showCancelButton: true,
        confirmButtonText: 'Remove',
        confirmButtonColor: '#ef4444',
        cancelButtonColor: '#374151'
    });
    if (!confirmed.isConfirmed) return;

    try {
        const res = await fetch('@Url.Action("DeletePlace","Location")', {
            method: 'POST',
            headers: { 'RequestVerificationToken': CSRF_TOKEN() },
            body: new URLSearchParams({ id, familyId: FAMILY_ID, __RequestVerificationToken: CSRF_TOKEN() })
        });
        const data = await res.json();
        if (data.success) {
            currentPlaces = currentPlaces.filter(p => p.id !== id);
            renderPlaces(currentPlaces);
            renderPlacesSheet();
        }
    } catch {}
}

// ── Utilities ─────────────────────────────────────────────────────────────────
function escHtml(str) {
    if (!str) return '';
    return str.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

function haversineMeter(lat1, lon1, lat2, lon2) {
    const R = 6371000, dLat = (lat2-lat1)*Math.PI/180, dLon = (lon2-lon1)*Math.PI/180;
    const a = Math.sin(dLat/2)**2 + Math.cos(lat1*Math.PI/180)*Math.cos(lat2*Math.PI/180)*Math.sin(dLon/2)**2;
    return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
}
