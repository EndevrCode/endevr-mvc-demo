@model IEnumerable<Hearthly.Data.Shopping.ShoppingList>

@section Scripts {
    <script>
        function confirmDeleteList(id) {
            Swal.fire({
                title: 'Delete this list?',
                text: "All items in this list will be permanently removed.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, delete',
                confirmButtonColor: '#dc3545',
                cancelButtonText: 'Cancel',
                reverseButtons: true
            }).then(result => {
                if (result.isConfirmed) document.getElementById('deleteList-' + id).submit();
            });
        }
    </script>
}

@{
    ViewData["Title"] = "Shopping";
    var familyId = ViewData["FamilyId"] as Guid? ?? Guid.Empty;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0"><i class="fa-light fa-cart-shopping me-2"></i>Shopping</h2>
</div>

@* Create new list form *@
<div class="glass-card p-3 mb-4">
    <form asp-action="CreateList" method="post" class="d-flex gap-2">
        @Html.AntiForgeryToken()
        <input type="hidden" name="familyId" value="@familyId" />
        <input type="text" name="name" class="form-control" placeholder="New list name (e.g. Weekly groceries)" required />
        <button type="submit" class="btn btn-primary text-nowrap"><i class="bi bi-plus-lg"></i> Add List</button>
    </form>
</div>

@if (!Model.Any())
{
    <div class="glass-card text-center py-5">
        <i class="fa-light fa-cart-shopping fa-3x text-muted mb-3 d-block"></i>
        <p class="text-muted mb-0">No shopping lists yet. Create your first list above.</p>
    </div>
}

@foreach (var list in Model)
{
    var total    = list.Items.Count;
    var checked_ = list.Items.Count(i => i.IsChecked);
    var pct      = total > 0 ? (int)Math.Round(100.0 * checked_ / total) : 0;

    <div class="glass-card p-3 mb-4">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h5 class="mb-0 fw-semibold">@list.Name</h5>
            <div class="d-flex gap-1">
                @if (checked_ > 0)
                {
                    <form asp-action="ClearChecked" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="listId" value="@list.Id" />
                        <input type="hidden" name="familyId" value="@familyId" />
                        <button type="submit" class="btn btn-outline-success btn-sm" title="Remove checked items">
                            <i class="bi bi-check2-all"></i>
                        </button>
                    </form>
                }
                <form asp-action="ArchiveList" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="listId" value="@list.Id" />
                    <input type="hidden" name="familyId" value="@familyId" />
                    <button type="submit" class="btn btn-outline-secondary btn-sm" title="Archive list">
                        <i class="bi bi-archive"></i>
                    </button>
                </form>
                <form id="deleteList-@list.Id" asp-action="DeleteList" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="listId" value="@list.Id" />
                    <input type="hidden" name="familyId" value="@familyId" />
                    <button type="button" class="btn btn-outline-danger btn-sm" title="Delete list"
                            onclick="confirmDeleteList('@list.Id')">
                        <i class="bi bi-trash"></i>
                    </button>
                </form>
            </div>
        </div>

        @if (total > 0)
        {
            <div class="progress mb-3" style="height:6px;">
                <div class="progress-bar bg-success" style="width:@pct%"></div>
            </div>
            <p class="small text-muted mb-2">@checked_ of @total items checked</p>
        }

        <ul class="list-group list-group-flush mb-3">
            @foreach (var item in list.Items.OrderBy(i => i.IsChecked).ThenBy(i => i.SortOrder))
            {
                <li class="list-group-item bg-transparent border-0 px-0 py-1">
                    <div class="d-flex align-items-center gap-2">
                        <form asp-action="ToggleItem" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="itemId" value="@item.Id" />
                            <input type="hidden" name="familyId" value="@familyId" />
                            <button type="submit" class="btn btn-link p-0 border-0" style="line-height:1;">
                                <i class="bi @(item.IsChecked ? "bi-check-circle-fill text-success" : "bi-circle") fs-5"></i>
                            </button>
                        </form>
                        <span class="@(item.IsChecked ? "text-decoration-line-through text-muted" : "")">
                            @item.Name
                            @if (!string.IsNullOrWhiteSpace(item.Quantity))
                            {
                                <small class="text-muted ms-1">(@item.Quantity)</small>
                            }
                        </span>
                        <form asp-action="DeleteItem" method="post" class="ms-auto">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="itemId" value="@item.Id" />
                            <input type="hidden" name="familyId" value="@familyId" />
                            <button type="submit" class="btn btn-link text-danger p-0 border-0">
                                <i class="bi bi-x-lg small"></i>
                            </button>
                        </form>
                    </div>
                </li>
            }
        </ul>

        <form asp-action="AddItem" method="post" class="d-flex gap-2">
            @Html.AntiForgeryToken()
            <input type="hidden" name="listId" value="@list.Id" />
            <input type="hidden" name="familyId" value="@familyId" />
            <input type="text" name="name" class="form-control form-control-sm" placeholder="Add item…" required />
            <input type="text" name="quantity" class="form-control form-control-sm" placeholder="Qty" style="max-width:80px;" />
            <button type="submit" class="btn btn-outline-primary btn-sm text-nowrap">
                <i class="bi bi-plus-lg"></i>
            </button>
        </form>
    </div>
}
