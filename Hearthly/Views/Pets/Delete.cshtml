@model Hearthly.Data.Pet

@{
    ViewData["Title"] = "Delete Pet";
}

<div class="mb-4 d-flex justify-content-between align-items-center">
    <h2 class="mb-0 text-danger"><i class="fa-light fa-triangle-exclamation me-2"></i>Delete Pet</h2>
</div>

<div class="glass-card p-4" style="max-width:480px;">
    <div class="d-flex align-items-center gap-3 mb-4">
        @if (!string.IsNullOrEmpty(Model.PhotoPath))
        {
            <img src="@Model.PhotoPath"
                 alt="@Model.Name"
                 class="rounded-circle flex-shrink-0"
                 style="width:72px;height:72px;object-fit:cover;" />
        }
        else
        {
            <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                 style="width:72px;height:72px;background:rgba(255,255,255,.08);">
                <i class="fa-light fa-paw fa-xl text-muted"></i>
            </div>
        }
        <div>
            <div class="fw-semibold fs-5">@Model.Name</div>
            <small class="text-muted">@Model.Species@(!string.IsNullOrEmpty(Model.Breed) ? $" · {Model.Breed}" : "")</small>
        </div>
    </div>

    <p class="text-muted mb-4">This will permanently remove @Model.Name and all their records. This action cannot be undone.</p>

    <form asp-action="Delete" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div class="d-flex justify-content-between">
            <a asp-action="Index" asp-route-familyId="@Model.FamilyId" class="btn btn-outline-secondary rounded-pill px-4">
                <i class="fa-light fa-arrow-left me-1"></i> Cancel
            </a>
            <button type="submit" class="btn btn-danger rounded-pill px-4">
                <i class="fa-light fa-trash me-1"></i> Delete
            </button>
        </div>
    </form>
</div>
