@model IEnumerable<Hearthly.Data.Pet>

@{
    ViewData["Title"] = "Pets";
    var today = DateTime.Today;
}

<div class="mb-4 d-flex justify-content-between align-items-center">
    <h2 class="mb-0"><i class="fa-light fa-paw me-2"></i>Pets</h2>
    <a asp-action="Create" class="btn btn-primary btn-sm rounded-pill px-3">
        <i class="fa-light fa-plus me-1"></i> Add a Pet
    </a>
</div>

@if (!Model.Any())
{
    <div class="glass-card text-center py-5">
        <i class="fa-light fa-paw fa-3x text-muted mb-3 d-block"></i>
        <p class="text-muted mb-3">No pets added yet.</p>
        <a asp-action="Create" class="btn btn-primary btn-sm rounded-pill px-3">
            <i class="fa-light fa-plus me-1"></i> Add Your First Pet
        </a>
    </div>
}

<div class="row g-3">
    @foreach (var pet in Model)
    {
        DateTime? nextDate;
        string label;
        int? countYears;

        if (!pet.IsDeceased)
        {
            if (pet.BirthDate.HasValue)
            {
                var bdThisYear = new DateTime(today.Year, pet.BirthDate.Value.Month, pet.BirthDate.Value.Day);
                nextDate = bdThisYear < today ? bdThisYear.AddYears(1) : bdThisYear;
                label = "birthday";
                countYears = nextDate.Value.Year - pet.BirthDate.Value.Year;
            }
            else { nextDate = null; label = "birthday"; countYears = null; }
        }
        else
        {
            if (pet.DateOfDeath.HasValue)
            {
                var adThisYear = new DateTime(today.Year, pet.DateOfDeath.Value.Month, pet.DateOfDeath.Value.Day);
                nextDate = adThisYear < today ? adThisYear.AddYears(1) : adThisYear;
                label = "anniversary";
                countYears = nextDate.Value.Year - pet.DateOfDeath.Value.Year;
            }
            else { nextDate = null; label = "anniversary"; countYears = null; }
        }

        var daysUntil = nextDate.HasValue ? (nextDate.Value - today).Days : (int?)null;
        var isDeceased = pet.IsDeceased;

        <div class="col-6 col-md-4 col-lg-3">
            <a asp-action="Details" asp-route-id="@pet.Id" class="text-decoration-none">
                <div class="glass-card text-center p-3 h-100 @(isDeceased ? "opacity-75" : "")">
                    @if (!string.IsNullOrEmpty(pet.PhotoPath))
                    {
                        <img src="@pet.PhotoPath" alt="@pet.Name"
                             class="rounded-circle mb-3"
                             style="width:96px;height:96px;object-fit:cover;border:2.5px solid rgba(255,255,255,.15);" />
                    }
                    else
                    {
                        <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center mx-auto mb-3"
                             style="width:96px;height:96px;font-size:2rem;">
                            <i class="fa-light fa-paw"></i>
                        </div>
                    }

                    <h6 class="fw-semibold mb-1">@pet.Name</h6>

                    @if (isDeceased)
                    {
                        <small class="text-muted"><i class="fa-light fa-heart me-1"></i>Remembered</small>
                    }
                    else if (daysUntil.HasValue && countYears.HasValue)
                    {
                        <small class="text-muted">
                            @label in <strong>@daysUntil</strong> day@(daysUntil == 1 ? "" : "s")
                        </small>
                    }
                </div>
            </a>
        </div>
    }
</div>
