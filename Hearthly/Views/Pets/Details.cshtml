@model Hearthly.Data.Pet

@{
    ViewData["Title"] = $"{Model.Name}";
    var pet = Model;
    bool hasPhoto = !string.IsNullOrEmpty(pet.PhotoPath);
}

<!-- Header Card -->
<div class="glass-card p-4 mb-4">
    <div class="d-flex flex-column flex-md-row align-items-center gap-4">
        <!-- Profile Photo -->
        <div class="text-center">
            @if (hasPhoto)
            {
                <a href="#" data-bs-toggle="modal" data-bs-target="#photoModal">
                    <img src="@Url.Content(pet.PhotoPath)"
                         alt="@pet.Name"
                         class="rounded-circle shadow-sm"
                         style="width: 140px; height: 140px; object-fit: cover; cursor: pointer;" />
                </a>
            }
            else
            {
                <div class="rounded-circle d-flex align-items-center justify-content-center"
                     style="width:140px;height:140px;background:rgba(255,255,255,.08);">
                    <i class="fa-light fa-paw fa-3x text-muted"></i>
                </div>
            }
        </div>

        <!-- Name and Tag -->
        <div class="text-center text-md-start">
            <h2 class="mb-1">@pet.Name</h2>
            <p class="text-muted mb-0">Pet Profile</p>
        </div>
    </div>
</div>

<!-- Details Card -->
<div class="glass-card p-4 mb-4">
    <div class="row gy-3">
        <div class="col-6 col-md-4">
            <div class="text-muted small">Species</div>
            <div>@(pet.Species ?? "-")</div>
        </div>
        <div class="col-6 col-md-4">
            <div class="text-muted small">Breed</div>
            <div>@(pet.Breed ?? "-")</div>
        </div>
        <div class="col-6 col-md-4">
            <div class="text-muted small">Family</div>
            <div>@(pet.Family?.Name ?? "-")</div>
        </div>
        <div class="col-6 col-md-4">
            <div class="text-muted small">Birth Date</div>
            <div>@(pet.BirthDate?.ToString("dd MMMM yyyy") ?? "-")</div>
        </div>
        <div class="col-6 col-md-4">
            <div class="text-muted small">Age</div>
            <div>
                @if (pet.IsDeceased)
                {
                    @pet.FinalAge
                }
                else if (pet.BirthDate.HasValue)
                {
                    var today = DateTime.Today;
                    var birth = pet.BirthDate.Value;
                    int years = today.Year - birth.Year;
                    int months = today.Month - birth.Month;
                    if (today.Day < birth.Day) months--;
                    if (months < 0) { years--; months += 12; }
                    var yearPart  = years  > 0 ? $"{years} yr{(years == 1 ? "" : "s")}" : "";
                    var monthPart = months > 0 ? $"{months} mo" : "";
                    var ageDisplay = string.Join(", ", new[] { yearPart, monthPart }.Where(s => !string.IsNullOrEmpty(s)));
                    @(string.IsNullOrEmpty(ageDisplay) ? "< 1 month" : ageDisplay)
                }
                else { <text>-</text> }
            </div>
        </div>
        <div class="col-6 col-md-4">
            <div class="text-muted small">Last Weight</div>
            <div>@(pet.LastWeightKg.HasValue ? $"{pet.LastWeightKg.Value:0.##} kg" : "-")</div>
        </div>

        <div class="col-6 col-md-4">
            <div class="text-muted small">Last Weighed</div>
            <div>@(pet.LastWeighedDate?.ToString("dd MMM yyyy") ?? "-")</div>
        </div>
        <div class="col-6 col-md-4">
            <div class="text-muted small">Last Deworming</div>
            <div>@(pet.LastDewormingDate?.ToString("dd MMM yyyy") ?? "-")</div>
        </div>
        <div class="col-6 col-md-4">
            <div class="text-muted small">Last Tick/Flea</div>
            <div>@(pet.LastTickFleaDate?.ToString("dd MMM yyyy") ?? "-")</div>
        </div>
        <div class="col-6 col-md-4">
            <div class="text-muted small">Last Grooming</div>
            <div>@(pet.LastGroomingDate?.ToString("dd MMM yyyy") ?? "-")</div>
        </div>
        <div class="col-6 col-md-4">
            <div class="text-muted small">Last Checkup</div>
            <div>@(pet.LastCheckupDate?.ToString("dd MMM yyyy") ?? "-")</div>
        </div>
        <div class="col-6 col-md-4">
            <div class="text-muted small">Insurance</div>
            <div>
                @if (pet.HasInsurance)
                {
                    <span class="badge bg-success">Yes</span>
                    @if (!string.IsNullOrWhiteSpace(pet.InsuranceNumber))
                    {
                        <span class="ms-2 small">@pet.InsuranceNumber</span>
                    }
                }
                else
                {
                    <span class="text-muted">None</span>
                }
            </div>
        </div>
        <div class="col-6 col-md-4">
            <div class="text-muted small">Microchipped</div>
            <div>
                @if (pet.IsMicrochipped)
                {
                    <span class="badge bg-info text-dark">Yes</span>
                    @if (!string.IsNullOrWhiteSpace(pet.MicrochipNumber))
                    {
                        <span class="ms-2 small">@pet.MicrochipNumber</span>
                    }
                }
                else
                {
                    <span class="text-muted">No</span>
                }
            </div>
        </div>

        @if (pet.IsDeceased)
        {
            <div class="col-6 col-md-4">
                <div class="text-muted small">Date of Death</div>
                <div>@(pet.DateOfDeath?.ToString("dd MMMM yyyy") ?? "-")</div>
            </div>
            <div class="col-6 col-md-4">
                <div class="text-muted small">Final Age</div>
                <div>@pet.FinalAge</div>
            </div>
        }
    </div>
</div>

@if (!pet.IsDeceased)
{
    <!-- Care Log Section -->
    <div class="glass-card p-4 mb-4">
        <h5 class="mb-3 fw-semibold"><i class="fa-light fa-calendar-medical me-2"></i>Log Care Today</h5>
        <div class="row g-2" id="careButtons">
            @{
                var careItems = new (string Label, string Icon, DateTime? LastDate)[]
                {
                    ("Deworming",   "fa-capsules",     pet.LastDewormingDate),
                    ("Tick & Flea", "fa-bug",          pet.LastTickFleaDate),
                    ("Grooming",    "fa-scissors",     pet.LastGroomingDate),
                    ("Checkup",     "fa-stethoscope",  pet.LastCheckupDate),
                };
            }
            @foreach (var (label, icon, lastDate) in careItems)
            {
                <div class="col-6 col-md-3">
                    <button type="button"
                            class="btn btn-outline-secondary w-100 text-start px-3 py-2 care-log-btn"
                            data-care="@label"
                            data-pet="@pet.Id"
                            onclick="logCare('@pet.Id', '@label', this)">
                        <i class="fa-light @icon me-2"></i>
                        <span class="fw-semibold d-block small">@label</span>
                        @if (lastDate.HasValue)
                        {
                            <span class="text-muted" style="font-size:.7rem;">Last: @lastDate.Value.ToString("dd MMM")</span>
                        }
                        else
                        {
                            <span class="text-muted" style="font-size:.7rem;">Never recorded</span>
                        }
                    </button>
                </div>
            }
        </div>
    </div>
}

<!-- Action Buttons -->
<div class="d-flex justify-content-center flex-wrap gap-2 mt-4 mb-4">
    <a asp-action="Edit" asp-route-id="@pet.Id" asp-route-familyId="@pet.FamilyId" class="btn btn-outline-primary rounded-pill px-4">
        <i class="fa-light fa-pen-to-square me-1"></i> Edit
    </a>
    <a asp-action="Index" asp-route-familyId="@pet.FamilyId" class="btn btn-outline-secondary rounded-pill px-4">
        <i class="fa-light fa-arrow-left me-1"></i> Back
    </a>
    <form id="deleteForm" asp-action="Delete" method="post" class="d-inline-block">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <button type="button" class="btn btn-outline-danger rounded-pill px-4" onclick="confirmDelete()">
            <i class="fa-light fa-trash me-1"></i> Delete
        </button>
    </form>
</div>

@section Scripts {
    <script>
        const _petName = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(pet.Name));
        function confirmDelete() {
            Swal.fire({
                titleText: `Delete ${_petName}?`,
                text: "This action cannot be undone.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, delete',
                confirmButtonColor: '#dc3545',
                cancelButtonText: 'Cancel',
                reverseButtons: true
            }).then(result => {
                if (result.isConfirmed) document.getElementById('deleteForm').submit();
            });
        }

        async function logCare(petId, careType, btn) {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            btn.disabled = true;

            try {
                const resp = await fetch('/Pets/LogCare', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: new URLSearchParams({ id: petId, careType, __RequestVerificationToken: token })
                });
                const data = await resp.json();

                if (data.success) {
                    const small = btn.querySelector('.text-muted');
                    if (small) small.textContent = 'Last: ' + data.dateStr;
                    btn.classList.remove('btn-outline-secondary');
                    btn.classList.add('btn-outline-success');
                    Swal.fire({ titleText: careType + ' logged!', icon: 'success', toast: true, position: 'top-end', timer: 2000, showConfirmButton: false });
                } else {
                    btn.disabled = false;
                    Swal.fire({ title: 'Error', text: data.message ?? 'Could not log care.', icon: 'error', confirmButtonText: 'OK' });
                }
            } catch {
                btn.disabled = false;
                Swal.fire({ title: 'Error', text: 'Something went wrong.', icon: 'error', confirmButtonText: 'OK' });
            }
        }
    </script>
}

@if (!string.IsNullOrEmpty(pet.PhotoPath))
{
    <!-- Modal for Enlarged Pet Photo -->
    <div class="modal fade" id="photoModal" tabindex="-1" aria-labelledby="photoModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content bg-transparent border-0">
                <div class="modal-body text-center p-0">
                    <button type="button" class="btn-close btn-close-white position-absolute top-0 end-0 m-2"
                            data-bs-dismiss="modal" aria-label="Close"></button>
                    <img src="@Url.Content(pet.PhotoPath)"
                         alt="@pet.Name large"
                         class="img-fluid rounded" />
                </div>
            </div>
        </div>
    </div>
}

