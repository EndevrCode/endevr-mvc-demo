@model Hearthly.Data.UserProfile

@{
    ViewData["Title"] = "View Profile";
}

<div class="mb-4">
    <h2 class="mb-0"><i class="fa-light fa-user me-2"></i>@ViewData["Title"]</h2>
</div>

<div class="row">
    <div class="col-md-4 text-center">
        <img src="@(Model.ProfilePictureUrl)"
             alt="Profile photo"
             class="rounded-circle mb-3"
             style="width:150px;height:150px;object-fit:cover;" />
    </div>

    <div class="col-md-8">
        <dl class="row">
            <dt class="col-sm-4">First Name</dt>
            <dd class="col-sm-8">@Model.FirstName</dd>

            <dt class="col-sm-4">Last Name</dt>
            <dd class="col-sm-8">@Model.LastName</dd>

            <dt class="col-sm-4">Preferred Name</dt>
            <dd class="col-sm-8">@Model.PreferredName</dd>

            <dt class="col-sm-4">Birth Date</dt>
            <dd class="col-sm-8">
                @(Model.BirthDate.HasValue
                                ? Model.BirthDate.Value.ToString("dd MMMM yyyy")
                                : "-")
            </dd>

            <dt class="col-sm-4">ID Number</dt>
            <dd class="col-sm-8">@Model.IdNumber</dd>

            <dt class="col-sm-4">Phone Number</dt>
            <dd class="col-sm-8">@Model.PhoneNumber</dd>

            <dt class="col-sm-4">Address</dt>
            <dd class="col-sm-8">@Model.Address</dd>
        </dl>
        <button type="button"
                class="btn btn-secondary"
                onclick="history.back();">
            ← Back to Family Details
        </button>
    </div>
</div>
