@model Hearthly.Data.Bill

@{
    ViewData["Title"] = "Add Bill";
    var familyId = ViewData["FamilyId"] as Guid? ?? Guid.Empty;
}

<h2 class="mb-4"><i class="fa-light fa-file-invoice-dollar me-2"></i>Add Bill</h2>

<div class="glass-card p-4" style="max-width:560px;">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="FamilyId" />

        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" placeholder="e.g. Electricity, Rent, DSTV" />
            <span asp-validation-for="Name" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Category" class="form-label"></label>
            <input asp-for="Category" class="form-control" list="category-suggestions" placeholder="e.g. Utilities, Insurance" />
            <datalist id="category-suggestions">
                <option value="Utilities" />
                <option value="Insurance" />
                <option value="Rent / Bond" />
                <option value="Subscriptions" />
                <option value="Internet" />
                <option value="Municipal" />
                <option value="Medical Aid" />
            </datalist>
        </div>

        <div class="row g-3 mb-3">
            <div class="col">
                <label asp-for="Amount" class="form-label"></label>
                <div class="input-group">
                    <span class="input-group-text">R</span>
                    <input asp-for="Amount" class="form-control" type="number" step="0.01" min="0" />
                </div>
                <span asp-validation-for="Amount" class="text-danger small"></span>
            </div>
            <div class="col">
                <label asp-for="DueDate" class="form-label"></label>
                <input asp-for="DueDate" class="form-control" type="date" />
                <span asp-validation-for="DueDate" class="text-danger small"></span>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Notes" class="form-label"></label>
            <textarea asp-for="Notes" class="form-control" rows="2" placeholder="Optional notes"></textarea>
        </div>

        <div class="form-check mb-4">
            <input asp-for="IsRecurring" class="form-check-input" />
            <label asp-for="IsRecurring" class="form-check-label">Recurring monthly</label>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary rounded-pill px-4"><i class="fa-light fa-plus me-1"></i> Add Bill</button>
            <a asp-action="Index" asp-route-familyId="@familyId" class="btn btn-outline-secondary rounded-pill px-4">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
