@model Hearthly.Data.Bill

@{
    ViewData["Title"] = "Delete Bill";
    var familyId = ViewData["FamilyId"] as Guid? ?? Guid.Empty;
}

<h2 class="mb-4 text-danger"><i class="bi bi-trash me-2"></i>Delete Bill</h2>

<div class="glass-card p-4" style="max-width:480px;">
    <p>Are you sure you want to delete this bill?</p>
    <div class="mb-3">
        <strong>@Model.Name</strong><br />
        <span class="text-muted">R @Model.Amount.ToString("N2") — Due @Model.DueDate.ToString("dd MMM yyyy")</span>
    </div>
    <form asp-action="Delete" asp-route-id="@Model.Id" asp-route-familyId="@familyId" method="post">
        @Html.AntiForgeryToken()
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Delete</button>
            <a asp-action="Index" asp-route-familyId="@familyId" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>
