@model Hearthly.Data.Bill

@{
    ViewData["Title"] = "Delete Bill";
    var familyId = ViewData["FamilyId"] as Guid? ?? Guid.Empty;
}

<h2 class="mb-4 text-danger"><i class="fa-light fa-trash me-2"></i>Delete Bill</h2>

<div class="glass-card p-4" style="max-width:480px;">
    <p>Are you sure you want to delete this bill?</p>
    <div class="mb-3">
        <strong>@Model.Name</strong><br />
        <span class="text-muted">R @Model.Amount.ToString("N2") — Due @Model.DueDate.ToString("dd MMM yyyy")</span>
    </div>
    <form asp-action="Delete" asp-route-id="@Model.Id" asp-route-familyId="@familyId" method="post">
        @Html.AntiForgeryToken()
        <div class="d-flex justify-content-between gap-2">
            <a asp-action="Index" asp-route-familyId="@familyId"
               class="btn btn-outline-secondary rounded-pill px-4 flex-grow-1">
                <i class="fa-light fa-arrow-left me-1"></i> Cancel
            </a>
            <button type="submit" class="btn btn-danger rounded-pill px-4 flex-grow-1">
                <i class="fa-light fa-trash me-1"></i> Delete
            </button>
        </div>
    </form>
</div>
