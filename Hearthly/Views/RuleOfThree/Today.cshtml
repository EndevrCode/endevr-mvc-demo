@model Hearthly.Data.RuleOfThree.RuleOfThreeEntry

@{
    var readOnly = ViewData["ReadOnly"] as bool? == true;
    ViewData["Title"] = "Today's Rule of 3";
    Layout = "_Layout";
    var familyId = ViewData["FamilyId"];
    var tasks = Model.Tasks ?? new List<Hearthly.Data.RuleOfThree.RuleOfThreeTask>();
    var allTasksDone = tasks.Count == 6 && tasks.All(t => t.IsDone);
}

<div class="mb-4 d-flex justify-content-between align-items-center">
    <h2 class="mb-0">
        <i class="fa-light fa-calendar-check me-2"></i>Today's Plan
    </h2>
    @if (Model.IsComplete)
    {
        <span class="badge bg-success ms-2 align-middle">
            <i class="fa-light fa-circle-check me-1"></i> Completed
        </span>
    }
</div>

@if (!Model.IsComplete && !readOnly)
{
    if (allTasksDone)
    {
        <form asp-action="MarkComplete" asp-controller="RuleOfThree" method="post" class="mb-4">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <input type="hidden" name="familyId" value="@familyId" />
            <button type="submit" class="btn btn-success rounded-pill w-100 py-2">
                <i class="fa-light fa-circle-check me-1"></i> Mark Today as Done
            </button>
        </form>
    }
    else
    {
        <div class="glass-card p-3 mb-4 text-center text-muted small">
            <i class="fa-light fa-circle-info me-1"></i>
            Complete all 6 tasks to unlock the "Mark Today as Done" button.
        </div>
    }
}

@if (Model.IsComplete)
{
    <div id="completion-animation" class="d-flex justify-content-center mb-4">
        <svg class="checkmark" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 52 52">
            <circle class="checkmark-circle" cx="26" cy="26" r="25" fill="none" />
            <path class="checkmark-check" fill="none" d="M14 27l7 7 16-16" />
        </svg>
    </div>
}

<form asp-action="Submit" method="post" @(readOnly ? "onsubmit=\"return false;\"" : "")>
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Date" />
    <input type="hidden" asp-for="UserId" />
    <input type="hidden" asp-for="Id" />
    <input type="hidden" name="familyId" value="@familyId" />
    @if (!readOnly)
    {
        <div asp-validation-summary="All" class="alert alert-danger"></div>
    }

    <!-- Main Project -->
    <div class="glass-card p-4 mb-3">
        <label asp-for="MainProject" class="form-label fw-semibold">
            <i class="fa-light fa-brain me-1"></i> 3-Hour Main Project
        </label>
        <input asp-for="MainProject" class="form-control"
               placeholder="What is your most important task today?"
               @(readOnly ? "readonly" : "") />
    </div>

    <!-- Short Tasks -->
    <div class="glass-card p-4 mb-3">
        <label class="form-label fw-semibold">
            <i class="fa-light fa-circle-check me-1"></i> 3 Short Tasks
        </label>
        @for (int i = 0; i < 3; i++)
        {
            var task = tasks.ElementAtOrDefault(i);
            <div class="input-group mb-2">
                <div class="input-group-text">
                    <input type="checkbox"
                           name="Tasks[@i].IsDone"
                           class="form-check-input mt-0"
                           value="true"
                           @(task?.IsDone == true ? "checked" : "")
                           @(readOnly ? "disabled" : "") />
                    <input type="hidden" name="Tasks[@i].IsDone" value="false" />
                </div>
                <input name="Tasks[@i].Description"
                       value="@task?.Description"
                       class="form-control"
                       placeholder="Short task @(i + 1)"
                       @(readOnly ? "readonly" : "") />
                <input type="hidden" name="Tasks[@i].TaskType" value="1" />
                <input type="hidden" name="Tasks[@i].Id" value="@task?.Id" />
            </div>
        }
    </div>

    <!-- Maintenance Tasks -->
    <div class="glass-card p-4 mb-3">
        <label class="form-label fw-semibold">
            <i class="fa-light fa-wrench me-1"></i> 3 Maintenance Tasks
        </label>
        @for (int i = 0; i < 3; i++)
        {
            var index = i + 3;
            var task = tasks.ElementAtOrDefault(index);
            <div class="input-group mb-2">
                <div class="input-group-text">
                    <input type="checkbox"
                           name="Tasks[@index].IsDone"
                           class="form-check-input mt-0"
                           value="true"
                           @(task?.IsDone == true ? "checked" : "")
                           @(readOnly ? "disabled" : "") />
                    <input type="hidden" name="Tasks[@index].IsDone" value="false" />
                </div>
                <input name="Tasks[@index].Description"
                       value="@task?.Description"
                       class="form-control"
                       placeholder="Maintenance task @(i + 1)"
                       @(readOnly ? "readonly" : "") />
                <input type="hidden" name="Tasks[@index].TaskType" value="2" />
                <input type="hidden" name="Tasks[@index].Id" value="@task?.Id" />
            </div>
        }
    </div>

    <!-- Power Day toggle -->
    <div class="glass-card p-3 mb-4">
        <div class="form-check">
            @if (readOnly)
            {
                <input asp-for="IsPowerDay" class="form-check-input" disabled />
            }
            else
            {
                <input asp-for="IsPowerDay" class="form-check-input" />
            }
            <label asp-for="IsPowerDay" class="form-check-label fw-semibold">
                Power Day <i class="fa-light fa-bolt ms-1 text-warning"></i>
            </label>
        </div>
    </div>

    @if (!readOnly)
    {
        <button type="submit" class="btn btn-primary w-100 rounded-pill py-2">
            <i class="fa-light fa-floppy-disk me-1"></i> Save Plan
        </button>
    }
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
