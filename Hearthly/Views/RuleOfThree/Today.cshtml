@model Hearthly.Data.RuleOfThree.RuleOfThreeEntry

@{
    var readOnly = ViewData["ReadOnly"] as bool? == true;
    ViewData["Title"] = "Today's Rule of 3";
    var hasEntry = Model != null && Model.Id != Guid.Empty;
    Layout = "_Layout";
    var familyId = ViewData["FamilyId"];
}

<h2 class="mb-4 text-center" style="padding-top: 1.5rem;">
    Today’s Plan

    @if (Model.IsComplete)
    {
        <span class="badge bg-success ms-2 align-middle">
            <i class="fa-light fa-circle-check me-1"></i> Completed
        </span>
    }

    @{
        var allTasksDone = Model.Tasks != null && Model.Tasks.Count == 6 && Model.Tasks.All(t => t.IsDone);
    }

    @if (!Model.IsComplete && !readOnly)
    {
        if (allTasksDone)
        {
            <form asp-action="MarkComplete" asp-controller="RuleOfThree" method="post" class="text-center mt-3">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <input type="hidden" name="familyId" value="@familyId" />
                <button type="submit" class="btn btn-success btn-lg rounded-pill px-4">
                    <i class="fa-light fa-circle-check me-1"></i> Mark Today as Done
                </button>
            </form>
        }
        else
        {
            <div class="alert alert-info text-center mt-3" role="alert">
                <i class="bi bi-info-circle me-1"></i>
                Complete all 6 tasks to enable the "Mark Done" button.
            </div>
        }
    }
</h2>

<form asp-action="Submit" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Date" />
    <input type="hidden" asp-for="UserId" />
    <input type="hidden" asp-for="Id" />
    <input type="hidden" name="familyId" value="@familyId" />
    <div asp-validation-summary="All" class="alert alert-danger"></div>

    <div class="mb-4">
        <label asp-for="MainProject" class="form-label fw-bold"><i class="fa-light fa-brain me-1"></i> 3-Hour Main Project</label>
        @if (readOnly)
        {
            <input asp-for="MainProject" class="form-control" readonly />
        }
        else
        {
            <input asp-for="MainProject" class="form-control" placeholder="What is your most important task today?" />
        }

        <div class="mt-2">
            <button type="button" class="btn btn-outline-secondary w-100" id="startTimerBtn" disabled="@readOnly">
                <i class="fa-light fa-timer me-1"></i> Start 3-Hour Timer (Coming Soon)
            </button>
        </div>
    </div>

    <!-- Short Tasks -->
    <div class="mb-3">
        <label class="form-label fw-bold"><i class="fa-light fa-circle-check me-1"></i> 3 Short Tasks</label>
        @for (int i = 0; i < 3; i++)
        {
            var task = Model.Tasks.ElementAtOrDefault(i);
            <div class="input-group mb-2">
                <div class="input-group-text">
                    <input type="checkbox"
                           name="Tasks[@i].IsDone"
                           class="form-check-input mt-0"
                           value="true"
                           @(task?.IsDone == true ? "checked" : "")
                           @(readOnly ? "disabled" : "") />
                    <input type="hidden" name="Tasks[@i].IsDone" value="false" />
                </div>
                <input name="Tasks[@i].Description"
                       value="@task?.Description"
                       class="form-control"
                       placeholder="Short task @(i + 1)"
                       @(readOnly ? "readonly" : "") />
                <input type="hidden" name="Tasks[@i].TaskType" value="1" />
                <input type="hidden" name="Tasks[@i].Id" value="@task?.Id" />
            </div>
        }
    </div>

    <!-- Maintenance Tasks -->
    <div class="mb-3">
        <label class="form-label fw-bold"><i class="fa-light fa-wrench me-1"></i> 3 Maintenance Tasks</label>
        @for (int i = 0; i < 3; i++)
        {
            var index = i + 3;
            var task = Model.Tasks.ElementAtOrDefault(index);
            <div class="input-group mb-2">
                <div class="input-group-text">
                    <input type="checkbox"
                           name="Tasks[@index].IsDone"
                           class="form-check-input mt-0"
                           value="true"
                           @(task?.IsDone == true ? "checked" : "")
                           @(readOnly ? "disabled" : "") />
                    <input type="hidden" name="Tasks[@index].IsDone" value="false" />
                </div>
                <input name="Tasks[@index].Description"
                       value="@task?.Description"
                       class="form-control"
                       placeholder="Maintenance task @(i + 1)"
                       @(readOnly ? "readonly" : "") />
                <input type="hidden" name="Tasks[@index].TaskType" value="2" />
                <input type="hidden" name="Tasks[@index].Id" value="@task?.Id" />
            </div>
        }
    </div>

    <div class="form-check mb-4">
        @if (readOnly)
        {
            <input asp-for="IsPowerDay" class="form-check-input" disabled />
        }
        else
        {
            <input asp-for="IsPowerDay" class="form-check-input" />
        }
        <label asp-for="IsPowerDay" class="form-check-label">Power Day <i class="fa-light fa-bolt ms-1 text-warning"></i></label>
    </div>

    @if (!readOnly)
    {
        <button type="submit" class="btn btn-primary w-100 rounded-pill py-2">Save Plan</button>
    }

    @if (Model.IsComplete)
    {
        <div id="completion-animation" class="d-flex justify-content-center mb-4">
            <svg class="checkmark" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 52 52">
                <circle class="checkmark-circle" cx="26" cy="26" r="25" fill="none" />
                <path class="checkmark-check" fill="none" d="M14 27l7 7 16-16" />
            </svg>
        </div>
    }
</form>

@section Scripts {
    <script>
        // Future enhancement: Hook this up to an actual timer
        document.getElementById("startTimerBtn")?.addEventListener("click", function () {
            Swal.fire({ title: "Timer Starting", text: "Your timer is about to begin!", icon: "info", timer: 2000, showConfirmButton: false });
        });
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
