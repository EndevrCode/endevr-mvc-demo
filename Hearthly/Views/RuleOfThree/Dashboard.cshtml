@model Hearthly.Models.RuleOfThree.RuleOfThreeDashboardViewModel
@{
    ViewData["Title"] = "This Week";
}

<div class="position-relative text-center mb-3">
    <h2 class="mb-0">Your Week's Progress</h2>
    <button type="button"
            class="btn info-button position-absolute top-0 end-0 me-1 mt-1"
            data-bs-toggle="modal"
            data-bs-target="#ruleOfThreeHelpModal"
            title="How it works">
        <i class="fa-light fa-circle-info"></i>
    </button>
</div>


    <div class="mb-3 d-flex gap-2 justify-content-center">
        <a asp-action="Today" asp-route-familyId="@ViewData["FamilyId"]" class="btn btn-outline-primary">
            <i class="fa-light fa-calendar-check me-1"></i> Today’s Plan
        </a>
        <a asp-action="Today" asp-route-familyId="@ViewData["FamilyId"]" class="btn btn-outline-secondary">
            <i class="fa-light fa-mug-hot me-1"></i> Weekend Mode
        </a>
    </div>

    <!-- Refined Today Section -->
    <div class="mb-4 glass-card p-3 text-center">
        <h5 class="text-center mb-3">@Model.Today.ToString("dddd, dd MMMM")</h5>

        @if (Model.IsTodayComplete)
        {
            <span class="badge bg-success mb-2">
                <i class="fa-light fa-circle-check me-1"></i>Completed
            </span>
        }
        else
        {
            <span class="badge bg-warning text-dark mb-2">
                <i class="fa-light fa-hourglass-half me-1"></i>Still in progress
            </span>

            <form asp-action="MarkComplete" asp-controller="RuleOfThree" method="post" class="mb-3 d-grid">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.ThisWeekEntries.FirstOrDefault(e => e.Date == Model.Today)?.Id" />
                <input type="hidden" name="familyId" value="@ViewData["FamilyId"]" />
                <button type="submit" class="btn btn-success">
                    <i class="fa-light fa-circle-check"></i> Mark Today's Entry as Done
                </button>
            </form>
        }

        @{
            var percent = Model.DailyProgressPercent;
            var fillClass = (percent < 50) ? "low"
            : (percent < 100) ? "mid"
            : "high";
        }
        <div class="daily-progress-wrapper mt-2 px-2 text-center">
            <h6 class="mb-1">Daily Progress</h6>
            <div class="progress daily-progress-bar @fillClass"
                 role="progressbar"
                 style="--progress: @percent%;"
                 aria-valuenow="@percent"
                 aria-valuemin="0"
                 aria-valuemax="100">
                <div class="progress-fill">
                    @percent%
                </div>
            </div>
        </div>
    </div>

    <div class="mb-4 text-center">
        @{
            var totalDays = 7;
            var completedDays = Model.ThisWeekEntries.Count(e => e.IsComplete);
            var percentage = (int)Math.Round((double)completedDays / totalDays * 100);
        }

        <svg width="120" height="120" viewBox="0 0 36 36" class="circular-chart text-primary">
            <path class="circle-bg"
                  stroke="#eee"
                  stroke-width="3.8"
                  fill="none"
                  d="M18 2.0845
                 a 15.9155 15.9155 0 0 1 0 31.831
                 a 15.9155 15.9155 0 0 1 0 -31.831" />
            <path class="circle"
                  stroke="currentColor"
                  stroke-width="3.8"
                  stroke-dasharray="@percentage, 100"
                  stroke-linecap="round"
                  fill="none"
                  d="M18 2.0845
                 a 15.9155 15.9155 0 0 1 0 31.831
                 a 15.9155 15.9155 0 0 1 0 -31.831" />
            <text x="18" y="20.35" class="percentage" text-anchor="middle" alignment-baseline="middle" font-size="6">@percentage%</text>
        </svg>

        <div class="text-center mb-4">
            <strong>Current Streak:</strong>
            <span class="badge bg-primary ms-1">@Model.CurrentStreak days</span>
        </div>
    </div>

    <hr />

    <h5 class="mb-3">This Week's Entries</h5>
    <div class="list-group">
        @foreach (var entry in Model.ThisWeekEntries)
        {
            <a asp-controller="RuleOfThree" asp-action="ViewEntry" asp-route-date="@entry.Date.ToString("yyyy-MM-dd")" asp-route-familyId="@ViewData["FamilyId"]" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                <div>
                    <strong>@entry.Date.ToString("dddd")</strong>
                    <br />
                    <small class="text-muted">@entry.Date.ToString("dd MMM")</small>
                </div>
                @if (entry.IsComplete)
                {
                    <span class="badge bg-success"><i class="fa-light fa-circle-check me-1"></i>Done</span>
                }
                else if (entry.Tasks.Any() && entry.Tasks.All(t => !t.IsDone))
                {
                    <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>Incomplete</span>
                }
                else
                {
                    <span class="badge bg-secondary"><i class="bi bi-circle me-1"></i>Pending</span>
                }
            </a>
        }
    </div>
</div>

<!-- Rule of 3 Help Modal -->
<div class="modal fade" id="ruleOfThreeHelpModal" tabindex="-1" aria-labelledby="ruleOfThreeHelpModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow-lg">
            <div class="modal-header border-bottom-0">
                <h5 class="modal-title fw-bold text-center w-100" id="ruleOfThreeHelpModalLabel">
                    <i class="fa-light fa-circle-info me-2 text-primary"></i>How This Section Works
                </h5>
                <button type="button" class="btn-close position-absolute end-0 me-3" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center px-4 pb-4">
                <p class="mb-3">
                    The <strong>Rule of Three</strong> helps you stay productive by focusing on:
                </p>
                <ul class="list-unstyled mb-4">
                    <li><i class="bi bi-check-circle-fill text-success me-2"></i> One 3-hour Main Project</li>
                    <li><i class="bi bi-check-circle-fill text-success me-2"></i> Three Short Tasks</li>
                    <li><i class="bi bi-check-circle-fill text-success me-2"></i> Three Maintenance Tasks</li>
                </ul>

                <p class="mb-3">
                    Use this dashboard to track your weekly progress, complete tasks, and build streaks.
                </p>
                <div class="alert alert-info text-start mt-4 mx-auto" style="max-width: 400px;">
                    <strong>Tip:</strong> If you are a part of more than one family, you must <u>select a family</u> at the top to view and record entries.
                </div>
            </div>
        </div>
    </div>
</div>
