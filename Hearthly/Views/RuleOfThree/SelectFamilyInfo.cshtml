@{
    ViewData["Title"] = "Select a Family to Begin";
    Layout = "_Layout";
}

<div class="container mt-5">
    @await Component.InvokeAsync("FamilySelector")
</div>

<div class="info-card-container">
    <div class="info-card shadow-lg p-4 rounded position-relative">
        <h2 class="mb-3 text-center">
            <i class="fa-light fa-lightbulb text-primary me-2"></i>
            Welcome to the Rule of Three's
        </h2>

        <p>
            The <strong>Rule of Three's</strong> is a simple, powerful planning method to help you stay focused and productive.
            Each day, you set:
        </p>
        <ul>
            <li><strong>1 Main Project</strong> – Your highest priority task of the day</li>
            <li><strong>3 Short Tasks</strong> – Quick wins that keep you moving</li>
            <li><strong>3 Maintenance Tasks</strong> – Essential activities to sustain your routine</li>
        </ul>

        <p>
            Each task contributes to your daily progress. When all 6 are completed, you’ll earn a completion badge and boost your streak!
        </p>

        <div class="alert alert-warning mt-4" role="alert">
            <i class="fa-light fa-circle-exclamation me-1"></i>
            <strong>Please select a family</strong> using the dropdown at the top of the screen to begin tracking your Rule of Three plan.
        </div>

        <!-- Continue Button inside the card -->
        <div class="text-center mt-4">
            <a href="/RuleOfThree/Dashboard" class="btn btn-primary rounded-pill px-4 py-2 shadow">
                Continue
            </a>
        </div>
    </div>
</div>
