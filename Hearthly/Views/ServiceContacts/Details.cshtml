@model Hearthly.Data.ServiceContact

@{
    ViewData["Title"] = "Service Contact Details";
    var familyId = Model.FamilyId;
}

<h2 class="mb-4 mt-5">@ViewData["Title"]</h2> <!-- mt-5 pushes content down from top -->

<div class="card shadow-sm rounded-4 p-3 mb-4 text-center">
    <div class="mb-3">
        <small>Service Type</small>
        <div>@Model.ServiceType</div>
    </div>

    <div class="mb-3">
        <small>Company</small>
        <div>@Model.Company</div>
    </div>

    <div class="mb-3">
        <small>Contact Person</small>
        <div>@Model.ContactPerson</div>
    </div>

    <div class="mb-3">
        <small>Contact Number</small>
        <div>
            <a href="tel:@Model.ContactNumber">@Model.ContactNumber</a>
        </div>
    </div>

    <div class="mb-1">
        <small>Notes</small>
        <div>@Model.Notes</div>
    </div>
</div>

<!-- Centered buttons -->
<div class="d-flex justify-content-center flex-wrap gap-2">
    <a asp-action="Edit"
       asp-route-id="@Model.Id"
       asp-route-familyId="@familyId"
       class="btn btn-outline-primary rounded-pill">
        <i class="bi bi-pencil-square me-1"></i> Edit
    </a>

    <a asp-action="Index"
       asp-route-familyId="@familyId"
       class="btn btn-outline-secondary rounded-pill">
        <i class="bi bi-arrow-left me-1"></i> Back
    </a>

    <form asp-action="Delete"
          asp-route-id="@Model.Id"
          asp-route-familyId="@familyId"
          method="post"
          onsubmit="return confirm('Are you sure you want to delete this service contact?');"
          class="d-inline">
        <button type="submit" class="btn btn-outline-danger rounded-pill">
            <i class="bi bi-trash me-1"></i> Delete
        </button>
    </form>
</div>
