@model Hearthly.Data.ServiceContact

@{
    ViewData["Title"] = "Service Contact Details";
    var familyId = Model.FamilyId;
}

<div class="mb-4">
    <h2 class="mb-0"><i class="fa-light fa-address-book me-2"></i>@ViewData["Title"]</h2>
</div>

<div class="glass-card p-4 mb-4">
    <div class="row gy-3">
        <div class="col-md-6">
            <div class="text-muted small">Service Type</div>
            <div class="fw-semibold">@Model.ServiceType</div>
        </div>
        <div class="col-md-6">
            <div class="text-muted small">Company</div>
            <div class="fw-semibold">@Model.Company</div>
        </div>
        @if (!string.IsNullOrWhiteSpace(Model.ContactPerson))
        {
            <div class="col-md-6">
                <div class="text-muted small">Contact Person</div>
                <div>@Model.ContactPerson</div>
            </div>
        }
        <div class="col-md-6">
            <div class="text-muted small">Contact Number</div>
            <div>
                <a href="tel:@Model.ContactNumber" class="fw-semibold text-decoration-none">
                    <i class="fa-light fa-phone me-1 text-muted"></i>@Model.ContactNumber
                </a>
            </div>
        </div>
        @if (!string.IsNullOrWhiteSpace(Model.Notes))
        {
            <div class="col-12">
                <div class="text-muted small">Notes</div>
                <div>@Model.Notes</div>
            </div>
        }
    </div>
</div>

<!-- Centered buttons -->
<div class="d-flex justify-content-center flex-wrap gap-2">
    <a asp-action="Edit"
       asp-route-id="@Model.Id"
       asp-route-familyId="@familyId"
       class="btn btn-outline-primary rounded-pill px-4">
        <i class="fa-light fa-pen-to-square me-1"></i> Edit
    </a>

    <a asp-action="Index"
       asp-route-familyId="@familyId"
       class="btn btn-outline-secondary rounded-pill px-4">
        <i class="fa-light fa-arrow-left me-1"></i> Back
    </a>

    <form id="deleteForm" asp-action="Delete" asp-route-id="@Model.Id"
          asp-route-familyId="@familyId" method="post" class="d-inline">
        @Html.AntiForgeryToken()
        <button type="button" class="btn btn-outline-danger rounded-pill px-4" onclick="confirmDelete()">
            <i class="fa-light fa-trash me-1"></i> Delete
        </button>
    </form>
</div>

@section Scripts {
    <script>
        function confirmDelete() {
            Swal.fire({
                titleText: 'Delete Service Contact?',
                text: "This action cannot be undone.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, delete',
                confirmButtonColor: '#dc3545',
                cancelButtonText: 'Cancel',
                reverseButtons: true
            }).then(result => {
                if (result.isConfirmed) document.getElementById('deleteForm').submit();
            });
        }
    </script>
}
