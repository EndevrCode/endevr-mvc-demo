@model Hearthly.Data.ServiceContact

@{
    ViewData["Title"] = "Service Contact Details";
    var familyId = Model.FamilyId;
}

<div class="mb-4">
    <h2 class="mb-0"><i class="fa-light fa-address-book me-2"></i>@ViewData["Title"]</h2>
</div>

<div class="glass-card p-3 mb-4 text-center">
    <div class="mb-3">
        <small>Service Type</small>
        <div>@Model.ServiceType</div>
    </div>

    <div class="mb-3">
        <small>Company</small>
        <div>@Model.Company</div>
    </div>

    <div class="mb-3">
        <small>Contact Person</small>
        <div>@Model.ContactPerson</div>
    </div>

    <div class="mb-3">
        <small>Contact Number</small>
        <div>
            <a href="tel:@Model.ContactNumber">@Model.ContactNumber</a>
        </div>
    </div>

    <div class="mb-1">
        <small>Notes</small>
        <div>@Model.Notes</div>
    </div>
</div>

<!-- Centered buttons -->
<div class="d-flex justify-content-center flex-wrap gap-2">
    <a asp-action="Edit"
       asp-route-id="@Model.Id"
       asp-route-familyId="@familyId"
       class="btn btn-outline-primary rounded-pill">
        <i class="fa-light fa-pen-to-square me-1"></i> Edit
    </a>

    <a asp-action="Index"
       asp-route-familyId="@familyId"
       class="btn btn-outline-secondary rounded-pill">
        <i class="fa-light fa-arrow-left me-1"></i> Back
    </a>

    <form id="deleteForm" asp-action="Delete" asp-route-id="@Model.Id"
          asp-route-familyId="@familyId" method="post" class="d-inline">
        @Html.AntiForgeryToken()
        <button type="button" class="btn btn-outline-danger rounded-pill" onclick="confirmDelete()">
            <i class="fa-light fa-trash me-1"></i> Delete
        </button>
    </form>
</div>

@section Scripts {
    <script>
        function confirmDelete() {
            Swal.fire({
                title: 'Delete Service Contact?',
                text: "This action cannot be undone.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, delete',
                confirmButtonColor: '#dc3545',
                cancelButtonText: 'Cancel',
                reverseButtons: true
            }).then(result => {
                if (result.isConfirmed) document.getElementById('deleteForm').submit();
            });
        }
    </script>
}
