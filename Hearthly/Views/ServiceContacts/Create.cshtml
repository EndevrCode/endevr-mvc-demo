@model Hearthly.Data.ServiceContact
@using System.ComponentModel.DataAnnotations
@using System.Reflection
@using Hearthly.Data

@{
    ViewData["Title"] = "Create Service Contact";

    var serviceTypeList = Enum.GetValues(typeof(ServiceType))
        .Cast<ServiceType>()
        .Select(st => new SelectListItem
        {
            Value = st.ToString(),
            Text = st.GetType()
                     .GetMember(st.ToString())
                     .First()
                     .GetCustomAttribute<DisplayAttribute>()?.Name ?? st.ToString()
        }).ToList();

    serviceTypeList.Insert(0, new SelectListItem { Value = "", Text = "-- Select Service --" });
}

<h2>@ViewData["Title"]</h2>

<form id="serviceForm" asp-action="Create">
    <div asp-validation-summary="All" class="text-danger"></div>

    <input asp-for="FamilyId" type="hidden" />

    <div class="mb-3">
        <label asp-for="ServiceType" class="form-label"></label>
        <select asp-for="ServiceType" class="form-select" asp-items="serviceTypeList"></select>
        <span asp-validation-for="ServiceType" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Company" class="form-label"></label>
        <input asp-for="Company" class="form-control" />
        <span asp-validation-for="Company" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ContactPerson" class="form-label"></label>
        <input asp-for="ContactPerson" class="form-control" />
        <span asp-validation-for="ContactPerson" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ContactNumber" class="form-label"></label>
        <input asp-for="ContactNumber" type="tel" class="form-control" />
        <span asp-validation-for="ContactNumber" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Notes" class="form-label"></label>
        <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Notes" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" asp-route-familyId="@(Model.FamilyId)" class="btn btn-secondary ms-2">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('serviceForm').addEventListener('submit', async function (e) {
            if (!navigator.serviceWorker || !('SyncManager' in window)) return;

            e.preventDefault();

            const form = e.target;
            const data = {
                familyId: form.FamilyId.value,
                serviceType: form.ServiceType.value,
                company: form.Company.value,
                contactPerson: form.ContactPerson.value,
                contactNumber: form.ContactNumber.value,
                notes: form.Notes.value
            };

            const db = await openDB('Hearthly', 1, {
                upgrade(db) {
                    if (!db.objectStoreNames.contains('serviceContacts')) {
                        db.createObjectStore('serviceContacts', { autoIncrement: true });
                    }
                }
            });

            await db.add('serviceContacts', data);

            const reg = await navigator.serviceWorker.ready;
            await reg.sync.register('sync-serviceContacts');

            Swal.fire({ title: 'Saved Offline', text: 'Will sync automatically when back online.', icon: 'info', timer: 2500, showConfirmButton: false });
            window.location.href = '@Url.Action("Index", new { familyId = Model.FamilyId })';
        });

        async function openDB(name, version, { upgrade }) {
            return new Promise((resolve, reject) => {
                const req = indexedDB.open(name, version);
                req.onerror = () => reject(req.error);
                req.onupgradeneeded = () => upgrade(req.result);
                req.onsuccess = () => resolve(req.result);
            });
        }
    </script>
}
