@model Hearthly.Data.ServiceContact
@using System.ComponentModel.DataAnnotations
@using System.Reflection
@using Hearthly.Data

@{
    ViewData["Title"] = "Edit Service Contact";

    var serviceTypeList = Enum.GetValues(typeof(ServiceType))
        .Cast<ServiceType>()
        .Select(st => new SelectListItem
        {
            Value = st.ToString(),
            Text = st.GetType()
                     .GetMember(st.ToString())
                     .First()
                     .GetCustomAttribute<DisplayAttribute>()?.Name ?? st.ToString(),
            Selected = (st == Model.ServiceType)
        }).ToList();
}

<div class="mb-4">
    <h2 class="mb-0"><i class="fa-light fa-pen-to-square me-2"></i>Edit Service Contact</h2>
</div>

<div class="glass-card p-4 mx-auto" style="max-width: 500px;">
    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <input asp-for="Id" type="hidden" />
        <input asp-for="FamilyId" type="hidden" />

        <div class="mb-3">
            <label asp-for="ServiceType" class="form-label fw-semibold">Service Type</label>
            <select asp-for="ServiceType" class="form-select" asp-items="serviceTypeList"></select>
            <span asp-validation-for="ServiceType" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Company" class="form-label fw-semibold">Company</label>
            <input asp-for="Company" class="form-control" />
            <span asp-validation-for="Company" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ContactPerson" class="form-label fw-semibold">Contact Person</label>
            <input asp-for="ContactPerson" class="form-control" />
            <span asp-validation-for="ContactPerson" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ContactNumber" class="form-label fw-semibold">Contact Number</label>
            <input asp-for="ContactNumber" type="tel" class="form-control" />
            <span asp-validation-for="ContactNumber" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Notes" class="form-label fw-semibold">Notes</label>
            <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Notes" class="text-danger small"></span>
        </div>

        <div class="d-flex justify-content-between align-items-center">
            <a asp-action="Index" asp-route-familyId="@Model.FamilyId"
               class="btn btn-outline-secondary rounded-pill px-4">
                <i class="fa-light fa-arrow-left me-1"></i> Cancel
            </a>
            <button type="submit" class="btn btn-primary rounded-pill px-4">
                <i class="fa-light fa-floppy-disk me-1"></i> Save Changes
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
