@model IEnumerable<Hearthly.Data.ServiceContact>
@using System.ComponentModel.DataAnnotations
@using System.Reflection

@{
    ViewData["Title"] = "Service Contacts";

    // safely grab familyId
    Guid familyId = Guid.Empty;
    var fid = ViewContext.HttpContext.Request.Query["familyId"].ToString();
    if (!string.IsNullOrWhiteSpace(fid))
    {
        Guid.TryParse(fid, out familyId);
    }

    // helper to get Display Name of enum
    string GetDisplayName(Enum value)
    {
        return value.GetType()
                    .GetMember(value.ToString())
                    .First()
                    .GetCustomAttribute<DisplayAttribute>()?.Name ?? value.ToString();
    }

    // helper lambdas for icon name & color
    Func<Hearthly.Data.ServiceType, string> GetIcon = st => st switch
    {
        Hearthly.Data.ServiceType.Electrician => "bolt",
        Hearthly.Data.ServiceType.Plumber => "droplet",
        Hearthly.Data.ServiceType.Lawyer => "briefcase",
        Hearthly.Data.ServiceType.Doctor => "stethoscope",
        Hearthly.Data.ServiceType.Handyman => "wrench",
        Hearthly.Data.ServiceType.MedicalAid => "hospital",
        Hearthly.Data.ServiceType.Cellphone => "mobile",
        Hearthly.Data.ServiceType.Insurance => "shield",
        Hearthly.Data.ServiceType.Cleaner => "broom",
        Hearthly.Data.ServiceType.Dentist => "tooth",
        Hearthly.Data.ServiceType.Therapist => "brain",
        Hearthly.Data.ServiceType.Builder => "helmet-safety",
        Hearthly.Data.ServiceType.ISP => "wifi",
        Hearthly.Data.ServiceType.Towing => "truck",
        Hearthly.Data.ServiceType.Mechanic => "gear",
        Hearthly.Data.ServiceType.Painter => "paint-roller",
        Hearthly.Data.ServiceType.Solar => "sun",
        _ => "screwdriver-wrench"
    };

    Func<Hearthly.Data.ServiceType, string> GetColor = st => st switch
    {
        Hearthly.Data.ServiceType.Electrician => "text-primary",
        Hearthly.Data.ServiceType.Plumber => "text-info",
        Hearthly.Data.ServiceType.Lawyer => "text-danger",
        Hearthly.Data.ServiceType.Doctor => "text-success",
        Hearthly.Data.ServiceType.Handyman => "text-warning",
        Hearthly.Data.ServiceType.MedicalAid => "text-secondary",
        Hearthly.Data.ServiceType.Cellphone => "text-muted",
        Hearthly.Data.ServiceType.Insurance => "text-dark",
        Hearthly.Data.ServiceType.Cleaner => "text-primary",
        Hearthly.Data.ServiceType.Dentist => "text-info",
        Hearthly.Data.ServiceType.Therapist => "text-danger",
        Hearthly.Data.ServiceType.Builder => "text-warning",
        Hearthly.Data.ServiceType.ISP => "text-secondary",
        Hearthly.Data.ServiceType.Towing => "text-success",
        Hearthly.Data.ServiceType.Mechanic => "text-primary",
        Hearthly.Data.ServiceType.Painter => "text-info",
        _ => "text-secondary"
    };
}

<div class="mb-4 d-flex justify-content-between align-items-center">
    <h2 class="mb-0"><i class="fa-light fa-address-book me-2"></i>Service Contacts</h2>
    <a asp-action="Create" asp-route-familyId="@familyId" class="btn btn-primary btn-sm rounded-pill px-3">
        <i class="fa-light fa-circle-plus me-1"></i> Add Contact
    </a>
</div>

@if (!Model.Any())
{
    <div class="glass-card text-center py-5">
        <i class="fa-light fa-phone-slash fa-3x text-muted mb-3 d-block"></i>
        <p class="text-muted mb-2">No service contacts added yet.</p>
        <a asp-action="Create" asp-route-familyId="@familyId" class="btn btn-primary btn-sm rounded-pill px-3">
            <i class="fa-light fa-circle-plus me-1"></i> Add First Contact
        </a>
    </div>
}

<div class="row g-3">
    @foreach (var contact in Model)
    {
        <div class="col-md-6">
            <div class="glass-card p-3 h-100 d-flex gap-3 align-items-start">
                <div class="flex-shrink-0 d-flex align-items-center justify-content-center rounded"
                     style="width:48px;height:48px;background:rgba(255,255,255,.06);">
                    <i class="fa-light fa-@GetIcon(contact.ServiceType) @GetColor(contact.ServiceType) fs-4"></i>
                </div>
                <div class="flex-grow-1 min-width-0">
                    <div class="fw-semibold">@contact.Company</div>
                    <div class="text-muted small mb-1">@GetDisplayName(contact.ServiceType)</div>
                    @if (!string.IsNullOrWhiteSpace(contact.ContactPerson))
                    {
                        <div class="small"><i class="fa-light fa-user me-1 text-muted"></i>@contact.ContactPerson</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(contact.Notes))
                    {
                        <div class="text-muted small mt-1">@contact.Notes</div>
                    }
                    <div class="d-flex gap-2 mt-2">
                        <a href="tel:@contact.ContactNumber"
                           class="btn btn-outline-primary btn-sm rounded-pill px-3">
                            <i class="fa-light fa-phone-arrow-up-right me-1"></i>@contact.ContactNumber
                        </a>
                        <a asp-action="Details"
                           asp-route-id="@contact.Id"
                           asp-route-familyId="@familyId"
                           class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                            <i class="fa-light fa-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
