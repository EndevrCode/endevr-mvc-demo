@{
    ViewData["Title"] = "Welcome to Hearthly";
}

<div class="container text-center mt-5">
    <h1 class="display-4 fade-in">Welcome to <strong>Hearthly</strong></h1>
    <p class="lead fade-in delay-1">
        Your all-in-one solution to manage your home, family, pets, staff, and more.
    </p>
    <p class="fade-in delay-2">
        We'll help you get set up in just a few steps. It's quick and painless!
    </p>

    <form asp-action="Complete" method="post" class="mt-4 fade-in delay-3">
        <button type="submit" class="btn btn-primary btn-lg">
            Let's Get Started 🚀
        </button>
    </form>
</div>
