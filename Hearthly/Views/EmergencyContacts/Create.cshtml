@model EmergencyContact

@{
    ViewData["Title"] = "Add Emergency Contact";
}

<div class="mb-4 d-flex justify-content-between align-items-center">
    <h2 class="mb-0"><i class="fa-light fa-phone-plus me-2"></i>Add Emergency Contact</h2>
</div>

<div class="glass-card p-4" style="max-width:560px;">
    <form id="emergencyForm" asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="alert alert-danger"></div>

        <input asp-for="FamilyId" type="hidden" />

        <div class="mb-3">
            <label asp-for="ContactType" class="form-label fw-semibold"></label>
            <select asp-for="ContactType" class="form-select">
                <option value="">-- Select Type --</option>
                @foreach (var t in Enum.GetValues<EmergencyContactType>())
                {
                    <option value="@t">@t</option>
                }
            </select>
            <span asp-validation-for="ContactType" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label fw-semibold"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="PhoneNumber" class="form-label fw-semibold"></label>
            <input asp-for="PhoneNumber" type="tel" class="form-control" />
            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Notes" class="form-label fw-semibold"></label>
            <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Notes" class="text-danger small"></span>
        </div>

        <div class="d-flex justify-content-between mt-4">
            <a asp-action="Index" asp-route-familyId="@(Model.FamilyId)" class="btn btn-outline-secondary rounded-pill px-4">
                <i class="fa-light fa-arrow-left me-1"></i> Cancel
            </a>
            <button type="submit" class="btn btn-primary rounded-pill px-4">
                <i class="fa-light fa-floppy-disk me-1"></i> Save
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
