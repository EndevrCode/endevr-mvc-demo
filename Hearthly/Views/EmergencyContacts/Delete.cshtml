@using Hearthly.Data
@model EmergencyContact

@{
    ViewData["Title"] = "Delete Emergency Contact";
}

<div class="mb-4">
    <h2 class="mb-0"><i class="fa-light fa-trash me-2"></i>@ViewData["Title"]</h2>
</div>

<div class="glass-card p-4 mb-4">
    <p>Are you sure you want to delete this contact?</p>

    <dl class="row">
        <dt class="col-sm-3">Type</dt>
        <dd class="col-sm-9">@Model.ContactType</dd>

        <dt class="col-sm-3">Name</dt>
        <dd class="col-sm-9">@Model.Name</dd>

        <dt class="col-sm-3">Phone</dt>
        <dd class="col-sm-9">@Model.PhoneNumber</dd>
    </dl>

    <form asp-action="Delete" method="post">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />
        <input asp-for="FamilyId" type="hidden" />

        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index"
           asp-route-familyId="@(Model.FamilyId)"
           class="btn btn-secondary ms-2">
            Cancel
        </a>
    </form>
</div>
