@using Hearthly.Data
@model IEnumerable<EmergencyContact>
@{
    ViewData["Title"] = "Emergency Contacts";
    var familyId = (Guid)ViewData["FamilyId"]!;
}

<div class="mb-4 d-flex justify-content-between align-items-center">
    <h2 class="mb-0"><i class="fa-light fa-phone-emergency me-2"></i>Emergency Contacts</h2>
    <a asp-action="Create" asp-route-familyId="@familyId" class="btn btn-danger btn-sm rounded-pill px-3">
        <i class="fa-light fa-phone-plus me-1"></i> Add Contact
    </a>
</div>

@if (!Model.Any())
{
    <div class="glass-card text-center py-5">
        <i class="fa-light fa-phone-slash fa-3x text-muted mb-3 d-block"></i>
        <p class="text-muted mb-2">No emergency contacts added yet.</p>
        <a asp-action="Create" asp-route-familyId="@familyId" class="btn btn-danger btn-sm rounded-pill px-3">
            <i class="fa-light fa-phone-plus me-1"></i> Add First Contact
        </a>
    </div>
}

<div class="row">
    @foreach (var ec in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="glass-card h-100 p-3 text-center d-flex flex-column">
                <div class="d-flex justify-content-center mb-3">
                    <i class="fa-light fa-@(
                        ec.ContactType switch {
                            EmergencyContactType.Police        => "badge-sheriff",
                            EmergencyContactType.Fire          => "fire-flame-curved",
                            EmergencyContactType.Ambulance     => "light-emergency-on",
                            EmergencyContactType.NSRI          => "person-water-arms-raised",
                            EmergencyContactType.TowingService => "truck-tow",
                            EmergencyContactType.Dad           => "person-golfing",
                            EmergencyContactType.Mom           => "person-dress",
                            EmergencyContactType.Sister        => "person-dress-fairy",
                            EmergencyContactType.Brother       => "person-burst",
                            EmergencyContactType.PoisonControl => "biohazard",
                            EmergencyContactType.NextOfKin     => "nesting-dolls",
                            EmergencyContactType.Doctor        => "stethoscope",
                            _                                  => "cloud-question"
                        }
                    ) service-icon text-danger"></i>
                </div>

                <div class="fw-semibold">@ec.Name</div>
                <div class="text-muted small mb-1">@ec.ContactType</div>

                @if (!string.IsNullOrWhiteSpace(ec.Notes))
                {
                    <div class="text-muted small mb-2">@ec.Notes</div>
                }

                <div class="mt-auto d-flex gap-2 justify-content-center pt-2">
                    <a href="tel:@ec.PhoneNumber" class="btn btn-outline-danger btn-sm rounded-pill px-3">
                        <i class="fa-light fa-phone-arrow-up-right me-1"></i>@ec.PhoneNumber
                    </a>
                    <a asp-action="Edit" asp-route-id="@ec.Id" asp-route-familyId="@ec.FamilyId"
                       class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                        <i class="fa-light fa-pen me-1"></i> Edit
                    </a>
                </div>
            </div>
        </div>
    }
</div>
