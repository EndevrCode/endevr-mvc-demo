@using Hearthly.Data
@model EmergencyContact

@{
    ViewData["Title"] = "Contact Details";
}

<div class="mb-4">
    <h2 class="mb-0"><i class="fa-light fa-address-card me-2"></i>@ViewData["Title"]</h2>
</div>

<div class="glass-card p-4 mb-4">
    <dl class="row">
        <dt class="col-sm-3">Type</dt>
        <dd class="col-sm-9">@Model.ContactType</dd>

        <dt class="col-sm-3">Name</dt>
        <dd class="col-sm-9">@Model.Name</dd>

        <dt class="col-sm-3">Phone</dt>
        <dd class="col-sm-9">
            <a href="tel:@Model.PhoneNumber" class="text-decoration-none">
                <i class="fa-light fa-phone me-1 text-muted"></i>@Model.PhoneNumber
            </a>
        </dd>

        @if (!string.IsNullOrWhiteSpace(Model.Notes))
        {
            <dt class="col-sm-3">Notes</dt>
            <dd class="col-sm-9">@Model.Notes</dd>
        }
    </dl>

    <div class="d-flex justify-content-center flex-wrap gap-2 mt-3">
        <a href="tel:@Model.PhoneNumber" class="btn btn-danger rounded-pill px-4">
            <i class="fa-light fa-phone-arrow-up-right me-1"></i> Call Now
        </a>
        <a asp-action="Edit" asp-route-id="@Model.Id" asp-route-familyId="@Model.FamilyId"
           class="btn btn-outline-primary rounded-pill px-4">
            <i class="fa-light fa-pen-to-square me-1"></i> Edit
        </a>
        <a asp-action="Index" asp-route-familyId="@Model.FamilyId"
           class="btn btn-outline-secondary rounded-pill px-4">
            <i class="fa-light fa-arrow-left me-1"></i> Back
        </a>
    </div>
</div>
