@{
    ViewData["Title"] = "Help";
}

<div class="mb-4">
    <h2 class="mb-0"><i class="fa-light fa-circle-question me-2"></i>Help &amp; FAQ</h2>
</div>

@{
    var sections = new[]
    {
        new {
            Icon = "fa-people-roof",
            Title = "Families",
            Items = new[] {
                new { Q = "How do I create a family?", A = "Go to Families and tap Create a Family. Give it a name and you're set." },
                new { Q = "How do I invite someone?", A = "Open the family details page and choose Actions → Add to Family. Enter their email address — they'll receive an invite on their Dashboard." },
                new { Q = "Can I be in more than one family?", A = "Yes. You can join or create multiple families, and each feature (Bills, Shopping, etc.) lets you switch between them." }
            }
        },
        new {
            Icon = "fa-vault",
            Title = "Vault",
            Items = new[] {
                new { Q = "What is the Vault PIN?", A = "A 4–6 digit numeric code that locks and unlocks your Vault. It's separate from your login password and encrypts your sensitive data." },
                new { Q = "What happens if I forget my PIN?", A = "Your PIN cannot be recovered automatically. Contact support and provide identifying documentation to reset it." },
                new { Q = "Is my data actually encrypted?", A = "Yes. Files are encrypted with AES-256 using a key derived from your PIN via PBKDF2 (100,000 iterations, SHA-256). Passwords and account numbers use ASP.NET Data Protection." }
            }
        },
        new {
            Icon = "fa-file-invoice-dollar",
            Title = "Bills",
            Items = new[] {
                new { Q = "How do I track a bill?", A = "Go to Bills, select your family, and tap Add Bill. Set the name, amount, and due date. Overdue bills appear on your Dashboard." },
                new { Q = "What does 'recurring' mean?", A = "Recurring bills are flagged with a Monthly badge as a reminder. You still need to mark each month's payment manually." },
                new { Q = "Can I see paid bills?", A = "Yes — the Bills page shows a Paid section below the Outstanding list." }
            }
        },
        new {
            Icon = "fa-cart-shopping",
            Title = "Shopping",
            Items = new[] {
                new { Q = "Can multiple family members use the same shopping list?", A = "Yes. Shopping lists are family-scoped, so any accepted family member can add or check items." },
                new { Q = "How do I remove completed items?", A = "Tap the green checkmark button (Clear Checked) on the list header to remove all checked items at once." }
            }
        },
        new {
            Icon = "fa-paw",
            Title = "Pets",
            Items = new[] {
                new { Q = "What is the Wall of Remembrance?", A = "A dedicated page for pets that have passed. When you mark a pet as deceased, they automatically appear there." },
                new { Q = "What pet health records does Hearthly track?", A = "Deworming, tick & flea treatments, grooming, weight, vet checkups, microchip number, and insurance details." }
            }
        },
        new {
            Icon = "fa-list-check",
            Title = "Chores",
            Items = new[] {
                new { Q = "How do I add a chore?", A = "Open Chores for your family, type the chore name, optionally set a due date and assign it to a member, then tap Add." },
                new { Q = "How do I mark a chore done?", A = "Tap the circle button on the left of any chore card. Done chores move to the Completed section." },
                new { Q = "Can I assign a chore to someone?", A = "Yes — use the Assign button (person+ icon) on any chore card to assign it to a specific family member." }
            }
        },
        new {
            Icon = "fa-people-roof",
            Title = "Staff Members",
            Items = new[] {
                new { Q = "How is the monthly salary calculated?", A = "Hearthly counts the staff member's scheduled work days in the current calendar month and multiplies by their daily wage. The result is shown on their profile page." },
                new { Q = "Which document is shown — ID or passport?", A = "When creating a staff member, select their nationality. South Africans show an ID Number field; other nationalities show a Passport Number field instead." },
                new { Q = "Can I generate a payslip?", A = "Yes. Open a staff member's Payment History and tap the Payslip button next to any payment record. The payslip shows the employee's details, pay period, earnings breakdown, banking details, and a signature block. Use the Print button to print or save it as a PDF." }
            }
        },
        new {
            Icon = "fa-location-dot",
            Title = "Family Tracker",
            Items = new[] {
                new { Q = "How does location sharing work?", A = "Tap the Tracking badge at the top of the map to start sharing your location. Your family members will see your position update in real time (every 30 seconds or when you move more than 20 m)." },
                new { Q = "Can I hide my location?", A = "Yes. Tap the eye icon in the bottom panel to hide yourself from other family members. You can turn visibility back on at any time." },
                new { Q = "What are Family Places?", A = "Saved locations like Home, Work, or School. When a family member is within the place radius, their status shows the place name automatically." }
            }
        },
        new {
            Icon = "fa-calendar-check",
            Title = "Rule of Three",
            Items = new[] {
                new { Q = "What is Rule of Three?", A = "A daily planning method: one main 3-hour project, three short tasks, and three maintenance tasks. Complete all six to unlock the Mark Today as Done button and earn a streak." },
                new { Q = "Does it work on weekends?", A = "Rule of Three only runs Monday to Friday. On weekends you'll see a rest screen instead." }
            }
        },
        new {
            Icon = "fa-screwdriver-wrench",
            Title = "Utilities",
            Items = new[] {
                new { Q = "How do I track electricity or gas?", A = "Go to Utilities, select your family, and tap Add Utility. Choose the type (Electricity or Gas), fill in the amount paid, purchase date, and units (kWh) or litres received." },
                new { Q = "Why do I see utility reminders on the Dashboard?", A = "Hearthly reminds you when it's been a while since your last purchase — 30 days for electricity, 60 days for gas. Tap Buy Now on the reminder to log a new record." },
                new { Q = "What is the Electricity / Gas Summary?", A = "A chart and table showing all purchases over time, including units received, days between purchases, and average daily usage. Access it from the Utilities page via the Summary buttons." }
            }
        },
        new {
            Icon = "fa-gear",
            Title = "App Settings",
            Items = new[] {
                new { Q = "How do I change the theme?", A = "Go to Settings (gear icon) → App Settings. Choose Light, Dark, or System Default." },
                new { Q = "How do I install Hearthly on my phone?", A = "In your mobile browser, tap Share → Add to Home Screen (iOS) or the install prompt (Android). Hearthly is a Progressive Web App and works offline." }
            }
        }
    };
}

<div class="d-flex flex-column gap-4">
    @foreach (var section in sections)
    {
        <div class="glass-card p-4">
            <h5 class="mb-3 fw-semibold">
                <i class="fa-light @section.Icon me-2 text-primary"></i>@section.Title
            </h5>
            <div class="accordion accordion-flush" id="acc-@section.Title.Replace(" ", "")">
                @foreach (var (item, idx) in section.Items.Select((x, i) => (x, i)))
                {
                    var id = $"q-{section.Title.Replace(" ", "")}-{idx}";
                    <div class="accordion-item bg-transparent border-0 border-bottom">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed bg-transparent px-0 fw-semibold"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#@id"
                                    aria-expanded="false"
                                    aria-controls="@id">
                                @item.Q
                            </button>
                        </h2>
                        <div id="@id" class="accordion-collapse collapse">
                            <div class="accordion-body px-0 text-muted">@item.A</div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

<div class="glass-card p-4 mt-4 text-center">
    <i class="fa-light fa-envelope fa-2x mb-3 d-block text-muted"></i>
    <p class="mb-1 fw-semibold">Still need help?</p>
    <p class="text-muted small mb-0">Contact us at <a href="mailto:support@hearthly.app">support@hearthly.app</a></p>
</div>
